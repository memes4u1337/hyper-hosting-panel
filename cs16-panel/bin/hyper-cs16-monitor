#!/usr/bin/env python3
from __future__ import annotations
import json, subprocess, sys, time, re, socket, urllib.request, urllib.parse, shutil, hashlib
from pathlib import Path

APP=Path('/opt/hyper-cs16'); ETC=Path('/etc/hyper-cs16'); STATE=Path('/var/lib/hyper-cs16')
sys.path.insert(0,str(APP/'lib'))
from csquery import info as query_info, players as query_players, rcon as query_rcon
try:
    import pymysql
except Exception as exc:
    print(f'PyMySQL unavailable: {exc}',file=sys.stderr); raise SystemExit(2)

FAIL_COUNTS={}
LAST_RECOVER={}
RECOVER_COOLDOWN=300


def get_settings(db):
    try:
        with db.cursor() as cur:
            cur.execute('SELECT setting_key,setting_value FROM settings')
            return {str(r['setting_key']):str(r['setting_value']) for r in cur.fetchall()}
    except Exception:
        return {}

def event_enabled(settings,event_type):
    m={
      'server_down':'notify_server_down','server_recovered':'notify_recovered','plugin_disabled':'notify_plugin_disabled',
      'map_failed':'notify_map_failed','resource_high':'notify_resource_high','player_report':'notify_report',
      'billing_expired':'notify_billing','billing_renewed':'notify_billing','billing_soon':'notify_billing'
    }
    k=m.get(event_type)
    return settings.get(k,'1')=='1' if k else True

def queue_event(db,settings,event_type,message,server_id=None,severity='info',meta=None,dedupe_minutes=0):
    try:
        with db.cursor() as cur:
            if dedupe_minutes>0:
                cur.execute('SELECT 1 FROM panel_events WHERE event_type=%s AND server_id <=> %s AND created_at>=NOW()-INTERVAL %s MINUTE LIMIT 1',(event_type,server_id,int(dedupe_minutes)))
                if cur.fetchone(): return
            tg='pending' if settings.get('telegram_enabled','0')=='1' and event_enabled(settings,event_type) else 'disabled'
            cur.execute('INSERT INTO panel_events(server_id,user_id,event_type,severity,message,meta_json,telegram_status) VALUES(%s,NULL,%s,%s,%s,%s,%s)',
                        (server_id,event_type,severity,str(message)[:500],json.dumps(meta or {},ensure_ascii=False,separators=(',',':')),tg))
    except Exception as exc:
        print(f'event queue failed: {exc}',file=sys.stderr)

def flush_telegram(db,settings):
    if settings.get('telegram_enabled','0')!='1':
        try:
            with db.cursor() as cur: cur.execute("UPDATE panel_events SET telegram_status='disabled' WHERE telegram_status='pending'")
        except Exception: pass
        return
    token=settings.get('telegram_bot_token','').strip(); chat=settings.get('telegram_chat_id','').strip()
    if not token or not chat: return
    try:
        with db.cursor() as cur:
            cur.execute("SELECT e.id,e.event_type,e.severity,e.message,e.server_id,s.name server_name FROM panel_events e LEFT JOIN servers s ON s.id=e.server_id WHERE e.telegram_status='pending' ORDER BY e.id ASC LIMIT 20")
            rows=cur.fetchall()
    except Exception: return
    icons={'danger':'🔴','warning':'🟠','success':'🟢','info':'🔵'}
    for row in rows:
        text=f"{icons.get(row.get('severity'),'🔵')} HYPER-HOST CS 1.6\n{row.get('message','')}"
        if row.get('server_name'): text+=f"\nСервер: {row['server_name']} (#{row['server_id']})"
        data=urllib.parse.urlencode({'chat_id':chat,'text':text,'disable_web_page_preview':'true'}).encode()
        try:
            req=urllib.request.Request(f'https://api.telegram.org/bot{token}/sendMessage',data=data,method='POST')
            with urllib.request.urlopen(req,timeout=8) as resp: ok=200<=getattr(resp,'status',200)<300
            with db.cursor() as cur:
                cur.execute("UPDATE panel_events SET telegram_status=%s,telegram_error='',sent_at=IF(%s='sent',NOW(),sent_at) WHERE id=%s",('sent' if ok else 'error','sent' if ok else 'error',row['id']))
        except Exception as exc:
            with db.cursor() as cur: cur.execute("UPDATE panel_events SET telegram_status='error',telegram_error=%s WHERE id=%s",(str(exc)[:500],row['id']))

def billing_tick(db,settings):
    try:
        with db.cursor() as cur:
            cur.execute("SELECT sub.*,p.price_monthly,p.name plan_name,u.balance,s.name server_name FROM subscriptions sub JOIN plans p ON p.id=sub.plan_id JOIN users u ON u.id=sub.user_id JOIN servers s ON s.id=sub.server_id WHERE sub.status='active' ORDER BY sub.expires_at")
            rows=cur.fetchall()
        now=time.time()
        for sub in rows:
            # MySQL gives datetime objects; compare using timestamp.
            exp=sub['expires_at'].timestamp() if hasattr(sub['expires_at'],'timestamp') else now+99999
            sid=int(sub['server_id']); uid=int(sub['user_id']); price=float(sub.get('price_monthly') or 0); bal=float(sub.get('balance') or 0)
            if exp<=now:
                if int(sub.get('auto_renew') or 0) and bal>=price:
                    with db.cursor() as cur:
                        cur.execute('UPDATE users SET balance=balance-%s WHERE id=%s AND balance>=%s',(price,uid,price))
                        if cur.rowcount:
                            cur.execute("UPDATE subscriptions SET expires_at=DATE_ADD(GREATEST(expires_at,NOW()),INTERVAL 30 DAY),last_renewed_at=NOW(),status='active' WHERE id=%s",(sub['id'],))
                            cur.execute("INSERT INTO billing_transactions(user_id,amount,type,description) VALUES(%s,%s,'charge',%s)",(uid,-price,f"Автопродление {sub['plan_name']} / сервер #{sid}"))
                            queue_event(db,settings,'billing_renewed',f"Тариф {sub['plan_name']} автоматически продлён на 30 дней",sid,'success',dedupe_minutes=5)
                            continue
                with db.cursor() as cur: cur.execute("UPDATE subscriptions SET status='expired' WHERE id=%s",(sub['id'],))
                subprocess.run(['systemctl','stop',f'hyper-cs16@{sid}.service'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
                queue_event(db,settings,'billing_expired',f"Срок аренды сервера #{sid} закончился. Сервер остановлен.",sid,'danger',dedupe_minutes=60)
            elif exp-now<=3*86400:
                queue_event(db,settings,'billing_soon',f"До окончания аренды сервера #{sid} осталось меньше 3 дней",sid,'warning',dedupe_minutes=720)
    except Exception as exc:
        print(f'billing tick: {exc}',file=sys.stderr)


def runtime(): return json.loads((ETC/'runtime.json').read_text(encoding='utf-8'))
def conn():
    r=runtime()
    return pymysql.connect(host=r.get('db_host','127.0.0.1'),port=int(r.get('db_port',3306)),user=r['db_user'],password=r['db_password'],database=r['db_name'],charset='utf8mb4',autocommit=True,cursorclass=pymysql.cursors.DictCursor,connect_timeout=5)

def scfg(sid):
    p=STATE/'servers'/f'{sid}.json'
    if not p.exists(): p=ETC/'servers'/f'{sid}.json'
    try: return json.loads(p.read_text(encoding='utf-8'))
    except Exception: return None

def service(sid):
    cp=subprocess.run(['systemctl','is-active',f'hyper-cs16@{sid}.service'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    return cp.stdout.strip() or 'unknown'

def pid(sid):
    cp=subprocess.run(['systemctl','show',f'hyper-cs16@{sid}.service','-p','MainPID','--value'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    try:return int(cp.stdout.strip())
    except:return 0

def actual_hlds_pid(sid):
    p=pid(sid)
    if p<=0:return 0
    try:
        raw=Path(f'/proc/{p}/cmdline').read_bytes().replace(b'\0',b' ').decode('utf-8','replace')
        if f'/srv/hyper-cs16/servers/{sid}/hlds_linux' in raw:return p
    except Exception: pass
    cp=subprocess.run(['pgrep','-u','cs16','-f',f'/srv/hyper-cs16/servers/{sid}/hlds_linux'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    for tok in (cp.stdout or '').split():
        try:return int(tok)
        except:pass
    return 0

def proc_metrics(p):
    if p<=0:return 0.0,0.0,0
    cp=subprocess.run(['ps','-p',str(p),'-o','%cpu=,rss=,etimes='],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    x=cp.stdout.split()
    try:return float(x[0]),round(float(x[1])/1024,2),int(float(x[2]))
    except:return 0.0,0.0,0

def disk(path):
    cp=subprocess.run(['du','-sm',path],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    try:return float(cp.stdout.split()[0])
    except:return 0.0

def host_ram_total_mb():
    try:
        for line in Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'): return float(line.split()[1])/1024.0
    except Exception: pass
    return 0.0

def filesystem_used_percent(path):
    try:
        u=shutil.disk_usage(path)
        return (float(u.used)/float(u.total)*100.0) if u.total else 0.0
    except Exception:return 0.0

def udp_listening(port):
    cp=subprocess.run(['ss','-lunH'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
    needle=f':{int(port)}'
    for line in (cp.stdout or '').splitlines():
        if any(tok.endswith(needle) for tok in line.split()): return True
    return False

def query_info_retry(port, attempts=2):
    last=None
    timeouts=(0.9,1.5,2.0)
    for i in range(max(1,attempts)):
        try: return query_info('127.0.0.1',int(port),timeouts[min(i,len(timeouts)-1)]), ''
        except Exception as exc:
            last=exc
            if i+1<attempts: time.sleep(.15)
    return None, str(last or 'A2S_INFO timeout')

def rcon_player_rows(c):
    try: raw=query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),'status',1.8)
    except Exception: return []
    rx=re.compile(r'^\s*#\s*(\d+)\s+\"(.*?)\"\s+(\d+)\s+(\S+)\s+(-?\d+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(.*)$')
    rows=[]
    for line in raw.splitlines():
        m=rx.match(line)
        if m: rows.append({'name':m.group(2),'steam_id':m.group(4),'score':int(m.group(5)),'time':m.group(6),'address':m.group(9).strip()})
    return rows


CURSOR_DIR=STATE/'stats-cursors'
KILL_RE=re.compile(r'"(?P<killer>.*?)<\d+><(?P<ksteam>[^>]*)><[^>]*>" killed "(?P<victim>.*?)<\d+><(?P<vsteam>[^>]*)><[^>]*>" with "(?P<weapon>[^"]+)"(?P<tail>.*)$')
CONNECT_RE=re.compile(r'"(?P<name>.*?)<\d+><(?P<steam>[^>]*)><[^>]*>" connected, address "(?P<address>[^"]+)"')
DISCONNECT_RE=re.compile(r'"(?P<name>.*?)<\d+><(?P<steam>[^>]*)><[^>]*>" disconnected')
MAP_RE=re.compile(r'Mapchange to\s+([A-Za-z0-9_-]{1,64})',re.I)


def player_key(name,steam,address=''):
    steam=str(steam or '').strip().upper()
    if steam=='BOT': return ''
    if re.fullmatch(r'STEAM_[0-5]:[01]:\d+',steam,re.I): return 'steam:'+steam
    addr=str(address or '').strip()
    ip=addr.rsplit(':',1)[0] if ':' in addr else addr
    if ip and ip not in {'127.0.0.1','0.0.0.0'}:
        return 'ip:'+ip
    n=' '.join(str(name or '').strip().casefold().split())
    return 'name:'+hashlib.sha1(n.encode('utf-8','ignore')).hexdigest()[:24] if n else ''


def ensure_player_stat(db,sid,name,steam,address=''):
    key=player_key(name,steam,address)
    if not key: return ''
    ip=(str(address or '').rsplit(':',1)[0] if ':' in str(address or '') else str(address or ''))[:64]
    with db.cursor() as cur:
        cur.execute("""INSERT INTO player_stats(server_id,player_key,name,steam_id,last_ip,first_seen,last_seen,sessions)
            VALUES(%s,%s,%s,%s,%s,NOW(),NOW(),1)
            ON DUPLICATE KEY UPDATE name=VALUES(name),steam_id=IF(VALUES(steam_id)<>'',VALUES(steam_id),steam_id),last_ip=IF(VALUES(last_ip)<>'',VALUES(last_ip),last_ip),last_seen=NOW()""",
            (sid,key,str(name)[:128],str(steam)[:64],ip))
    return key


def snapshot_player_stat(db,sid,pl):
    name=str(pl.get('name',''))[:128]; steam=str(pl.get('steam_id',''))[:64]; address=str(pl.get('address',''))[:64]
    key=player_key(name,steam,address)
    if not key: return
    try: duration=max(0,int(float(pl.get('duration',0) or 0)))
    except Exception: duration=0
    score=int(pl.get('score',0) or 0); ip=(address.rsplit(':',1)[0] if ':' in address else address)[:64]
    with db.cursor() as cur:
        cur.execute('SELECT last_session_seconds,last_seen,sessions FROM player_stats WHERE server_id=%s AND player_key=%s LIMIT 1',(sid,key))
        old=cur.fetchone()
        if old:
            lastdur=int(old.get('last_session_seconds') or 0)
            lastseen=old.get('last_seen')
            gap=9999
            try: gap=max(0,time.time()-lastseen.timestamp())
            except Exception: pass
            new_session=(gap>150 or duration+15<lastdur)
            delta=min(duration,86400) if new_session else max(0,min(600,duration-lastdur))
            cur.execute("""UPDATE player_stats SET name=%s,steam_id=IF(%s<>'',%s,steam_id),last_ip=IF(%s<>'',%s,last_ip),
                current_score=%s,play_seconds=play_seconds+%s,sessions=sessions+%s,last_session_seconds=%s,last_seen=NOW(),last_snapshot_at=NOW()
                WHERE server_id=%s AND player_key=%s""",
                (name,steam,steam,ip,ip,score,delta,1 if new_session else 0,duration,sid,key))
        else:
            cur.execute("""INSERT INTO player_stats(server_id,player_key,name,steam_id,last_ip,current_score,play_seconds,sessions,last_session_seconds,first_seen,last_seen,last_snapshot_at)
                VALUES(%s,%s,%s,%s,%s,%s,%s,1,%s,NOW(),NOW(),NOW())""",
                (sid,key,name,steam,ip,score,min(duration,86400),duration))


def add_game_event(db,sid,event_type,actor=('', ''),target=('', ''),weapon='',headshot=False,map_name='',meta=None):
    an,as_=actor; tn,ts=target; ak=player_key(an,as_); tk=player_key(tn,ts)
    with db.cursor() as cur:
        cur.execute("""INSERT INTO game_events(server_id,event_type,actor_key,actor_name,actor_steam_id,target_key,target_name,target_steam_id,weapon,headshot,map_name,meta_json)
            VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)""",
            (sid,event_type,ak,str(an)[:128],str(as_)[:64],tk,str(tn)[:128],str(ts)[:64],str(weapon)[:64],1 if headshot else 0,str(map_name)[:64],json.dumps(meta or {},ensure_ascii=False,separators=(',',':'))))


def journal_new_lines(sid):
    CURSOR_DIR.mkdir(parents=True,exist_ok=True)
    cpfile=CURSOR_DIR/f'{sid}.cursor'; cursor=''
    try: cursor=cpfile.read_text(encoding='utf-8').strip()
    except Exception: pass
    cmd=['journalctl','-u',f'hyper-cs16@{sid}.service','-o','cat','--no-pager','--show-cursor']
    if cursor: cmd += ['--after-cursor',cursor]
    else: cmd += ['--since','2 minutes ago']
    cp=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=10)
    text=cp.stdout or ''
    if cp.returncode!=0 and cursor:
        cp=subprocess.run(['journalctl','-u',f'hyper-cs16@{sid}.service','-o','cat','--no-pager','--show-cursor','--since','2 minutes ago'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=10)
        text=cp.stdout or ''
    lines=[]; new_cursor=''
    for line in text.splitlines():
        if line.startswith('-- cursor: '): new_cursor=line.split(': ',1)[1].strip()
        else: lines.append(line)
    if new_cursor:
        try: cpfile.write_text(new_cursor+'\n',encoding='utf-8')
        except Exception: pass
    return lines


def collect_game_logs(db,sid,current_map=''):
    try: lines=journal_new_lines(sid)
    except Exception as exc:
        print(f'journal stats server {sid}: {exc}',file=sys.stderr); return
    map_name=str(current_map or '')
    for line in lines:
        mm=MAP_RE.search(line)
        if mm:
            map_name=mm.group(1)
            try: add_game_event(db,sid,'map',weapon='',map_name=map_name,meta={'line':line[-500:]})
            except Exception: pass
            continue
        m=CONNECT_RE.search(line)
        if m:
            steam=m.group('steam'); key=player_key(m.group('name'),steam,m.group('address'))
            if key:
                try:
                    ensure_player_stat(db,sid,m.group('name'),steam,m.group('address'))
                    add_game_event(db,sid,'connect',(m.group('name'),steam),map_name=map_name,meta={'address':m.group('address')[:64]})
                except Exception as exc: print(f'connect stats {sid}: {exc}',file=sys.stderr)
            continue
        m=DISCONNECT_RE.search(line)
        if m:
            if player_key(m.group('name'),m.group('steam')):
                try: add_game_event(db,sid,'disconnect',(m.group('name'),m.group('steam')),map_name=map_name)
                except Exception: pass
            continue
        m=KILL_RE.search(line)
        if not m: continue
        killer=(m.group('killer'),m.group('ksteam')); victim=(m.group('victim'),m.group('vsteam')); weapon=m.group('weapon'); tail=m.group('tail') or ''
        kk=player_key(*killer); vk=player_key(*victim); headshot='headshot' in tail.lower()
        # Do not let training bots inflate human rankings. Human-vs-human kills are ranked.
        if kk and vk:
            try:
                ensure_player_stat(db,sid,*killer); ensure_player_stat(db,sid,*victim)
                suicide=(kk==vk)
                with db.cursor() as cur:
                    if suicide:
                        cur.execute('UPDATE player_stats SET deaths=deaths+1,suicides=suicides+1,last_seen=NOW() WHERE server_id=%s AND player_key=%s',(sid,kk))
                    else:
                        cur.execute('UPDATE player_stats SET kills=kills+1,headshots=headshots+%s,last_seen=NOW() WHERE server_id=%s AND player_key=%s',(1 if headshot else 0,sid,kk))
                        cur.execute('UPDATE player_stats SET deaths=deaths+1,last_seen=NOW() WHERE server_id=%s AND player_key=%s',(sid,vk))
                add_game_event(db,sid,'kill',killer,victim,weapon,headshot,map_name,{'suicide':suicide})
            except Exception as exc: print(f'kill stats {sid}: {exc}',file=sys.stderr)


def one(db,row,settings,store_stats=False,store_players=False):
    sid=int(row['id']); old_status=str(row.get('status_cache') or 'unknown'); recovered=False; c=scfg(sid); svc=service(sid); p=actual_hlds_pid(sid); cpu,mem,uptime=proc_metrics(p)
    # Keep the last good query values. A single dropped A2S packet must never turn a
    # healthy HLDS process into a scary "NO QUERY" state in the panel.
    map_name=str(row.get('current_map') or row.get('start_map') or '')
    online=int(row.get('players_online') or 0)
    maxp=int(row.get('max_players') or row.get('slots') or 0)
    ping=float(row.get('ping_ms') or 0.0)
    query_ok=False; query_error=''; plist=[]
    port=int((c or {}).get('port') or row.get('port') or 0)
    udp=bool(port and udp_listening(port))

    if not c:
        status='failed'
    elif svc!='active':
        status='offline' if svc in {'inactive','deactivating'} else ('failed' if svc=='failed' else 'starting')
    elif p<=0:
        status='failed'
    elif not udp:
        status='starting' if uptime < 30 else 'failed'
    else:
        # UDP socket is the authoritative liveness signal. A2S is statistics only.
        status='online'
        qi,query_error=query_info_retry(port,2)
        if qi:
            query_ok=True
            map_name=str(qi.get('map') or map_name)
            online=int(qi.get('players',online)); maxp=int(qi.get('max_players',maxp)); ping=float(qi.get('ping_ms',ping))
            if store_players:
                try: plist=query_players('127.0.0.1',port,1.5)
                except Exception: plist=[]
                status_rows=rcon_player_rows(c); by_name={}
                for rr in status_rows: by_name.setdefault(rr.get('name',''),[]).append(rr)
                if plist:
                    for pl in plist:
                        cand=by_name.get(pl.get('name',''),[])
                        if cand: pl.update(cand.pop(0))
                else:
                    plist=[dict(rr,duration=0) for rr in status_rows]

    # Self-heal only after three consecutive 10s checks without a real UDP socket.
    # Cooldown prevents loops. Recovery itself backs up configs and can disable a crashing
    # optional mod while keeping the CS server available.
    now=time.time()
    if c and status in {'failed','starting'} and not udp and svc not in {'inactive','deactivating'}:
        FAIL_COUNTS[sid]=FAIL_COUNTS.get(sid,0)+1
        if FAIL_COUNTS[sid]>=3 and now-LAST_RECOVER.get(sid,0)>=RECOVER_COOLDOWN:
            LAST_RECOVER[sid]=now; FAIL_COUNTS[sid]=0
            try:
                cp=subprocess.run(['/usr/local/sbin/hyper-cs16-ctl','recover',str(sid),'--auto'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=95)
                print(f'auto-recover server {sid}: {(cp.stdout or "").strip()[-2000:]}',file=sys.stderr)
                if cp.returncode==0:
                    recovered=True
                    try:
                        rr=json.loads((cp.stdout or '').strip().splitlines()[-1])
                        actions=rr.get('actions') or []
                        quarantined=rr.get('quarantined') or []
                        if quarantined or any('disabled' in str(a).lower() or 'quarantined' in str(a).lower() for a in actions):
                            msg='Автовосстановление отключило проблемный контент'
                            if quarantined: msg+=': '+', '.join(map(str,quarantined[:8]))
                            queue_event(db,settings,'plugin_disabled',msg,sid,'warning',{'actions':actions,'quarantined':quarantined},5)
                        for a in actions:
                            if 'map' in str(a).lower() and ('fallback' in str(a).lower() or 'bad startup map' in str(a).lower()):
                                queue_event(db,settings,'map_failed','Проблемная карта была автоматически заменена: '+str(a),sid,'warning',{'action':a},5); break
                    except Exception: pass
                    svc=service(sid); p=actual_hlds_pid(sid); cpu,mem,uptime=proc_metrics(p); udp=bool(port and udp_listening(port)); status='online' if udp else 'starting'
            except Exception as exc:
                print(f'auto-recover server {sid} failed: {exc}',file=sys.stderr)
    else:
        FAIL_COUNTS[sid]=0

    d=disk(c['path']) if c else 0.0
    # v2.7 has no per-server resource limits. These thresholds are notification
    # thresholds only and never throttle/stop HLDS.
    warnings=[]
    alert_cpu=float(settings.get('resource_alert_cpu','90') or 90); alert_ram=float(settings.get('resource_alert_ram','90') or 90); alert_disk=float(settings.get('resource_alert_disk','90') or 90)
    total_ram=host_ram_total_mb(); ram_pct=(mem/total_ram*100.0) if total_ram>0 else 0.0
    disk_pct=filesystem_used_percent(c['path']) if c else 0.0
    if cpu>=alert_cpu: warnings.append(f'CPU процесса {cpu:.1f}%')
    if total_ram>0 and ram_pct>=alert_ram: warnings.append(f'RAM процесса {ram_pct:.1f}% от RAM хоста')
    if disk_pct>=alert_disk: warnings.append(f'Диск хоста занят на {disk_pct:.1f}%')
    over=0; limit_message='; '.join(warnings)[:255]
    if warnings: queue_event(db,settings,'resource_high','Высокая нагрузка: '+limit_message,sid,'warning',{'cpu':cpu,'ram_mb':mem,'ram_host_percent':ram_pct,'server_disk_mb':d,'disk_host_percent':disk_pct},30)
    with db.cursor() as cur:
        if query_ok:
            cur.execute("UPDATE servers SET status_cache=%s,current_map=%s,players_online=%s,max_players=%s,cpu_percent=%s,memory_mb=%s,disk_mb=%s,uptime_seconds=%s,ping_ms=%s,over_limit=%s,limit_message=%s,last_query_at=NOW() WHERE id=%s",(status,map_name,online,maxp,cpu,mem,d,uptime,ping,over,limit_message,sid))
        else:
            # Preserve last_query_at and last known map/player values on transient A2S loss.
            cur.execute("UPDATE servers SET status_cache=%s,cpu_percent=%s,memory_mb=%s,disk_mb=%s,uptime_seconds=%s,over_limit=%s,limit_message=%s WHERE id=%s",(status,cpu,mem,d,uptime,over,limit_message,sid))
        if store_stats:
            cur.execute("INSERT INTO server_stats(server_id,players,max_players,cpu_percent,memory_mb,disk_mb,ping_ms,map_name) VALUES(%s,%s,%s,%s,%s,%s,%s,%s)",(sid,online,maxp,cpu,mem,d,ping,map_name))
        if store_players:
            for pl in plist:
                cur.execute("INSERT INTO player_history(server_id,name,steam_id,score,connected_seconds,address,first_seen,last_seen,visits) VALUES(%s,%s,%s,%s,%s,%s,NOW(),NOW(),1) ON DUPLICATE KEY UPDATE score=VALUES(score),connected_seconds=VALUES(connected_seconds),address=VALUES(address),visits=visits+IF(last_seen < NOW() - INTERVAL 2 MINUTE,1,0),last_seen=NOW()",(sid,str(pl.get('name',''))[:128],str(pl.get('steam_id',''))[:64],int(pl.get('score',0)),int(float(pl.get('duration',0))),str(pl.get('address',''))[:64]))
    if store_players:
        for pl in plist:
            try: snapshot_player_stat(db,sid,pl)
            except Exception as exc: print(f'player snapshot {sid}: {exc}',file=sys.stderr)
    collect_game_logs(db,sid,map_name)
    if old_status=='online' and status in {'failed','offline'}:
        queue_event(db,settings,'server_down',f'Сервер #{sid} перестал отвечать ({status})',sid,'danger',{'old':old_status,'new':status},5)
    elif status=='online' and old_status in {'failed','offline','starting','installing','unreachable'}:
        queue_event(db,settings,'server_recovered',f'Сервер #{sid} снова ONLINE'+(' после автовосстановления' if recovered else ''),sid,'success',{'old':old_status,'new':status},5)

def main():
    tick=0
    while True:
        try:
            db=conn()
            with db.cursor() as cur:
                cur.execute("SELECT id,port,slots,start_map,current_map,players_online,max_players,ping_ms,status_cache FROM servers WHERE enabled=1 ORDER BY id"); rows=cur.fetchall()
            settings=get_settings(db); store_stats=(tick%6==0); store_players=(tick%6==0)
            for row in rows:
                try:
                    one(db,row,settings,store_stats,store_players)
                    # Keep FastDL in sync with files added over FTP without hammering
                    # disk on every 10-second telemetry pass. Each server is spread
                    # across the 5-minute window by its id.
                    sid=int(row.get('id') or 0)
                    if sid>0 and tick%30==sid%30:
                        cp=subprocess.run(['/usr/local/sbin/hyper-cs16-ctl','fastdl-sync',str(sid)],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180)
                        if cp.returncode!=0:
                            print(f'fastdl sync server {sid}: {(cp.stdout or "").strip()[-1500:]}',file=sys.stderr)
                except Exception as exc: print(f'server {row.get("id")}: {exc}',file=sys.stderr)
            if tick%6==0:
                billing_tick(db,settings)
            flush_telegram(db,settings)
            if tick%360==0:
                with db.cursor() as cur:
                    cur.execute("DELETE FROM server_stats WHERE recorded_at < NOW() - INTERVAL 90 DAY")
                    cur.execute("DELETE FROM player_history WHERE last_seen < NOW() - INTERVAL 180 DAY")
                    cur.execute("DELETE FROM game_events WHERE created_at < NOW() - INTERVAL 90 DAY")
                    cur.execute("DELETE FROM audit_logs WHERE created_at < NOW() - INTERVAL 365 DAY")
                    cur.execute("DELETE FROM panel_events WHERE created_at < NOW() - INTERVAL 180 DAY")
            db.close()
        except Exception as exc:
            print(f'monitor loop: {exc}',file=sys.stderr)
        tick+=1; time.sleep(10)
if __name__=='__main__': main()
