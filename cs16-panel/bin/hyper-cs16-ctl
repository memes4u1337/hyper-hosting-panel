def db_update_mode(sid:int,mode:str,bots_enabled:int|None=None,bots_quota:int|None=None,bots_difficulty:int|None=None):
    try:
        con=db_connect()
        try:
            sets=['game_mode=%s']; vals=[mode]
            if bots_enabled is not None: sets.append('bots_enabled=%s'); vals.append(int(bots_enabled))
            if bots_quota is not None: sets.append('bots_quota=%s'); vals.append(int(bots_quota))
            if bots_difficulty is not None: sets.append('bots_difficulty=%s'); vals.append(int(bots_difficulty))
            vals.append(sid)
            with con.cursor() as cur: cur.execute('UPDATE servers SET '+','.join(sets)+' WHERE id=%s',tuple(vals))
        finally: con.close()
    except Exception:
        pass


def _read_cfg_value(path:Path,key:str,default:str=''):
    try:
        text=path.read_text(encoding='utf-8',errors='ignore')
        m=re.search(r'(?im)^\s*'+re.escape(key)+r'\s+"([^"]*)"',text)
        if m: return m.group(1)
        m=re.search(r'(?im)^\s*'+re.escape(key)+r'\s+(\S+)',text)
        return m.group(1) if m else default
    except Exception:
        return default


def recover_server_config(sid:int):
    row=db_server_row(sid)
    if not row: return None
    path=safe_server_path(sid)
    scfg=path/'cstrike/server.cfg'
    hostname=_read_cfg_value(scfg,'hostname',str(row.get('hostname') or row.get('name') or f'CS 1.6 #{sid}'))
    rcon=_read_cfg_value(scfg,'rcon_password','')
    svpw=_read_cfg_value(scfg,'sv_password','')
    c={'id':sid,'name':str(row.get('name') or f'CS 1.6 #{sid}'),'hostname':hostname,
       'port':int(row.get('port') or 27015),'slots':int(row.get('slots') or 16),
       'start_map':str(row.get('start_map') or 'de_dust2'),'profile':str(row.get('build_profile') or 'classic'),
       'public_ip':str(row.get('public_ip') or load_runtime().get('public_ip','')),
       'rcon_password':rcon,'server_password':svpw,'path':str(path),
       'ftp_user':str(row.get('ftp_user') or ''),'ftp_password':str(row.get('ftp_password') or ''),
       'game_mode':str(row.get('game_mode') or 'classic'),'bots_enabled':int(row.get('bots_enabled') or 0),
       'bots_quota':int(row.get('bots_quota') or 9),'bots_difficulty':int(row.get('bots_difficulty') or 3)}
    try: save_server(c)
    except Exception: pass
    return c


def load_server(sid:int):
    p=cfg_path(sid)
    legacy=legacy_cfg_path(sid)
    marker=deleted_marker(sid)
    # A deletion tombstone is authoritative. This prevents monitor/API races from
    # resurrecting a server from SQL or a stale read-only /etc JSON between the
    # filesystem deletion and the panel's SQL DELETE. server_create() explicitly
    # removes the tombstone when an ID is intentionally created again.
    if marker.exists():
        out({'ok':False,'error':f'Server {sid} was deleted; stale legacy state is ignored'},2)
    source=p if p.exists() else legacy if legacy.exists() else None
    if source is not None:
        try:
            c=json.loads(source.read_text(encoding='utf-8'))
            if source==legacy and not p.exists():
                try: save_server(c)
                except Exception: pass
            return c
        except Exception as exc:
            recovered=recover_server_config(sid)
            if recovered is not None: return recovered
            out({'ok':False,'error':f'Server {sid} config unavailable: {exc}'},2)
    recovered=recover_server_config(sid)
    if recovered is not None: return recovered
    out({'ok':False,'error':f'Server {sid} config unavailable: state JSON and SQL row are missing'},2)

def save_server(c:dict):
    ensure_state_permissions()
    p=cfg_path(int(c['id']))
    fd,tmp_name=tempfile.mkstemp(prefix=f'.{int(c["id"])}.',suffix='.tmp',dir=str(SERVER_CFG_DIR))
    tmp=Path(tmp_name)
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as fh:
            json.dump(c,fh,ensure_ascii=False,indent=2)
            fh.write('\n')
            fh.flush(); os.fsync(fh.fileno())
        os.chmod(tmp,0o640)
        try: shutil.chown(tmp,user='root',group='cs16')
        except Exception: pass
        os.replace(tmp,p)
    finally:
        try:
            if tmp.exists(): tmp.unlink()
        except Exception: pass


def run(cmd, check=True, capture=True, timeout=None, cwd=None, env=None):
    cp=subprocess.run(cmd,stdout=subprocess.PIPE if capture else None,stderr=subprocess.STDOUT if capture else None,text=True,check=False,timeout=timeout,cwd=cwd,env=env)
    if check and cp.returncode!=0:
        raise RuntimeError((cp.stdout or '').strip() or f'Command failed: {cmd!r}')
    return cp


def run_as_cs16(cmd, **kw):
    return run(['runuser','-u','cs16','--']+list(cmd),**kw)


def safe_server_path(sid:int):
    rt=load_runtime(); base=Path(rt.get('servers_dir','/srv/hyper-cs16/servers')).resolve()
    p=(base/str(sid)).resolve()
    if p.parent!=base: raise RuntimeError('Unsafe server path')
    return p


def port_available(port:int, ignore_sid:int|None=None):
    # Check both the new mutable state directory and legacy /etc configs during migration.
    # If the ignored server already owns this same port, its live UDP socket is not a conflict.
    own_same_port=False
    seen=set()
    for root in (SERVER_CFG_DIR,LEGACY_SERVER_CFG_DIR):
        for p in root.glob('*.json') if root.exists() else []:
            try:
                c=json.loads(p.read_text(encoding='utf-8')); sid=int(c.get('id',0)); key=(sid,int(c.get('port',0)))
                if root==LEGACY_SERVER_CFG_DIR and deleted_marker(sid).exists() and not cfg_path(sid).exists(): continue
                if key in seen: continue
                seen.add(key)
                if ignore_sid is not None and sid==ignore_sid:
                    if int(c.get('port',0))==port: own_same_port=True
                    continue
                if int(c.get('port',0))==port: return False
            except Exception: pass
    cp=run(['ss','-lunH'],check=False)
    needle=f':{port} '
    if needle in (cp.stdout or '') and not own_same_port: return False
    return True


def download(url:str,dst:Path):
    dst.parent.mkdir(parents=True,exist_ok=True)
    run(['curl','-fL','--retry','4','--retry-delay','2','--connect-timeout','20','-o',str(dst),url],timeout=600)


def extract_zip(path:Path,dst:Path):
    dst=dst.resolve(); dst.mkdir(parents=True,exist_ok=True)
    with zipfile.ZipFile(path) as z:
        for m in z.infolist():
            target=(dst/m.filename).resolve()
            if dst not in target.parents and target!=dst: raise RuntimeError('Unsafe zip path')
            mode=(m.external_attr >> 16) & 0xFFFF
            if stat.S_ISLNK(mode): raise RuntimeError('Symlinks are not allowed in downloaded zip archives')
        z.extractall(dst)


def extract_tar(path:Path,dst:Path):
    dst=dst.resolve(); dst.mkdir(parents=True,exist_ok=True)
    with tarfile.open(path,'r:*') as t:
        members=t.getmembers()
        for m in members:
            target=(dst/m.name).resolve()
            if dst not in target.parents and target!=dst: raise RuntimeError('Unsafe tar path')
            if not (m.isdir() or m.isfile()): raise RuntimeError('Links/devices are not allowed in downloaded tar archives')
        for m in members:
            t.extract(m,dst,set_attrs=True)


def _set_liblist_metamod(cstrike:Path, relpath:str):
    liblist=cstrike/'liblist.gam'
    if not liblist.exists():
        raise RuntimeError(f'liblist.gam is missing: {liblist}')
    text=liblist.read_text(encoding='latin1',errors='ignore')
    line=f'gamedll_linux "{relpath}"'
    if re.search(r'(?im)^\s*gamedll_linux\s+"[^"]+"', text):
        text=re.sub(r'(?im)^\s*gamedll_linux\s+"[^"]+"', line, text, count=1)
    else:
        text=text.rstrip()+f'\n{line}\n'
    liblist.write_text(text,encoding='latin1')


def install_metamod_classic(path:Path):
    """Install AlliedModders Metamod for original SteamCMD HLDS.

    Metamod-R is intended primarily for ReHLDS and has caused startup crashes on
    some stock 8684 HLDS builds. The official 1.21.1-am binary is the compatible
    choice for the classic profile.
    """
    cstrike=path/'cstrike'; cstrike.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='hhcs16-metamod-am-') as td:
        td=Path(td); z=td/'metamod.zip'; download(METAMOD_AM_URL,z); extract_zip(z,td/'mm')
        candidates=list((td/'mm').rglob('metamod.so'))
        if not candidates:
            candidates=list((td/'mm').rglob('metamod_i386.so'))
        if not candidates: raise RuntimeError('Metamod 1.21.1-am Linux binary not found in archive')
        target=cstrike/'addons/metamod/dlls'; target.mkdir(parents=True,exist_ok=True)
        # Remove stale Metamod-R locations so liblist cannot accidentally load them.
        for stale in [cstrike/'addons/metamod/metamod_i386.so', target/'metamod_i386.so', target/'metamod.so']:
            try: stale.unlink()
            except FileNotFoundError: pass
        shutil.copy2(candidates[0],target/'metamod.so')
    _set_liblist_metamod(cstrike,'addons/metamod/dlls/metamod.so')
    # Metamod-R ships a different config.ini syntax. If a server was converted
    # to classic Metamod, keeping that file produces a wall of parser errors.
    stale_cfg=cstrike/'addons/metamod/config.ini'
    if stale_cfg.exists():
        try: stale_cfg.unlink()
        except Exception: pass


def install_metamod_rehlds(path:Path):
    cstrike=path/'cstrike'; cstrike.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='hhcs16-metamod-r-') as td:
        td=Path(td); z=td/'metamod-r.zip'; download(METAMOD_URL,z); extract_zip(z,td/'mm')
        candidates=list((td/'mm').rglob('metamod_i386.so')) + list((td/'mm').rglob('metamod.so'))
        if not candidates: raise RuntimeError('Metamod-R Linux32 binary not found in archive')
        target=cstrike/'addons/metamod/dlls'; target.mkdir(parents=True,exist_ok=True)
        for stale in [cstrike/'addons/metamod/metamod_i386.so', target/'metamod_i386.so', target/'metamod.so']:
            try: stale.unlink()
            except FileNotFoundError: pass
        shutil.copy2(candidates[0],target/'metamod.so')
    _set_liblist_metamod(cstrike,'addons/metamod/dlls/metamod.so')


def install_amxx(path:Path):
    cstrike=path/'cstrike'; cstrike.mkdir(parents=True,exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='hhcs16-amxx-') as td:
        td=Path(td)
        b=td/'amxx-base.tgz'; download(AMXX_BASE,b); extract_tar(b,cstrike)
        cs=td/'amxx-cstrike.tgz'; download(AMXX_CSTRIKE,cs); extract_tar(cs,cstrike)
    mp=cstrike/'addons/metamod/plugins.ini'; mp.parent.mkdir(parents=True,exist_ok=True)
    existing=mp.read_text(encoding='utf-8',errors='ignore') if mp.exists() else ''
    line='linux addons/amxmodx/dlls/amxmodx_mm_i386.so'
    if line not in existing: mp.write_text((existing.rstrip()+'\n'+line+'\n').lstrip(),encoding='utf-8')
    plugins=cstrike/'addons/amxmodx/configs/plugins.ini'
    if plugins.exists() and '; HYPER-HOST' not in plugins.read_text(encoding='utf-8',errors='ignore'):
        plugins.write_text(plugins.read_text(encoding='utf-8',errors='ignore')+'\n; HYPER-HOST: upload .amxx files to addons/amxmodx/plugins and enable them here.\n',encoding='utf-8')


def install_metamod_amxx(path:Path, profile:str='classic'):
    # AMXX files are safe to refresh on the immutable base. For existing servers
    # server_repair() only swaps Metamod and preserves user AMXX configs/plugins.
    if profile=='rehlds': install_metamod_rehlds(path)
    else: install_metamod_classic(path)
    install_amxx(path)

def install_rehlds(path:Path):
    with tempfile.TemporaryDirectory(prefix='hhcs16-rehlds-') as td:
        td=Path(td)
        z=td/'rehlds.zip'; download(REHLDS_URL,z); extract_zip(z,td/'rehlds')
        src=td/'rehlds'/'bin/linux32'
        if not src.exists(): raise RuntimeError('ReHLDS linux32 payload not found')
        for name in ['engine_i486.so','hlds_linux','core.so','filesystem_stdio.so','demoplayer.so']:
            if (src/name).exists(): shutil.copy2(src/name,path/name)
        z2=td/'regamedll.zip'; download(REGAMEDLL_URL,z2); extract_zip(z2,td/'regamedll')
        candidates=list((td/'regamedll').rglob('cstrike/dlls/cs.so'))
        if candidates:
            (path/'cstrike/dlls').mkdir(parents=True,exist_ok=True); shutil.copy2(candidates[0],path/'cstrike/dlls/cs.so')


def ensure_steam_runtime(steam:Path):
    """Repair the 32-bit Steam runtime expected by GoldSrc.

    This must run even when the HLDS base itself is cached; older installers
    returned early and never created ~/.steam/sdk32/steamclient.so.
    """
    sdk=Path('/srv/hyper-cs16/.steam/sdk32'); sdk.mkdir(parents=True,exist_ok=True)
    candidates=[steam.parent/'linux32/steamclient.so', Path('/opt/steamcmd/linux32/steamclient.so')]
    src=next((x for x in candidates if x.is_file()),None)
    if src is None:
        # A lightweight SteamCMD invocation normally materializes linux32/steamclient.so.
        run_as_cs16([str(steam),'+quit'],check=False,timeout=180)
        src=next((x for x in candidates if x.is_file()),None)
    if src is None:
        raise RuntimeError('SteamCMD steamclient.so is missing; reinstall /opt/steamcmd')
    dst=sdk/'steamclient.so'; shutil.copy2(src,dst)
    shutil.chown(Path('/srv/hyper-cs16/.steam'),user='cs16',group='cs16')
    shutil.chown(sdk,user='cs16',group='cs16'); shutil.chown(dst,user='cs16',group='cs16')
    os.chmod(Path('/srv/hyper-cs16/.steam'),0o755); os.chmod(sdk,0o755); os.chmod(dst,0o644)
    return dst


def ensure_base(profile='classic'):
    require_root(); rt=load_runtime(); base=Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds'))
    marker=base/'.hyper-cs16-ready'
    required=[base/'hlds_run',base/'hlds_linux',base/'cstrike/liblist.gam',base/'cstrike/dlls/cs.so',base/'cstrike/maps/de_dust2.bsp']
    base.parent.mkdir(parents=True,exist_ok=True); base.mkdir(parents=True,exist_ok=True)
    run(['chown','cs16:www-data',str(base)],check=False); os.chmod(base,0o2775)
    steam=Path(rt.get('steamcmd','/opt/steamcmd/steamcmd.sh'))
    if not steam.exists(): raise RuntimeError(f'SteamCMD missing: {steam}')
    steam_runtime=ensure_steam_runtime(steam)
    if marker.exists() and all(x.exists() for x in required):
        # Repair the base add-on loader too; older builds installed Metamod-R into stock HLDS.
        install_metamod_classic(base)
        banned=base/'cstrike/banned.cfg'; listip=base/'cstrike/listip.cfg'
        banned.touch(exist_ok=True); listip.touch(exist_ok=True)
        normalize_permissions(base)
        return {'ok':True,'path':str(base),'cached':True,'steamclient':str(steam_runtime)}
    log_dir=APP_ROOT/'logs'; log_dir.mkdir(parents=True,exist_ok=True)
    log_file=log_dir/'steamcmd-base.log'
    cmd=[str(steam),'+force_install_dir',str(base),'+login','anonymous','+app_set_config','90','mod','cstrike','+app_update','90','-beta','steam_legacy','validate','+quit']
    attempts=[]
    for attempt in range(1,6):
        try:
            cp=run_as_cs16(cmd,check=False,timeout=1800)
            output=cp.stdout or ''
            attempts.append(output)
            with log_file.open('a',encoding='utf-8') as fh:
                fh.write(f'\n===== SteamCMD pass {attempt} @ {time.strftime("%F %T")} rc={cp.returncode} =====\n')
                fh.write(output[-200000:])
        except subprocess.TimeoutExpired as exc:
            output=(exc.stdout or '') if isinstance(exc.stdout,str) else ''
            attempts.append(output+'\nTIMEOUT')
            with log_file.open('a',encoding='utf-8') as fh:
                fh.write(f'\n===== SteamCMD pass {attempt} TIMEOUT @ {time.strftime("%F %T")} =====\n{output[-50000:]}\n')
        if all(x.exists() for x in required): break
        time.sleep(2)
    if not all(x.exists() for x in required):
        missing=', '.join(str(x.relative_to(base)) for x in required if not x.exists())
        tail=(attempts[-1] if attempts else '')[-3000:]
        raise RuntimeError(f'HLDS installation incomplete; missing: {missing}. SteamCMD log: {log_file}. Last output: {tail}')
    install_metamod_amxx(base,'classic')
    (base/'cstrike/banned.cfg').touch(exist_ok=True)
    (base/'cstrike/listip.cfg').touch(exist_ok=True)
    marker.write_text(f'classic + Metamod {METAMOD_AM_VERSION} + AMXX 1.9 build {AMXX_BUILD}\n',encoding='utf-8')
    shutil.chown(base,user='cs16',group='www-data')
    for root,dirs,files in os.walk(base):
        for d in dirs:
            try: os.chmod(Path(root)/d,0o2775); shutil.chown(Path(root)/d,user='cs16',group='www-data')
            except Exception: pass
        for f in files:
            try: os.chmod(Path(root)/f,0o664 if not os.access(Path(root)/f,os.X_OK) else 0o775); shutil.chown(Path(root)/f,user='cs16',group='www-data')
            except Exception: pass
    for exe in ['hlds_run','hlds_linux']:
        if (base/exe).exists(): os.chmod(base/exe,0o775)
    return {'ok':True,'path':str(base),'cached':False,'steamcmd_log':str(log_file)}



def _fastdl_url(c:dict)->str:
    """Stable per-server FastDL URL.

    GoldSrc is most reliable with a plain HTTP endpoint. Prefer the public IPv4
    already configured for the hosting node; fall back to the panel hostname.
    Port 80 is already the web port of the host, so no extra game-port mapping is
    required beyond the web service that already serves the panel.
    """
    sid=int(c.get('id') or 0)
    public=''
    try:
        rt=load_runtime(); public=str(rt.get('public_ip') or c.get('public_ip') or '').strip()
    except Exception:
        public=str(c.get('public_ip') or '').strip()
    try:
        ip=ipaddress.ip_address(public)
        if ip.version==4 and not ip.is_unspecified:
            return f'http://{public}/fastdl/{sid}'
    except Exception:
        pass
    return f'https://{FASTDL_DOMAIN}/fastdl/{sid}'


def _fastdl_apply_cfg(c:dict, root:Path|None=None)->dict:
    """Install one canonical FastDL block at the end of server.cfg.

    Imported packs often contain old third-party sv_downloadurl values.  Leaving
    several copies in the same cfg makes the effective value depend on order, so
    v3.2 removes only the FastDL transport cvars and writes one managed block.  No
    gameplay cvars, hostname, ZP settings, rates, map settings or plugin execs are
    rewritten.
    """
    root=Path(root or c['path'])
    cfg=root/'cstrike/server.cfg'; cfg.parent.mkdir(parents=True,exist_ok=True)
    text=cfg.read_text(encoding='utf-8',errors='ignore') if cfg.exists() else ''
    text=text.replace('\r\n','\n').replace('\r','\n')
    begin='// HYPER-HOST FASTDL BEGIN'
    end='// HYPER-HOST FASTDL END'
    text=re.sub(r'(?ims)^\s*// HYPER-HOST FASTDL BEGIN\s*$.*?^\s*// HYPER-HOST FASTDL END\s*$\n?', '', text)
    managed={'sv_downloadurl','sv_allowdownload','sv_allowupload','sv_send_resources','sv_allow_dlfile'}
    kept=[]; replaced=[]
    for line in text.splitlines():
        m=re.match(r'^\s*([A-Za-z_][A-Za-z0-9_]*)\s+',line)
        if m and m.group(1).lower() in managed:
            replaced.append(line.strip())
            continue
        kept.append(line)
    url=_fastdl_url(c)
    block=[
        begin,
        '// Managed automatically by HYPER-HOST. Keep this block at the end of server.cfg.',
        'sv_allowdownload 1',
        'sv_allowupload 1',
        'sv_send_resources 1',
        'sv_allow_dlfile 1',
        f'sv_downloadurl "{url}"',
        end,
    ]
    content='\n'.join(kept).rstrip()+'\n\n'+'\n'.join(block)+'\n'
    cfg.write_text(content,encoding='utf-8')
    return {'ok':True,'url':url,'config':str(cfg),'replaced':replaced}


def _fastdl_copy_tree(src:Path,dst:Path):
    if not src.is_dir():
        if dst.exists(): shutil.rmtree(dst,ignore_errors=True)
        return
    dst.mkdir(parents=True,exist_ok=True)
    cp=run(['rsync','-a','--delete','--safe-links',str(src)+'/',str(dst)+'/'],check=False,timeout=1200)
    if cp.returncode!=0:
        raise RuntimeError('FastDL rsync failed for '+str(src)+': '+(cp.stdout or '')[-2500:])


def fastdl_sync(sid:int, configure:bool=True):
    """Mirror only client-downloadable game assets to the web FastDL tree."""
    require_root(); c=load_server(sid); root=Path(c['path']); cstrike=root/'cstrike'
    if not cstrike.is_dir(): raise RuntimeError(f'cstrike directory is missing: {cstrike}')
    FASTDL_ROOT.mkdir(parents=True,exist_ok=True)
    dest=FASTDL_ROOT/str(sid); dest.mkdir(parents=True,exist_ok=True)
    copied_dirs=[]
    for name in FASTDL_DIRS:
        src=cstrike/name; dd=dest/name
        _fastdl_copy_tree(src,dd)
        if src.is_dir(): copied_dirs.append(name)
    # Root WADs are requested by their cstrike-relative filename, not from a subdir.
    source_wads={p.name:p for p in cstrike.iterdir() if p.is_file() and p.suffix.lower()=='.wad'}
    for old in dest.glob('*.wad'):
        if old.name not in source_wads:
            try: old.unlink()
            except OSError: pass
    for name,src in source_wads.items():
        shutil.copy2(src,dest/name)
    cfg_result=_fastdl_apply_cfg(c,root) if configure else {'url':_fastdl_url(c)}
    # Public static files: nginx runs as www-data on this host. Keep them read-only.
    run(['chown','-R','root:www-data',str(dest)],check=False)
    run(['find',str(dest),'-type','d','-exec','chmod','0755','{}','+'],check=False)
    run(['find',str(dest),'-type','f','-exec','chmod','0644','{}','+'],check=False)
    files=0; total=0
    for fp in dest.rglob('*'):
        try:
            if fp.is_file(): files+=1; total+=fp.stat().st_size
        except OSError: pass
    c['fastdl_url']=cfg_result.get('url') or _fastdl_url(c)
    c['fastdl_last_sync']=int(time.time()); c['fastdl_files']=files; c['fastdl_bytes']=total
    save_server(c)
    runtime_applied=False; runtime_errors=[]
    if service_status(sid)=='active' and udp_listening(int(c.get('port') or 0)):
        for cmd in ['sv_allowdownload 1','sv_allowupload 1','sv_send_resources 1','sv_allow_dlfile 1',f'sv_downloadurl "{c["fastdl_url"]}"']:
            try: query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),cmd,2.0)
            except Exception as exc: runtime_errors.append(str(exc))
        runtime_applied=not runtime_errors
    return {'ok':True,'id':sid,'url':c['fastdl_url'],'root':str(dest),'files':files,'bytes':total,'dirs':copied_dirs,'config':cfg_result,'runtime_applied':runtime_applied,'runtime_errors':runtime_errors[:5]}


def fastdl_status(sid:int):
    c=load_server(sid); dest=FASTDL_ROOT/str(sid); cfg=Path(c['path'])/'cstrike/server.cfg'
    url=_fastdl_url(c); files=0; total=0
    if dest.is_dir():
        for fp in dest.rglob('*'):
            try:
                if fp.is_file(): files+=1; total+=fp.stat().st_size
            except OSError: pass
    current=''
    if cfg.is_file():
        try:
            m=re.findall(r'(?im)^\s*sv_downloadurl\s+"?([^"\r\n]+)',cfg.read_text(encoding='utf-8',errors='ignore'))
            if m: current=m[-1].strip()
        except Exception: pass
    return {'ok':True,'id':sid,'url':url,'configured_url':current,'configured':current.rstrip('/')==url.rstrip('/'),'root':str(dest),'exists':dest.is_dir(),'files':files,'bytes':total,'last_sync':int(c.get('fastdl_last_sync') or 0)}


def _extract_external_fastdl_url(server_root:Path)->str:
    cfg=server_root/'cstrike/server.cfg'
    if not cfg.is_file(): return ''
    try: text=cfg.read_text(encoding='utf-8',errors='ignore')
    except Exception: return ''
    vals=[]
    for m in re.finditer(r'(?im)^\s*sv_downloadurl\s+"?([^"\r\n;]+)',text):
        v=m.group(1).strip().rstrip('/')
        if re.match(r'^https?://',v,re.I): vals.append(v)
    return vals[-1] if vals else ''


def _safe_resource_rel(rel:str)->str:
    rel=urllib.parse.unquote(str(rel or '')).replace('\\','/').strip().lstrip('/')
    rel=re.sub(r'/+','/',rel)
    if not rel or rel.startswith('.') or '..' in Path(rel).parts: return ''
    if len(rel)>260: return ''
    if not re.fullmatch(r'[A-Za-z0-9_./+()\-\[\] ]+',rel): return ''
    return rel


def _download_fastdl_resource(base_url:str, rel:str, dst_root:Path, max_bytes:int=64*1024*1024)->bool:
    rel=_safe_resource_rel(rel)
    if not base_url or not rel: return False
    dst=(dst_root/'cstrike'/rel).resolve(); croot=(dst_root/'cstrike').resolve()
    if croot!=dst and croot not in dst.parents: return False
    if dst.is_file(): return True
    url=base_url.rstrip('/')+'/'+urllib.parse.quote(rel,safe='/._-+()[]')
    dst.parent.mkdir(parents=True,exist_ok=True)
    tmp=dst.with_name('.'+dst.name+'.fastdl-'+secrets.token_hex(4))
    cp=run(['curl','--proto','=http,https','-fL','--retry','2','--connect-timeout','7','--max-time','35','--max-filesize',str(max_bytes),'-A','HYPER-HOST-CS16/3.2','-o',str(tmp),url],check=False,timeout=45)
    if cp.returncode!=0 or not tmp.is_file() or tmp.stat().st_size<1:
        try: tmp.unlink()
        except OSError: pass
        return False
    os.replace(tmp,dst)
    return True


def _hydrate_resources_from_external_fastdl(server_root:Path, base_url:str, rels:list[str])->list[str]:
    got=[]
    if not base_url: return got
    for rel in list(dict.fromkeys(_safe_resource_rel(x) for x in rels))[:120]:
        if rel and _download_fastdl_resource(base_url,rel,server_root): got.append(rel)
    return got


def _res_declared_resources(server_root:Path)->list[str]:
    maps=server_root/'cstrike/maps'; out=[]
    if not maps.is_dir(): return out
    for res in maps.glob('*.res'):
        try: lines=res.read_text(encoding='latin1',errors='ignore').splitlines()
        except Exception: continue
        for raw in lines:
            st=raw.strip().strip('"')
            if not st or st.startswith(('/', ';', '#')): continue
            st=st.split(';',1)[0].strip().strip('"')
            rel=_safe_resource_rel(st)
            if rel: out.append(rel)
    return list(dict.fromkeys(out))[:600]

def write_server_cfg(path:Path,c:dict):
    cfg=path/'cstrike/server.cfg'; cfg.parent.mkdir(parents=True,exist_ok=True)
    def q(v): return str(v).replace('"','').replace('\n',' ').replace('\r',' ')
    content=f'''// HYPER-HOST CS 1.6 managed configuration\nhostname "{q(c['hostname'])}"\nrcon_password "{q(c['rcon_password'])}"\nsv_password "{q(c.get('server_password',''))}"\nsv_lan 0\nsv_region 255\nsv_contact ""\nsv_aim 0\nsv_cheats 0\nsv_allowupload 1\nsv_allowdownload 1\nsv_downloadurl ""\nsv_maxrate 100000\nsv_minrate 25000\nsv_maxupdaterate 102\nsv_minupdaterate 30\nsys_ticrate 1000\npausable 0\nlog on\nmp_autokick 0\nmp_autoteambalance 1\nmp_buytime 1.5\nmp_c4timer 35\nmp_chattime 10\nmp_flashlight 1\nmp_freezetime 3\nmp_friendlyfire 0\nmp_hostagepenalty 2\nmp_limitteams 2\nmp_maxrounds 0\nmp_roundtime 2.0\nmp_startmoney 800\nmp_timelimit 25\nmp_tkpunish 0\nexec banned.cfg\nexec listip.cfg\n'''
    cfg.write_text(content,encoding='utf-8')
    _fastdl_apply_cfg(c,path)
    mapcycle=path/'cstrike/mapcycle.txt'
    if not mapcycle.exists(): mapcycle.write_text('de_dust2\nde_inferno\nde_nuke\nde_train\ncs_office\ncs_italy\n',encoding='utf-8')


def normalize_permissions(path:Path):
    run(['chown','-R','cs16:www-data',str(path)],check=False)
    run(['chmod','-R','u+rwX,g+rwX,o+rX',str(path)],check=False)
    run(['find',str(path),'-type','d','-exec','chmod','g+s','{}','+'],check=False)
    for exe in ['hlds_run','hlds_linux','hltv']:
        p=path/exe
        if p.exists(): os.chmod(p,0o775)


def setup_ftp(c:dict,path:Path,password:str|None=None):
    """Create one FTP account whose chroot is the exact game server directory.

    No /etc/fstab and no bind mount are used. HYPER-HOST's FTP runtime gets a
    dedicated `cs16` scope, so user cs16_<id> lands directly in `/` of that
    server and can see hlds_run/cstrike immediately.
    """
    user=c.get('ftp_user') or f'cs16_{c["id"]}'
    password=password or c.get('ftp_password') or secrets.token_urlsafe(12)
    ctl=shutil.which('hyper-host-ctl') or '/usr/local/sbin/hyper-host-ctl'
    if not Path(ctl).exists():
        return user,password,'HYPER-HOST FTP runtime not found'
    # Clean old v1.0-v1.5 bind target if it exists.
    old_home=Path('/var/www/hyper-host-ftp')/user/'uploads'
    run(['umount','-lf',str(old_home)],check=False)
    # ProFTPD virtual users run as www-data. Keep the exact game-server root
    # traversable and writable by that group while HLDS remains owned by cs16.
    run(['chown','cs16:www-data',str(path)],check=False)
    run(['chmod','2775',str(path)],check=False)
    cp=run([ctl,'create-ftp',user,password,'cs16',str(int(c['id']))],check=False,timeout=180)
    if cp.returncode!=0:
        return user,password,(cp.stdout or 'FTP account creation failed').strip()
    c['ftp_user']=user; c['ftp_password']=password
    return user,password,''


def ftp_test(sid:int):
    c=load_server(sid); user=str(c.get('ftp_user') or ''); pw=str(c.get('ftp_password') or '')
    if not user or not pw:
        return {'ok':False,'error':'FTP credentials are missing'}
    ftp=None
    try:
        ftp=ftplib.FTP()
        ftp.connect('127.0.0.1',21,timeout=8)
        ftp.login(user,pw)
        # Active mode keeps the local diagnostic independent from PASV/NAT.
        ftp.set_pasv(False)
        pwd_now=ftp.pwd()
        names=ftp.nlst()
        required={'cstrike','hlds_run'}
        missing=sorted(required-set(names))
        if missing:
            return {'ok':False,'error':'FTP login works but wrong root: missing '+', '.join(missing),'pwd':pwd_now,'items':names[:50]}
        return {'ok':True,'pwd':pwd_now,'items':names[:50],'root':str(c.get('path',''))}
    except Exception as exc:
        return {'ok':False,'error':str(exc)}
    finally:
        if ftp:
            try: ftp.quit()
            except Exception: pass


def ftp_repair(sid:int):
    require_root(); c=load_server(sid); path=Path(c['path'])
    if not path.is_dir(): raise RuntimeError(f'Server directory missing: {path}')
    user,pw,warning=setup_ftp(c,path,str(c.get('ftp_password') or '') or None)
    c['ftp_user']=user; c['ftp_password']=pw; save_server(c); db_update_ftp(sid,user,pw)
    # Let the FTP daemon notice updated user_conf/auth files before testing.
    time.sleep(.4)
    test=ftp_test(sid)
    return {'ok':bool(test.get('ok')),'ftp_user':user,'ftp_password':pw,'root':str(path),'test':test,'warning':warning}


def ftp_restore():
    """Repair per-server direct FTP chroots after reboot/update."""
    require_root(); restored=[]; warnings=[]
    for p in sorted(SERVER_CFG_DIR.glob('*.json')):
        try:
            c=json.loads(p.read_text(encoding='utf-8'))
            sid=int(c.get('id',0))
            if sid<1: continue
            result=ftp_repair(sid)
            if result.get('ok'): restored.append(sid)
            else: warnings.append(f'{sid}: '+str(result.get('warning') or result.get('test',{}).get('error') or 'FTP repair failed'))
        except Exception as exc:
            warnings.append(f'{p.name}: {exc}')
    return {'ok':not warnings,'restored':restored,'warnings':warnings}


def detect_lan_ip():
    rt=load_runtime(); configured=str(rt.get('lan_ip') or '').strip()
    try:
        if configured and ipaddress.ip_address(configured).version==4:
            return configured
    except Exception:
        pass
    cp=run(['ip','-4','route','get','1.1.1.1'],check=False)
    m=re.search(r'\bsrc\s+(\d+\.\d+\.\d+\.\d+)',cp.stdout or '')
    return m.group(1) if m else '127.0.0.1'


def query_info_retry(port:int, attempts:int=3):
    """Small retry window for UDP A2S. A dropped query packet is not a dead server."""
    last=''
    timeouts=(0.9,1.3,1.8,2.2)
    for i in range(max(1,attempts)):
        try:
            return query_info('127.0.0.1',int(port),timeouts[min(i,len(timeouts)-1)]), ''
        except Exception as exc:
            last=str(exc)
            if i+1<attempts: time.sleep(.15)
    return None,last or 'A2S_INFO timeout'


def network_info(sid:int):
    c=load_server(sid); port=int(c['port']); public=str(c.get('public_ip') or load_runtime().get('public_ip') or '')
    lan=detect_lan_ip(); svc=service_status(sid); udp=udp_listening(port)
    local_query=False; qerr=''; q={}
    if udp:
        qi,qerr=query_info_retry(port,3)
        if qi:
            q=qi; local_query=True
    ssout=run(['ss','-lunp'],check=False).stdout or ''
    socket_lines=[x for x in ssout.splitlines() if re.search(rf':{port}(?:\s|$)',x)]
    health='online' if svc=='active' and udp else ('starting' if svc=='active' else 'offline')
    query_state='ok' if local_query else ('retrying' if udp else 'offline')
    return {
        # Service + UDP is the authoritative connectivity signal. A2S can be rate-limited transiently.
        'ok':svc=='active' and udp,
        'health':health,'service':svc,'udp_listening':udp,'a2s_local':local_query,'query_state':query_state,
        'query_error':qerr,'query':q,
        'public_ip':public,'lan_ip':lan,'port':port,
        'public_address':f'{public}:{port}' if public else '',
        'lan_address':f'{lan}:{port}' if lan else '',
        'socket':socket_lines[:8],
        'internet_note':f'For Internet access forward UDP {port} on the router to {lan}:{port}.',
        'lan_note':f'From the same LAN use {lan}:{port}.'
    }

def udp_listening(port:int)->bool:
    cp=run(['ss','-lunH'],check=False)
    needle=f':{int(port)}'
    for line in (cp.stdout or '').splitlines():
        parts=line.split()
        # ss output varies slightly between iproute2 versions; find the local endpoint token.
        if any(tok.endswith(needle) or tok.endswith(needle+'\n') for tok in parts):
            return True
    return False


def wait_server_ready(c:dict, timeout:float=25.0):
    deadline=time.time()+timeout; last=''; udp_since=None
    while time.time()<deadline:
        if service_status(int(c['id']))!='active':
            last='systemd service is not active'; udp_since=None; time.sleep(.6); continue
        if not udp_listening(int(c['port'])):
            last=f'UDP {c["port"]} is not listening'; udp_since=None; time.sleep(.6); continue
        if udp_since is None: udp_since=time.time()
        qi,qerr=query_info_retry(int(c['port']),1)
        if qi: return True,qi
        last=f'A2S_INFO transient failure: {qerr}'
        # A real hlds_linux UDP socket is enough to declare the process ready. A2S is
        # auxiliary telemetry and may be temporarily rate-limited during map loading.
        if time.time()-udp_since>=2.5:
            return True,{'map':str(c.get('start_map') or ''),'query_degraded':True,'query_error':qerr}
        time.sleep(.8)
    return False,last or 'server readiness timeout'


def repair_server_runtime(sid:int):
    require_root(); c=load_server(sid); path=Path(c['path'])
    rt=load_runtime(); steam=Path(rt.get('steamcmd','/opt/steamcmd/steamcmd.sh')); ensure_steam_runtime(steam)
    if not path.is_dir(): raise RuntimeError(f'Server directory missing: {path}')
    profile=str(c.get('profile','classic'))
    if profile=='rehlds':
        install_metamod_rehlds(path)
    else:
        install_metamod_classic(path)
    # Preserve existing AMXX configs/plugins, only ensure the loader entry exists.
    mp=path/'cstrike/addons/metamod/plugins.ini'; mp.parent.mkdir(parents=True,exist_ok=True)
    existing=mp.read_text(encoding='utf-8',errors='ignore') if mp.exists() else ''
    line='linux addons/amxmodx/dlls/amxmodx_mm_i386.so'
    if line not in existing and (path/'cstrike/addons/amxmodx/dlls/amxmodx_mm_i386.so').exists():
        mp.write_text((existing.rstrip()+'\n'+line+'\n').lstrip(),encoding='utf-8')
    (path/'cstrike/banned.cfg').touch(exist_ok=True); (path/'cstrike/listip.cfg').touch(exist_ok=True)
    normalize_permissions(path)
    run(['systemctl','daemon-reload'],check=False)
    run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
    ok,detail=wait_server_ready(c,30.0)
    if not ok:
        run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False)
        journal=run(['journalctl','-u',f'hyper-cs16@{sid}.service','-n','120','--no-pager','-o','cat'],check=False).stdout or ''
        debug=''
        for dp in [path/'debug.log', path/'cstrike/debug.log']:
            if dp.is_file(): debug += f'\n--- {dp} ---\n'+dp.read_text(encoding='latin1',errors='replace')[-8000:]
        raise RuntimeError(f'HLDS health check failed: {detail}.\n{journal[-8000:]}{debug}')
    return {'ok':True,'id':sid,'port':int(c['port']),'query':detail}


def server_create(args):
    require_root()
    try: deleted_marker(args.id).unlink()
    except FileNotFoundError: pass
    except OSError: pass
    if not (1<=args.slots<=32): raise RuntimeError('Slots must be 1..32 (GoldSrc protocol limit)')
    if not (27015<=args.port<=27100): raise RuntimeError('Port must be 27015..27100')
    if not SAFE_MAP.fullmatch(args.map): raise RuntimeError('Invalid start map')
    if not SAFE_NAME.fullmatch(args.name): raise RuntimeError('Invalid server name')
    if not args.hostname or len(args.hostname)>160: raise RuntimeError('Invalid hostname')
    if not port_available(args.port,args.id): raise RuntimeError(f'Port {args.port} is already used')
    rt=load_runtime(); path=safe_server_path(args.id)
    base=Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds'))
    ensure_base('classic')
    if path.exists(): shutil.rmtree(path)
    path.parent.mkdir(parents=True,exist_ok=True)
    run(['rsync','-a','--delete',str(base)+'/',str(path)+'/'],timeout=600)
    if not (path/'cstrike/maps'/(args.map+'.bsp')).is_file():
        shutil.rmtree(path,ignore_errors=True); raise RuntimeError(f'Start map is not installed in base HLDS: {args.map}')
    if args.profile=='rehlds':
        install_rehlds(path)
        install_metamod_rehlds(path)
    rcon=secrets.token_urlsafe(18)
    c={'id':args.id,'name':args.name,'hostname':args.hostname,'port':args.port,'slots':args.slots,'start_map':args.map,
       'profile':args.profile,'public_ip':rt.get('public_ip',''),'rcon_password':rcon,'server_password':args.password or '',
       'path':str(path),'ftp_user':'','ftp_password':''}
    write_server_cfg(path,c); normalize_permissions(path)
    # Prepare integrations before the very first HLDS start so AMXX sees mysql/sql.cfg
    # immediately. SQL/FTP failures are non-fatal and never destroy the game server.
    save_server(c)
    user,pw,ftp_warning=setup_ftp(c,path)
    save_server(c); time.sleep(.2)
    sql_warning=''
    try:
        sql_info=sql_provision(args.id)
        # sql_provision persists SQL credentials; reload so later state writes cannot
        # accidentally erase them.
        c=load_server(args.id)
    except Exception as exc:
        sql_info={'ok':False,'error':str(exc)}; sql_warning='Automatic SQL setup failed: '+str(exc)
    fastdl_info=fastdl_sync(args.id,True)
    c=load_server(args.id)
    run(['systemctl','daemon-reload'],check=False)
    run(['systemctl','enable',f'hyper-cs16@{args.id}.service'],check=False)
    run(['systemctl','restart',f'hyper-cs16@{args.id}.service'],check=False)
    ok,detail=wait_server_ready(c,30.0)
    if not ok:
        run(['systemctl','stop',f'hyper-cs16@{args.id}.service'],check=False)
        journal=run(['journalctl','-u',f'hyper-cs16@{args.id}.service','-n','120','--no-pager','-o','cat'],check=False).stdout or ''
        debug=''
        for dp in [path/'debug.log',path/'cstrike/debug.log']:
            if dp.is_file(): debug += '\n--- '+str(dp)+' ---\n'+dp.read_text(encoding='latin1',errors='replace')[-8000:]
        raise RuntimeError(f'HLDS failed health check: {detail}. '+journal[-7000:]+debug)
    ftp_diag=ftp_test(args.id) if not ftp_warning else {'ok':False,'error':ftp_warning}
    if not ftp_diag.get('ok') and not ftp_warning: ftp_warning=str(ftp_diag.get('error') or 'FTP self-test failed')
    return {'ok':True,'id':args.id,'path':str(path),'rcon_password':rcon,'ftp_user':user,'ftp_password':pw,'ftp_warning':ftp_warning,'ftp_test':ftp_diag,'service':'active','sql':sql_info,'sql_warning':sql_warning,'fastdl':fastdl_info}


def _recent_failure_log(sid:int, lines:int=100):
    cp=run(['journalctl','-u',f'hyper-cs16@{sid}.service','-n',str(max(20,min(300,lines))),'--no-pager','-o','cat'],check=False)
    return (cp.stdout or '')[-12000:]


def actual_hlds_pid(sid:int):
    """Return the real hlds_linux pid, never the legacy hlds_run shell wrapper."""
    main=get_pid(sid)
    candidates=[]
    if main>0: candidates.append(main)
    cp=run(['pgrep','-u','cs16','-f',f'/srv/hyper-cs16/servers/{sid}/hlds_linux'],check=False)
    for token in (cp.stdout or '').split():
        try:
            x=int(token)
            if x not in candidates: candidates.append(x)
        except Exception: pass
    root=str(safe_server_path(sid)/'hlds_linux')
    for pidv in candidates:
        try:
            raw=Path(f'/proc/{pidv}/cmdline').read_bytes().replace(b'\0',b' ').decode('utf-8','replace')
            if root in raw: return pidv
        except Exception: pass
    return 0


def _choose_safe_map(c:dict):
    maps=Path(c['path'])/'cstrike/maps'
    requested=str(c.get('start_map') or '')
    if requested and (maps/(requested+'.bsp')).is_file(): return requested
    if (maps/'de_dust2.bsp').is_file(): return 'de_dust2'
    found=sorted(p.stem for p in maps.glob('*.bsp') if SAFE_MAP.fullmatch(p.stem)) if maps.is_dir() else []
    if found: return found[0]
    raise RuntimeError('No playable .bsp maps are installed on this server')


def _recovery_backup(sid:int, c:dict):
    stamp=time.strftime('%Y%m%d-%H%M%S')
    dst=STATE_ROOT/'backups'/f'autorecover-{sid}-{stamp}'
    dst.mkdir(parents=True,exist_ok=True)
    root=Path(c['path']); rels=[
        'cstrike/server.cfg','cstrike/liblist.gam','cstrike/addons/metamod/plugins.ini',
        'cstrike/addons/amxmodx/configs/plugins.ini','cstrike/addons/amxmodx/configs/plugins-zplague.ini',
        'cstrike/addons/amxmodx/configs/disabled-zplague.ini','cstrike/addons/amxmodx/configs/modules.ini']
    for rel in rels:
        src=root/rel
        if src.is_file():
            target=dst/rel; target.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,target)
    cfgdir=root/'cstrike/addons/amxmodx/configs'
    if cfgdir.is_dir():
        for src in cfgdir.glob('plugins*.ini'):
            rel=src.relative_to(root); target=dst/rel; target.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,target)
    state=cfg_path(sid)
    if state.is_file(): shutil.copy2(state,dst/'server-state.json')
    return dst



AMXX_STOCK_PLUGINS={
    'admin.amxx','admincmd.amxx','adminhelp.amxx','slots_reservation.amxx','multilingual.amxx',
    'menufront.amxx','cmdmenu.amxx','plmenu.amxx','telemenu.amxx','mapsmenu.amxx','pluginmenu.amxx',
    'adminchat.amxx','antiflood.amxx','scrollmsg.amxx','imessage.amxx','adminvote.amxx',
    'nextmap.amxx','mapchooser.amxx','timeleft.amxx','pausecfg.amxx','statscfg.amxx',
    'statsx.amxx','miscstats.amxx','stats_logging.amxx'
}

def _plugin_name_from_line(line:str):
    s=line.strip()
    if not s or s.startswith(';'): return ''
    s=s.split(';',1)[0].strip()
    if not s: return ''
    token=s.split()[0].strip()
    return token if token.lower().endswith('.amxx') else ''

def _split_amxx_tokens(token:str):
    if not token: return []
    return re.findall(r'[A-Za-z0-9_.-]+?\.amxx',token,flags=re.I)

def _sanitize_plugin_file(path:Path, plugins_dir:Path):
    """Repair malformed AMXX plugin lists without deleting user data."""
    if not path.exists(): return {'changed':False,'split':[],'missing':[],'duplicates':[]}
    raw=path.read_text(encoding='utf-8',errors='ignore').replace('\r\n','\n').replace('\r','\n')
    out=[]; seen=set(); changed=False; split=[]; missing=[]; duplicates=[]
    for original in raw.splitlines():
        stripped=original.strip()
        if not stripped or stripped.startswith(';'):
            out.append(original)
            continue
        if stripped.startswith('//'):
            out.append('; '+stripped[2:].strip()); changed=True
            continue
        # AMXX plugin lists officially use ';' for comments. A lot of old public
        # ZM packs use C++ style // comments after a plugin name; normalize those
        # so AMXX never interprets the comment as a plugin option/token.
        active_part=re.split(r'\s*(?:;|//)',stripped,maxsplit=1)[0].strip()
        inline_comment=''
        cm=re.search(r'\s*(?:;|//)\s*(.*)$',stripped)
        if cm: inline_comment=cm.group(1).strip()
        token=active_part.split()[0] if active_part else ''
        pieces=_split_amxx_tokens(token)
        if len(pieces)<=1:
            name=pieces[0] if pieces else ''
            if not name:
                out.append(original); continue
            key=name.lower()
            if key in seen:
                duplicates.append(name); changed=True
                out.append(f'; HYPER-HOST duplicate disabled: {name}')
                continue
            seen.add(key)
            if not (plugins_dir/name).is_file():
                missing.append(name); changed=True
                out.append(f'; HYPER-HOST missing plugin disabled: {name}')
                continue
            normalized=name + ((' ; '+inline_comment) if inline_comment else '')
            out.append(normalized)
            if original!=normalized: changed=True
            continue
        changed=True; split.append(token)
        out.append(f'; HYPER-HOST repaired malformed entry: {token}')
        for name in pieces:
            key=name.lower()
            if key in seen:
                duplicates.append(name)
                out.append(f'; HYPER-HOST duplicate disabled: {name}')
                continue
            seen.add(key)
            if (plugins_dir/name).is_file():
                out.append(name)
            else:
                missing.append(name)
                out.append(f'; HYPER-HOST missing plugin disabled: {name}')
    new='\n'.join(out).rstrip()+'\n'
    if new!=raw.rstrip()+'\n': changed=True
    if changed: path.write_text(new,encoding='utf-8')
    return {'changed':changed,'split':split,'missing':missing,'duplicates':duplicates}

def _sanitize_all_plugin_lists(c:dict):
    cstrike=Path(c['path'])/'cstrike'
    cfg=cstrike/'addons/amxmodx/configs'
    plugdir=cstrike/'addons/amxmodx/plugins'
    reports=[]
    if cfg.is_dir():
        for f in sorted(cfg.glob('plugins*.ini')):
            try:
                r=_sanitize_plugin_file(f,plugdir)
                if r.get('changed'): reports.append({'file':f.name,**r})
            except Exception as exc:
                reports.append({'file':f.name,'error':str(exc)})
    return reports

def _sanitize_modules_ini(c:dict):
    p=Path(c['path'])/'cstrike/addons/amxmodx/configs/modules.ini'
    if not p.exists(): return {'changed':False,'duplicates':[]}
    raw=p.read_text(encoding='utf-8',errors='ignore').replace('\r\n','\n').replace('\r','\n')
    seen=set(); out=[]; dup=[]; changed=False
    for line in raw.splitlines():
        s=line.strip()
        if not s or s.startswith(';'):
            out.append(line); continue
        token=s.split(';',1)[0].strip().split()[0].lower() if s.split(';',1)[0].strip() else ''
        if not token:
            out.append(line); continue
        if token in seen:
            out.append('; HYPER-HOST duplicate module disabled: '+line.strip())
            dup.append(token); changed=True
        else:
            seen.add(token); out.append(line)
    new='\n'.join(out).rstrip()+'\n'
    if new!=raw.rstrip()+'\n': changed=True
    if changed: p.write_text(new,encoding='utf-8')
    return {'changed':changed,'duplicates':dup}

def _sanitize_metamod_plugins(c:dict):
    p=Path(c['path'])/'cstrike/addons/metamod/plugins.ini'
    if not p.exists(): return {'changed':False,'duplicates':[],'invalid_amxx_modules':[]}
    raw=p.read_text(encoding='utf-8',errors='ignore').replace('\r\n','\n').replace('\r','\n')
    seen=set(); out=[]; dup=[]; invalid=[]; changed=False
    for line in raw.splitlines():
        s=line.strip()
        if not s or s.startswith(';'):
            out.append(line); continue
        low=s.lower()
        if '/amxmodx/modules/' in low or re.search(r'\b(?:cstrike|csx|engine|fakemeta|fun|geoip|hamsandwich|mysql)_amxx_i386\.so\b',low):
            out.append('; HYPER-HOST invalid Metamod entry disabled: '+s)
            invalid.append(s); changed=True; continue
        key=re.sub(r'\s+',' ',low)
        if key in seen:
            out.append('; HYPER-HOST duplicate Metamod entry disabled: '+s)
            dup.append(s); changed=True; continue
        seen.add(key); out.append(line)
    new='\n'.join(out).rstrip()+'\n'
    if new!=raw.rstrip()+'\n': changed=True
    if changed: p.write_text(new,encoding='utf-8')
    return {'changed':changed,'duplicates':dup,'invalid_amxx_modules':invalid}

def _active_plugin_lists(c:dict):
    cfg=Path(c['path'])/'cstrike/addons/amxmodx/configs'
    if not cfg.is_dir(): return []
    files=[]
    main=cfg/'plugins.ini'
    if main.exists(): files.append(main)
    for f in sorted(cfg.glob('plugins-*.ini')):
        if f.name.startswith('disabled-'): continue
        files.append(f)
    return files

def _disable_plugin_in_file(path:Path, plugin:str, reason:str):
    if not path.exists(): return False
    changed=False; out=[]
    for line in path.read_text(encoding='utf-8',errors='ignore').splitlines():
        name=_plugin_name_from_line(line)
        if name.lower()==plugin.lower():
            out.append(f'; HYPER-HOST QUARANTINE [{reason}]: {name}')
            changed=True
        else:
            out.append(line)
    if changed: path.write_text('\n'.join(out).rstrip()+'\n',encoding='utf-8')
    return changed

def _quarantine_plugins(c:dict, plugins:list[str], reason:str):
    changed=[]; seen=set()
    for x in plugins:
        plugin=Path(str(x)).name
        if not plugin.lower().endswith('.amxx') or plugin.lower() in seen: continue
        seen.add(plugin.lower()); hit=False
        for f in _active_plugin_lists(c):
            if _disable_plugin_in_file(f,plugin,reason): hit=True
        if hit: changed.append(plugin)
    return changed

def _find_plugins_referencing_asset(c:dict, asset:str):
    plugdir=Path(c['path'])/'cstrike/addons/amxmodx/plugins'
    if not plugdir.is_dir(): return []
    needle=str(asset).replace('\\','/').lstrip('/').lower().encode('utf-8','ignore')
    base=Path(str(asset)).name.lower().encode('utf-8','ignore')
    hits=[]
    for f in plugdir.glob('*.amxx'):
        try:
            data=f.read_bytes().lower()
            if (needle and needle in data) or (base and len(base)>5 and base in data):
                hits.append(f.name)
        except Exception:
            pass
    return hits

def _parse_plugin_failures(log:str):
    broken=[]
    pats=[
        r'Could not load plugin\s+"([^"]+\.amxx)"',
        r'Error opening plugin file\s+\(plugin\s+"([^"]+\.amxx)"\)',
        r'Plugin file open error\s+\(plugin\s+"([^"]+\.amxx)"\)',
    ]
    for pat in pats:
        for m in re.finditer(pat,log,re.I):
            broken.append(Path(m.group(1)).name)
    assets=[]
    for m in re.finditer(r'Mod_NumForName:\s*([^\s"]+)\s+not found',log,re.I):
        assets.append(m.group(1).replace('\\','/'))
    return broken,assets

def _safe_mode_custom_plugins(c:dict, reason:str='startup crash'):
    quarantined=[]
    for f in _active_plugin_lists(c):
        out=[]; changed=False
        for line in f.read_text(encoding='utf-8',errors='ignore').splitlines():
            name=_plugin_name_from_line(line)
            if name and name.lower() not in AMXX_STOCK_PLUGINS:
                out.append(f'; HYPER-HOST SAFE MODE [{reason}]: {name}')
                quarantined.append(name); changed=True
            else:
                out.append(line)
        if changed: f.write_text('\n'.join(out).rstrip()+'\n',encoding='utf-8')
    cfg=Path(c['path'])/'cstrike/addons/amxmodx/configs'
    if cfg.is_dir():
        zplist=cfg/'plugins-zplague.ini'
        if zplist.exists():
            disabled=cfg/'disabled-zplague.ini'
            if disabled.exists(): disabled.unlink()
            zplist.rename(disabled)
    return list(dict.fromkeys(quarantined))

def repair_amxx_content(sid:int, aggressive:bool=False):
    require_root(); c=load_server(sid); path=Path(c['path'])
    if not path.is_dir(): raise RuntimeError(f'Server directory missing: {path}')
    actions=[]
    pr=_sanitize_all_plugin_lists(c)
    if pr: actions.append('repaired malformed/duplicate AMXX plugin lists')
    mr=_sanitize_modules_ini(c)
    if mr.get('changed'): actions.append('removed duplicate AMXX module entries')
    mm=_sanitize_metamod_plugins(c)
    if mm.get('changed'): actions.append('cleaned Metamod plugins.ini')
    log=_recent_failure_log(sid,180)
    broken,assets=_parse_plugin_failures(log)
    protected=set()
    if str(c.get('game_mode') or 'classic')=='zp43':
        protected={'zombie_plague40.amxx','zp50_core.amxx','zp_core.amxx'}
    q=[]
    if broken:
        safe_broken=[x for x in broken if x.lower() not in protected]
        blocked=[x for x in broken if x.lower() in protected]
        if safe_broken: q+=_quarantine_plugins(c,safe_broken,'plugin load error')
        if blocked: actions.append('protected mod core has load error: '+', '.join(blocked))
    for asset in assets:
        refs=_find_plugins_referencing_asset(c,asset)
        safe_refs=[x for x in refs if x.lower() not in protected]
        blocked=[x for x in refs if x.lower() in protected]
        if safe_refs:
            q+=_quarantine_plugins(c,safe_refs,f'missing asset {asset}')
            actions.append(f'missing resource {asset}: quarantined '+', '.join(safe_refs))
        if blocked:
            actions.append(f'missing resource {asset}: required by protected mod core '+', '.join(blocked))
        if not refs:
            actions.append(f'missing resource detected: {asset}')
    q=list(dict.fromkeys(q))
    if q: actions.append('quarantined broken plugins: '+', '.join(q))
    if aggressive and (assets or broken) and not q and not protected:
        safe=_safe_mode_custom_plugins(c,'unresolved startup crash')
        if safe:
            q+=safe; actions.append('safe mode quarantined custom plugins: '+', '.join(safe))
    normalize_permissions(path)
    report={'ok':True,'id':sid,'actions':actions,'plugin_repairs':pr,'module_repairs':mr,
            'metamod_repairs':mm,'quarantined':list(dict.fromkeys(q)),'missing_assets':assets}
    rp=STATE_ROOT/'servers'/f'{sid}.repair.json'
    try:
        rp.write_text(json.dumps(report,ensure_ascii=False,indent=2),encoding='utf-8')
        shutil.chown(rp,user='root',group='cs16'); os.chmod(rp,0o640)
    except Exception: pass
    return report

def _disable_yapb_for_recovery(c:dict):
    p=Path(c['path'])/'cstrike/addons/metamod/plugins.ini'
    changed=False
    if p.is_file():
        lines=[]
        for line in p.read_text(encoding='utf-8',errors='ignore').splitlines():
            if 'addons/yapb/bin/yapb.so' in line.lower() and not line.lstrip().startswith(';'):
                line='; HYPER-HOST auto-recovery: '+line; changed=True
            lines.append(line)
        if changed: p.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8')
    if changed:
        c['bots_enabled']=0
        try: db_update_mode(int(c['id']),str(c.get('game_mode','classic')),0,int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
        except Exception: pass
    return changed


def _disable_zp_for_recovery(c:dict):
    cfg=Path(c['path'])/'cstrike/addons/amxmodx/configs'
    enabled=cfg/'plugins-zplague.ini'; disabled=cfg/'disabled-zplague.ini'
    changed=False
    if enabled.exists():
        if disabled.exists(): disabled.unlink()
        enabled.rename(disabled); changed=True
    if str(c.get('game_mode','classic'))=='zp43':
        c['game_mode']='classic'; changed=True
        try: db_update_mode(int(c['id']),'classic',int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
        except Exception: pass
    return changed


def recover_server(sid:int, automatic:bool=False):
    """Bring a broken server back online and quarantine only content that crashes GoldSrc."""
    require_root(); c=load_server(sid); path=Path(c['path']); actions=[]
    preserve_mod=str(c.get('game_mode') or 'classic')=='zp43'
    if not path.is_dir(): raise RuntimeError(f'Server directory missing: {path}')
    backup=_recovery_backup(sid,c)
    pre=repair_amxx_content(sid,False)
    actions.extend(pre.get('actions',[]))
    safe_map=_choose_safe_map(c)
    if safe_map!=str(c.get('start_map') or ''):
        c['start_map']=safe_map; actions.append(f'fallback map -> {safe_map}')
    # Classic Metamod cannot parse the old Metamod-R config syntax.
    if str(c.get('profile','classic'))!='rehlds':
        stale=path/'cstrike/addons/metamod/config.ini'
        if stale.exists():
            stale.unlink(missing_ok=True); actions.append('removed stale Metamod-R config.ini')
    (path/'cstrike/banned.cfg').touch(exist_ok=True); (path/'cstrike/listip.cfg').touch(exist_ok=True)
    rt=load_runtime(); steam=Path(rt.get('steamcmd','/opt/steamcmd/steamcmd.sh'))
    ensure_steam_runtime(steam)
    _set_cfg_cvar(path/'cstrike/server.cfg','sv_lan','0'); save_server(c); db_update_start_map(sid,str(c['start_map'])); normalize_permissions(path)
    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
    run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
    ok,detail=wait_server_ready(c,20.0)
    if ok:
        return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),'service':'active','udp_listening':True,'detail':detail}

    # A corrupt/incompatible custom BSP can crash GoldSrc before the UDP socket opens.
    # Try the known-good stock map before touching any user's plugins.
    if str(c.get('start_map') or '')!='de_dust2' and (path/'cstrike/maps/de_dust2.bsp').is_file():
        failed_map=str(c.get('start_map') or '')
        c['start_map']='de_dust2'; actions.append(f'bad startup map {failed_map} -> de_dust2')
        save_server(c); db_update_start_map(sid,'de_dust2'); normalize_permissions(path)
        run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False); run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
        ok,detail=wait_server_ready(c,20.0)
        if ok:
            return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),'service':'active','udp_listening':True,'detail':detail,'warning':f'Map {failed_map} prevented HLDS from starting; server was restored on de_dust2'}

    # Optional third-party mods must never be able to keep the paid game service down.
    if _disable_yapb_for_recovery(c):
        actions.append('temporarily disabled YaPB after startup crash')
        save_server(c); normalize_permissions(path)
        run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False); run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
        ok,detail=wait_server_ready(c,20.0)
        if ok:
            return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),'service':'active','udp_listening':True,'detail':detail,'warning':'YaPB was disabled because it prevented HLDS from starting'}

    if not preserve_mod and _disable_zp_for_recovery(c):
        actions.append('temporarily disabled Zombie Plague after startup crash')
        if (path/'cstrike/maps/de_dust2.bsp').is_file(): c['start_map']='de_dust2'; actions.append('safe map -> de_dust2')
        _set_cfg_cvar(path/'cstrike/server.cfg','sv_lan','0'); save_server(c); db_update_start_map(sid,str(c['start_map'])); normalize_permissions(path)
        run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False); run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
        ok,detail=wait_server_ready(c,22.0)
        if ok:
            return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),'service':'active','udp_listening':True,'detail':detail,'warning':'Zombie Plague was disabled because it prevented HLDS from starting'}

    targeted=repair_amxx_content(sid,True)
    for a in targeted.get('actions',[]):
        if a not in actions: actions.append(a)
    if targeted.get('quarantined') or targeted.get('missing_assets'):
        save_server(c); normalize_permissions(path)
        run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
        run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
        ok,detail=wait_server_ready(c,25.0)
        if ok:
            return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),
                    'service':'active','udp_listening':True,'detail':detail,
                    'warning':'Broken custom AMXX content was quarantined so the game server could start.',
                    'quarantined':targeted.get('quarantined',[]),'missing_assets':targeted.get('missing_assets',[])}

    safe=[] if preserve_mod else _safe_mode_custom_plugins(c,'HLDS fatal startup crash')
    if safe:
        actions.append('last-resort AMXX safe mode: '+', '.join(safe))
        if (path/'cstrike/maps/de_dust2.bsp').is_file(): c['start_map']='de_dust2'
        save_server(c); db_update_start_map(sid,str(c['start_map'])); normalize_permissions(path)
        run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
        run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
        ok,detail=wait_server_ready(c,25.0)
        if ok:
            return {'ok':True,'id':sid,'recovered':True,'automatic':automatic,'actions':actions,'backup':str(backup),
                    'service':'active','udp_listening':True,'detail':detail,
                    'warning':'Server started in safe AMXX mode. Custom plugins were disabled, not deleted.',
                    'quarantined':safe}

    run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False)
    raise RuntimeError('HLDS could not be recovered automatically. Last journal output:\n'+_recent_failure_log(sid,160))


def service_action(sid:int,action:str):
    require_root(); c=load_server(sid)
    if action not in {'start','stop','restart'}: raise RuntimeError('Invalid action')
    if action=='stop':
        cp=run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False)
        return {'ok':cp.returncode==0,'action':'stop','service':service_status(sid),'running':False,'udp_listening':False}
    fastdl_info={}; fastdl_warning=''
    try:
        fastdl_info=fastdl_sync(sid,True)
        c=load_server(sid)
    except Exception as exc:
        fastdl_warning='FastDL sync failed: '+str(exc)
    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
    cp=run(['systemctl',action,f'hyper-cs16@{sid}.service'],check=False)
    if cp.returncode!=0:
        return {'ok':False,'action':action,'service':service_status(sid),'error':(cp.stdout or '').strip() or 'systemd command failed'}
    ok,detail=wait_server_ready(c,25.0)
    if ok:
        result={'ok':True,'action':action,'service':'active','running':True,'udp_listening':True,'detail':detail,'recovered':False,'fastdl':fastdl_info}
        if fastdl_warning: result['warning']=fastdl_warning
        return result
    result=recover_server(sid,False)
    result['action']=action; result['initial_failure']=str(detail); result['fastdl']=fastdl_info
    if fastdl_warning: result['warning']=(str(result.get('warning') or '')+' '+fastdl_warning).strip()
    return result


def service_status(sid:int):
    cp=run(['systemctl','is-active',f'hyper-cs16@{sid}.service'],check=False)
    return (cp.stdout or '').strip() or 'unknown'


def get_pid(sid:int):
    cp=run(['systemctl','show',f'hyper-cs16@{sid}.service','-p','MainPID','--value'],check=False)
    try: return int((cp.stdout or '0').strip())
    except: return 0


def proc_metrics(pid:int):
    if pid<=0: return {'cpu_percent':0.0,'memory_mb':0.0,'uptime_seconds':0}
    cp=run(['ps','-p',str(pid),'-o','%cpu=,rss=,etimes='],check=False)
    parts=(cp.stdout or '').split()
    if len(parts)<3: return {'cpu_percent':0.0,'memory_mb':0.0,'uptime_seconds':0}
    try: return {'cpu_percent':float(parts[0]),'memory_mb':round(float(parts[1])/1024,2),'uptime_seconds':int(float(parts[2]))}
    except: return {'cpu_percent':0.0,'memory_mb':0.0,'uptime_seconds':0}


def disk_mb(path:Path):
    cp=run(['du','-sm',str(path)],check=False); 
    try: return float((cp.stdout or '0').split()[0])
    except: return 0.0


def query_host(c): return '127.0.0.1'

def rcon_current_map(c):
    try:
        raw=query_rcon(query_host(c),int(c['port']),str(c.get('rcon_password','')),'status',2.2)
    except Exception:
        return '', ''
    m=re.search(r'(?mi)^\s*map\s*:\s*([A-Za-z0-9_-]+)',raw)
    return (m.group(1) if m else ''), raw

def rcon_status_players(c):
    try:
        raw=query_rcon(query_host(c),int(c['port']),str(c.get('rcon_password','')),'status',2.0)
    except Exception:
        return []
    rows=[]
    rx=re.compile(r'^\s*#\s*(\d+)\s+\"(.*?)\"\s+(\d+)\s+(\S+)\s+(-?\d+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(.*)$')
    rx_short=re.compile(r'^\s*#\s*(\d+)\s+\"(.*?)\"\s+(\d+)\s+(\S+)(?:\s+(.*))?$')
    for line in raw.splitlines():
        m=rx.match(line)
        if m:
            rows.append({'slot':int(m.group(1)),'name':m.group(2),'userid':int(m.group(3)),'steam_id':m.group(4),'score':int(m.group(5)),'time':m.group(6),'ping':int(m.group(7)),'loss':int(m.group(8)),'address':m.group(9).strip()})
            continue
        m=rx_short.match(line)
        if m:
            rows.append({'slot':int(m.group(1)),'name':m.group(2),'userid':int(m.group(3)),'steam_id':m.group(4),'raw':m.group(5) or ''})
    return rows

def status_json(sid:int,include_players=True):
    c=load_server(sid); svc=service_status(sid); pid=actual_hlds_pid(sid); pm=proc_metrics(pid); path=Path(c['path']); port=int(c['port'])
    running=pid>0 and svc=='active'; udp=udp_listening(port) if running else False
    data={'ok':True,'id':sid,'service':svc,'running':running,'udp_listening':udp,'pid':pid,'cpu_percent':pm['cpu_percent'],'memory_mb':pm['memory_mb'],
          'uptime_seconds':pm['uptime_seconds'],'disk_mb':disk_mb(path),'port':port,'slots':c['slots'],'hostname':c['hostname'],
          'public_ip':c.get('public_ip',''),'start_map':c['start_map'],'profile':c.get('profile','classic'),'ftp_user':c.get('ftp_user',''),
          'ftp_password':c.get('ftp_password',''),'query':None,'query_ok':False,'query_state':'offline','players':[],'query_error':''}
    if running and udp:
        qi,qerr=query_info_retry(port,2)
        if qi:
            data['query']=qi; data['query_ok']=True; data['query_state']='ok'
            if include_players:
                a2s=[]
                try: a2s=query_players(query_host(c),port,1.5)
                except Exception as exc: data['players_error']=str(exc)
                status_rows=rcon_status_players(c)
                by_name={}
                for r in status_rows: by_name.setdefault(r.get('name',''),[]).append(r)
                merged=[]
                for p in a2s:
                    row=dict(p); candidates=by_name.get(p.get('name',''),[])
                    if candidates: row.update(candidates.pop(0))
                    merged.append(row)
                used={(x.get('name',''),x.get('userid')) for x in merged}
                for r in status_rows:
                    if (r.get('name',''),r.get('userid')) not in used: merged.append(r)
                data['players']=merged
        else:
            # Do not call a healthy UDP server dead only because A2S dropped a packet.
            data['query_state']='retrying'; data['query_error']=qerr
            if include_players:
                data['players']=rcon_status_players(c)
    elif running:
        data['query_state']='no_udp'; data['query_error']=f'UDP {port} is not listening'
    elif svc in {'active','activating','failed'}:
        data['query_state']='engine_down'; data['query_error']='hlds_linux is not running'
    rp=STATE_ROOT/'servers'/f'{sid}.repair.json'
    if rp.is_file():
        try:
            rr=json.loads(rp.read_text(encoding='utf-8'))
            data['repair_report']=rr if isinstance(rr,dict) else {}
        except Exception:
            data['repair_report']={}
    else:
        data['repair_report']={}
    return data

def rcon_cmd(sid:int,command:str):
    c=load_server(sid)
    if not command or len(command)>512 or '\n' in command or '\r' in command: raise RuntimeError('Invalid RCON command')
    text=query_rcon(query_host(c),int(c['port']),str(c.get('rcon_password','')),command,2.5)
    return {'ok':True,'output':text}


def base_map_list():
    rt=load_runtime(); d=Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds'))/'cstrike/maps'
    maps=sorted({p.stem for p in d.glob('*.bsp') if SAFE_MAP.fullmatch(p.stem)},key=str.lower) if d.is_dir() else []
    return {'ok':True,'maps':maps}


def map_list(sid:int):
    c=load_server(sid); d=Path(c['path'])/'cstrike/maps'
    maps=sorted({p.stem for p in d.glob('*.bsp') if SAFE_MAP.fullmatch(p.stem)},key=str.lower) if d.is_dir() else []
    current=str(c.get('start_map') or '')
    if service_status(sid)=='active' and udp_listening(int(c['port'])):
        rmap,_=rcon_current_map(c)
        if rmap:
            current=rmap
        else:
            qi,_=query_info_retry(int(c['port']),1)
            if qi: current=str(qi.get('map') or current)
    return {'ok':True,'maps':maps,'current_map':current,'start_map':str(c.get('start_map') or '')}


def _persist_start_map(c:dict,map_name:str):
    # Changing a map must never overwrite the user's server.cfg. The map is a
    # launch/runtime property stored in state JSON + SQL and applied via RCON.
    c['start_map']=map_name
    save_server(c)
    db_update_start_map(int(c['id']),map_name)


def _verify_map_live(c:dict,map_name:str,timeout:float=18.0):
    deadline=time.time()+timeout; last=''; last_q={}
    while time.time()<deadline:
        if service_status(int(c['id']))!='active' or not udp_listening(int(c['port'])):
            last='engine/UDP not ready'; time.sleep(.6); continue
        rmap,_=rcon_current_map(c)
        if rmap==map_name: return True,{'verified_by':'rcon','query':last_q}
        qi,qerr=query_info_retry(int(c['port']),1)
        if qi:
            last_q=qi
            if str(qi.get('map') or '')==map_name: return True,{'verified_by':'a2s','query':qi}
            last=f'current map is {qi.get("map") or "unknown"}'
        elif qerr: last=qerr
        time.sleep(1.0)
    return False, last or 'map verification timeout'


def activate_map(sid:int,map_name:str):
    require_root(); c=load_server(sid)
    if not SAFE_MAP.fullmatch(map_name): raise RuntimeError('Invalid map')
    bsp=Path(c['path'])/'cstrike/maps'/(map_name+'.bsp')
    if not bsp.is_file(): raise RuntimeError(f'Map is not installed on this server: {map_name}')

    old_map=str(c.get('start_map') or '')
    if old_map==map_name and service_status(sid)=='active' and udp_listening(int(c['port'])):
        live,_=rcon_current_map(c)
        if live==map_name:
            db_update_current_map(sid,map_name)
            return {'ok':True,'map':map_name,'current_map':map_name,'mode':'already_active','service':'active','verified_by':'rcon'}

    # Healthy server: change live map first. Persist only after the engine confirms it.
    if service_status(sid)=='active' and udp_listening(int(c['port'])):
        try:
            output=query_rcon(query_host(c),int(c['port']),str(c.get('rcon_password','')),'changelevel '+map_name,3.0)
            ok,detail=_verify_map_live(c,map_name,20.0)
            if ok:
                _persist_start_map(c,map_name); db_update_current_map(sid,map_name)
                return {'ok':True,'map':map_name,'current_map':map_name,'mode':'changelevel','service':'active','output':output,**detail}
        except Exception as exc:
            detail='RCON changelevel failed: '+str(exc)
    else:
        detail='server was not healthy before map change'

    # Start/restart on the requested map. If it crashes, roll back automatically so a
    # bad map/mod combination can never leave the whole server at Process ON / UDP OFF.
    _persist_start_map(c,map_name)
    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
    run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False)
    ok,ready=wait_server_ready(c,25.0)
    if ok:
        vm,vdetail=_verify_map_live(c,map_name,12.0)
        if vm:
            db_update_current_map(sid,map_name)
            return {'ok':True,'map':map_name,'current_map':map_name,'mode':'restart','service':'active',**vdetail}

    rollback=old_map if old_map and (Path(c['path'])/'cstrike/maps'/(old_map+'.bsp')).is_file() else _choose_safe_map(c)
    c['start_map']=rollback
    _persist_start_map(c,rollback)
    recovery=recover_server(sid,False)
    raise RuntimeError(f'Map {map_name} could not be started safely. Server was automatically restored on {rollback}. Reason: {detail}; recovery actions: {", ".join(recovery.get("actions",[])) or "safe restart"}')

def plugins_list(sid:int):
    """Return only AMXX plugin files that physically exist on this server.

    AMXX can load plugins.ini plus plugins-*.ini, so enabled state is derived from
    all active plugin lists that are actually present. Historical config entries
    pointing to deleted files are diagnostics only and never rendered as installed.
    """
    c=load_server(sid); root=Path(c['path'])/'cstrike/addons/amxmodx'; cfgdir=root/'configs'; plugdir=root/'plugins'
    configured_enabled=[]; configured_disabled=[]; raw=[]; source_by_name={}
    cfg_files=[]
    main=cfgdir/'plugins.ini'
    if main.is_file(): cfg_files.append(main)
    if cfgdir.is_dir():
        cfg_files.extend(sorted([x for x in cfgdir.glob('plugins-*.ini') if x.is_file()],key=lambda x:x.name.lower()))
    seen_cfg=set()
    for pin in cfg_files:
        rp=str(pin.resolve())
        if rp in seen_cfg: continue
        seen_cfg.add(rp)
        text=pin.read_text(encoding='utf-8',errors='ignore')
        for line in text.splitlines():
            stripped=line.strip()
            if not stripped: continue
            active=not stripped.startswith(';')
            body=stripped.lstrip(';').strip()
            token=body.split(';',1)[0].strip().split()[0] if body else ''
            if token.lower().endswith('.amxx'):
                (configured_enabled if active else configured_disabled).append(token)
                if active: source_by_name.setdefault(token.lower(),[]).append(pin.name)
            raw.append(f'[{pin.name}] {line}')
    actual={}
    if plugdir.is_dir():
        for fp in sorted(plugdir.glob('*.amxx'),key=lambda x:x.name.lower()):
            if not fp.is_file(): continue
            try: st=fp.stat()
            except OSError: continue
            actual[fp.name.lower()]={'name':fp.name,'size':int(st.st_size),'mtime':int(st.st_mtime)}
    enabled_keys={x.lower() for x in configured_enabled}
    installed=[]; enabled=[]; disabled=[]
    for key,item in actual.items():
        is_enabled=key in enabled_keys
        item={**item,'enabled':is_enabled,'stock':key in AMXX_STOCK_PLUGINS,'config_sources':source_by_name.get(key,[])}
        installed.append(item)
        (enabled if is_enabled else disabled).append(item['name'])
    missing=[]; missing_seen=set()
    for x in configured_enabled+configured_disabled:
        k=x.lower()
        if k not in actual and k not in missing_seen:
            missing.append(x); missing_seen.add(k)
    return {'ok':True,'enabled':enabled,'disabled':disabled,'files':[x['name'] for x in installed],
            'installed':installed,'installed_count':len(installed),'missing_config_entries':missing,'plugin_config_files':[x.name for x in cfg_files],'plugins_ini':raw}


def plugin_toggle(sid:int,name:str,enable:bool):
    require_root()
    if not SAFE_PLUGIN.fullmatch(name) or not name.endswith('.amxx'): raise RuntimeError('Invalid plugin name')
    c=load_server(sid); root=Path(c['path'])/'cstrike/addons/amxmodx'; plugfile=root/'plugins'/name
    if not plugfile.is_file(): raise RuntimeError(f'AMXX plugin is not installed on this server: {name}')
    cfgdir=root/'configs'; cfgdir.mkdir(parents=True,exist_ok=True)
    cfg_files=[]; main=cfgdir/'plugins.ini'
    if main.exists(): cfg_files.append(main)
    cfg_files.extend(sorted([x for x in cfgdir.glob('plugins-*.ini') if x.is_file()],key=lambda x:x.name.lower()))
    found_any=False; changed_files=[]
    lname=name.lower()
    for pin in cfg_files:
        lines=pin.read_text(encoding='utf-8',errors='ignore').splitlines(); out_lines=[]; changed=False
        for line in lines:
            stripped=line.strip(); body=stripped.lstrip(';').strip()
            token=body.split(';',1)[0].strip().split()[0] if body else ''
            if token.lower()==lname:
                found_any=True
                desired=name if enable else ';'+name
                # Keep trailing comment, if any, only when it is a real comment after the token.
                tail=''
                body_no_prefix=stripped.lstrip(';').strip()
                if ';' in body_no_prefix:
                    _,comment=body_no_prefix.split(';',1); tail=' ;'+comment.strip() if comment.strip() else ''
                newline=desired+tail
                if newline!=line.strip(): changed=True
                out_lines.append(newline)
            else:
                out_lines.append(line)
        if changed:
            pin.write_text('\n'.join(out_lines).rstrip()+'\n',encoding='utf-8'); changed_files.append(pin.name)
    if not found_any:
        lines=main.read_text(encoding='utf-8',errors='ignore').splitlines() if main.exists() else []
        lines.append(name if enable else ';'+name)
        main.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8'); changed_files.append(main.name)
    normalize_permissions(Path(c['path']))
    return {'ok':True,'plugin':name,'enabled':enable,'config_files':changed_files,'installed':True}


ALLOWED_CONFIGS={
 'server.cfg':'cstrike/server.cfg',
 'amxx.cfg':'cstrike/addons/amxmodx/configs/amxx.cfg',
 'users.ini':'cstrike/addons/amxmodx/configs/users.ini',
 'plugins.ini':'cstrike/addons/amxmodx/configs/plugins.ini',
 'modules.ini':'cstrike/addons/amxmodx/configs/modules.ini',
 'mapcycle.txt':'cstrike/mapcycle.txt',
 'maps.ini':'cstrike/addons/amxmodx/configs/maps.ini',
}

def config_file(sid:int,name:str):
    if name not in ALLOWED_CONFIGS: raise RuntimeError('Config file is not allowed')
    c=load_server(sid); root=Path(c['path']).resolve(); p=(root/ALLOWED_CONFIGS[name]).resolve()
    if root not in p.parents: raise RuntimeError('Unsafe config path')
    return c,p

def config_read(sid:int,name:str):
    _,p=config_file(sid,name); return {'ok':True,'name':name,'content':p.read_text(encoding='utf-8',errors='ignore') if p.exists() else ''}

def config_write(sid:int,name:str,content:str):
    require_root(); c,p=config_file(sid,name)
    if len(content.encode('utf-8'))>512*1024: raise RuntimeError('Config is too large')
    p.parent.mkdir(parents=True,exist_ok=True); p.write_text(content.replace('\r\n','\n'),encoding='utf-8')
    repairs={}
    if name=='plugins.ini':
        repairs=_sanitize_plugin_file(p,Path(c['path'])/'cstrike/addons/amxmodx/plugins')
    elif name=='modules.ini':
        repairs=_sanitize_modules_ini(c)
    fastdl={}
    if name=='server.cfg':
        fastdl=fastdl_sync(sid,True)
        c=load_server(sid)
    normalize_permissions(Path(c['path']))
    return {'ok':True,'name':name,'repairs':repairs,'fastdl':fastdl}



AMXX_ACCESS_LABELS={
 'a':'Иммунитет','b':'Резервный слот','c':'Kick','d':'Ban','e':'Slay / Slap','f':'Смена карты',
 'g':'CVAR','h':'Конфиги','i':'Чат','j':'Голосования','k':'sv_password','l':'RCON',
 'm':'Custom A','n':'Custom B','o':'Custom C','p':'Custom D','q':'Custom E','r':'Custom F',
 's':'Custom G','t':'Custom H','u':'AMXX меню'
}
AMXX_ALLOWED_ACCESS=set(AMXX_ACCESS_LABELS)
AMXX_USER_RE=re.compile(r'^\s*"([^"]*)"\s+"([^"]*)"\s+"([a-z]*)"\s+"([a-z]*)"\s*(?:;.*)?$',re.I)
STEAM_ID_RE=re.compile(r'^(?:STEAM|VALVE)_[0-9]+:[0-9]+:[0-9]+$',re.I)


def _amxx_users_path(sid:int):
    c=load_server(sid)
    root=Path(c['path']).resolve()
    p=(root/'cstrike/addons/amxmodx/configs/users.ini').resolve()
    if root not in p.parents: raise RuntimeError('Unsafe users.ini path')
    p.parent.mkdir(parents=True,exist_ok=True)
    return c,p


def _parse_amxx_admins(lines):
    rows=[]
    for line_index,line in enumerate(lines):
        m=AMXX_USER_RE.match(line)
        if not m: continue
        identity,password,access,auth=m.groups()
        auth_l=auth.lower()
        if 'c' in auth_l: auth_type='steamid'
        elif 'd' in auth_l: auth_type='ip'
        else: auth_type='name'
        rows.append({
            'index':line_index,'identity':identity,'access_flags':access.lower(),'auth_flags':auth_l,
            'auth_type':auth_type,'has_password':bool(password),'access_labels':[AMXX_ACCESS_LABELS.get(x,x) for x in access.lower() if x in AMXX_ACCESS_LABELS]
        })
    return rows


def admin_list(sid:int):
    _,p=_amxx_users_path(sid)
    lines=p.read_text(encoding='utf-8',errors='ignore').splitlines() if p.exists() else []
    return {'ok':True,'admins':_parse_amxx_admins(lines),'password_field':'_pw','users_ini':str(p)}


def _validate_admin_identity(identity:str,auth_type:str):
    identity=identity.strip()
    if not identity or len(identity)>96 or any(ch in identity for ch in ['"','\r','\n']):
        raise RuntimeError('Некорректный идентификатор администратора')
    if auth_type=='steamid':
        if not STEAM_ID_RE.fullmatch(identity): raise RuntimeError('Для SteamID нужен формат STEAM_0:1:123456')
        return identity.upper()
    if auth_type=='ip':
        try: return str(ipaddress.ip_address(identity))
        except ValueError: raise RuntimeError('Некорректный IP администратора')
    if auth_type=='name':
        if len(identity)>64: raise RuntimeError('Ник администратора слишком длинный')
        return identity
    raise RuntimeError('Неизвестный тип авторизации')


def _normalize_access_flags(flags:str):
    flags=''.join(dict.fromkeys((flags or '').lower()))
    bad=[x for x in flags if x not in AMXX_ALLOWED_ACCESS]
    if bad: raise RuntimeError('Недопустимые AMXX права: '+''.join(bad))
    if not flags: raise RuntimeError('Выбери хотя бы одно право администратора')
    return ''.join(x for x in 'abcdefghijklmnopqrstu' if x in flags)


def _ensure_password_field(root:Path):
    p=root/'cstrike/addons/amxmodx/configs/amxx.cfg'
    p.parent.mkdir(parents=True,exist_ok=True)
    text=p.read_text(encoding='utf-8',errors='ignore') if p.exists() else ''
    rx=re.compile(r'^\s*amx_password_field\s+.*$',re.I|re.M)
    line='amx_password_field "_pw"'
    if rx.search(text): text=rx.sub(line,text,1)
    else: text=text.rstrip()+('\n\n' if text.strip() else '')+line+'\n'
    p.write_text(text,encoding='utf-8')


def _reload_amxx_admins(c):
    try:
        r=rcon_cmd(int(c['id']),'amx_reloadadmins')
        return {'ok':bool(r.get('ok')),'output':str(r.get('output',''))[-1000:]}
    except Exception as exc:
        return {'ok':False,'error':str(exc)}


def admin_save(sid:int,payload:dict):
    require_root(); c,p=_amxx_users_path(sid)
    auth_type=str(payload.get('auth_type','steamid')).lower()
    identity=_validate_admin_identity(str(payload.get('identity','')),auth_type)
    access=_normalize_access_flags(str(payload.get('access_flags','')))
    try: edit_index=int(payload.get('index',-1))
    except Exception: edit_index=-1
    password=str(payload.get('password',''))
    generate=bool(payload.get('generate_password',False))
    if any(ch in password for ch in ['"','\r','\n']) or len(password)>96: raise RuntimeError('Некорректный пароль администратора')
    lines=p.read_text(encoding='utf-8',errors='ignore').splitlines() if p.exists() else []
    existing_password=''
    if edit_index>=0:
        if edit_index>=len(lines): raise RuntimeError('Запись администратора уже изменилась. Обнови список.')
        m=AMXX_USER_RE.match(lines[edit_index])
        if not m: raise RuntimeError('Выбранная строка users.ini больше не является администратором')
        existing_password=m.group(2)
    password_changed=generate or password!=''
    if generate: password=secrets.token_urlsafe(12).replace('-','A').replace('_','B')[:16]
    elif password=='': password=existing_password
    if auth_type=='name' and not password:
        raise RuntimeError('Для авторизации по нику обязательно задай пароль')
    if auth_type=='steamid': auth_flags='ca' if password else 'ce'
    elif auth_type=='ip': auth_flags='da' if password else 'de'
    else: auth_flags='a'
    entry=f'"{identity}" "{password}" "{access}" "{auth_flags}"'
    # Prevent accidental duplicate identities; editing its own row is allowed.
    for row in _parse_amxx_admins(lines):
        if row['index']!=edit_index and row['identity'].casefold()==identity.casefold():
            raise RuntimeError(f'Администратор {identity} уже существует')
    if edit_index>=0: lines[edit_index]=entry
    else:
        if lines and lines[-1].strip(): lines.append('')
        lines.append(entry); edit_index=len(lines)-1
    p.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8')
    root=Path(c['path'])
    if password: _ensure_password_field(root)
    normalize_permissions(root)
    reload=_reload_amxx_admins(c)
    return {
        'ok':True,'index':edit_index,'identity':identity,'auth_type':auth_type,'access_flags':access,
        'has_password':bool(password),'generated_password':password if generate else '',
        'client_command':f'setinfo _pw "{password}"' if password and password_changed else '',
        'reload':reload
    }


def admin_delete(sid:int,index:int):
    require_root(); c,p=_amxx_users_path(sid)
    lines=p.read_text(encoding='utf-8',errors='ignore').splitlines() if p.exists() else []
    if index<0 or index>=len(lines) or not AMXX_USER_RE.match(lines[index]): raise RuntimeError('Администратор не найден')
    removed=AMXX_USER_RE.match(lines[index]).group(1)
    del lines[index]
    # Avoid accumulating multiple blank lines but preserve comments/manual entries.
    cleaned=[]
    for line in lines:
        if not line.strip() and cleaned and not cleaned[-1].strip(): continue
        cleaned.append(line)
    p.write_text('\n'.join(cleaned).rstrip()+'\n',encoding='utf-8')
    normalize_permissions(Path(c['path']))
    reload=_reload_amxx_admins(c)
    return {'ok':True,'removed':removed,'reload':reload}

def server_config_set(args):
    require_root(); c=load_server(args.id)
    if args.port is not None:
        if not 27015<=args.port<=27100: raise RuntimeError('port 27015..27100')
        old_port=int(c.get('port',0) or 0)
        if args.port!=old_port and not port_available(args.port,args.id): raise RuntimeError(f'Port {args.port} is already used')
        c['port']=args.port
    if args.slots is not None:
        if not 1<=args.slots<=32: raise RuntimeError('slots 1..32')
        c['slots']=args.slots
    if args.map is not None:
        if not SAFE_MAP.fullmatch(args.map): raise RuntimeError('invalid map')
        if not (Path(c['path'])/'cstrike/maps'/(args.map+'.bsp')).is_file(): raise RuntimeError('map is not installed on this server')
        c['start_map']=args.map
    if args.hostname is not None:
        if not args.hostname or len(args.hostname)>160: raise RuntimeError('invalid hostname')
        c['hostname']=args.hostname
    if args.password is not None: c['server_password']=args.password[:64]
    if args.rcon is not None and args.rcon!='': c['rcon_password']=args.rcon[:96]
    root=Path(c['path']); cfg=root/'cstrike/server.cfg'
    if not cfg.exists():
        write_server_cfg(root,c)
    else:
        # Never destroy a ready-made build's server.cfg just because the user
        # changed hostname/port/slots/map in the panel. Patch only managed values.
        _set_cfg_cvar(cfg,'hostname','"'+_clean_cfg_value(str(c.get('hostname') or ''),160)+'"')
        _set_cfg_cvar(cfg,'sv_password','"'+_clean_cfg_value(str(c.get('server_password') or ''),64)+'"')
        if args.rcon is not None and args.rcon!='':
            _set_cfg_cvar(cfg,'rcon_password','"'+_clean_cfg_value(str(c.get('rcon_password') or ''),96)+'"')
        elif not _cfg_has_directive(cfg,'rcon_password'):
            _set_cfg_cvar(cfg,'rcon_password','"'+_clean_cfg_value(str(c.get('rcon_password') or ''),96)+'"')
        _set_cfg_cvar(cfg,'sv_lan','0')
    save_server(c); db_update_identity(args.id,str(c.get('hostname') or '')); db_update_start_map(args.id,str(c.get('start_map') or 'de_dust2')); normalize_permissions(root)
    fastdl=fastdl_sync(args.id,True)
    return {'ok':True,'server':{k:c.get(k) for k in ['id','hostname','slots','start_map','server_password']},'config_preserved':True,'fastdl':fastdl}



def server_limits_set(sid:int,cpu:float=0,memory:int=0):
    """v2.7 compatibility command: remove all CPU/RAM restrictions.

    The panel no longer enforces per-server resource quotas. The arguments are
    accepted only so old API/UI calls do not fail during an upgrade.
    """
    require_root(); load_server(sid)
    drop=Path(f'/etc/systemd/system/hyper-cs16@{sid}.service.d')
    limits=drop/'limits.conf'
    try: limits.unlink()
    except FileNotFoundError: pass
    except OSError as exc: raise RuntimeError(f'Cannot remove legacy systemd limits: {exc}')
    try:
        if drop.is_dir() and not any(drop.iterdir()): drop.rmdir()
    except OSError: pass
    run(['systemctl','daemon-reload'],check=False)
    unit=f'hyper-cs16@{sid}.service'
    if service_status(sid)=='active':
        run(['systemctl','set-property','--runtime',unit,'CPUQuota=infinity','MemoryMax=infinity'],check=False,timeout=30)
    return {'ok':True,'id':sid,'unlimited':True,'cpu_limit_percent':0,'memory_limit_mb':0}


def logs(sid:int,lines:int=160):
    load_server(sid); lines=max(10,min(lines,1000))
    cp=run(['journalctl','-u',f'hyper-cs16@{sid}.service','-n',str(lines),'--no-pager','-o','short-iso'],check=False)
    return {'ok':True,'output':(cp.stdout or '')[-200000:]}


def server_update(sid:int):
    """Update Steam/engine files without wiping a custom build or its AMXX config."""
    require_root(); c=load_server(sid); path=Path(c['path']); rt=load_runtime(); steam=rt.get('steamcmd','/opt/steamcmd/steamcmd.sh')
    keep=STATE_ROOT/'update-backups'/f'{sid}-{int(time.time())}-{secrets.token_hex(4)}'
    keep.mkdir(parents=True,exist_ok=True)
    preserve=['cstrike/server.cfg','cstrike/liblist.gam','cstrike/addons']
    for rel in preserve:
        src=path/rel
        if src.exists():
            dst=keep/rel; dst.parent.mkdir(parents=True,exist_ok=True)
            if src.is_dir(): shutil.copytree(src,dst,dirs_exist_ok=True)
            else: shutil.copy2(src,dst)
    run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False)
    cmd=[steam,'+force_install_dir',str(path),'+login','anonymous','+app_set_config','90','mod','cstrike','+app_update','90','-beta','steam_legacy','validate','+quit']
    result=run_as_cs16(cmd,check=False,timeout=1800)
    if result.returncode!=0:
        run(['systemctl','start',f'hyper-cs16@{sid}.service'],check=False)
        raise RuntimeError((result.stdout or '')[-5000:])
    if c.get('profile')=='rehlds': install_rehlds(path)
    # Restore the exact custom mod/config tree after Steam validation. Steam update
    # is an engine update, not permission to replace the user's build.
    for rel in preserve:
        src=keep/rel; dst=path/rel
        if not src.exists(): continue
        if src.is_dir():
            if dst.exists(): shutil.rmtree(dst)
            shutil.copytree(src,dst)
        else:
            dst.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,dst)
    ensure_steam_runtime(Path(steam)); normalize_permissions(path)
    fastdl=fastdl_sync(sid,True); c=load_server(sid)
    ok,detail=_restart_strict(sid,c,45.0)
    if not ok:
        journal=_recent_failure_log(sid,160)
        raise RuntimeError(f'Steam update finished, but the preserved build did not restart: {detail}. {journal[-6000:]}')
    try: shutil.rmtree(keep)
    except OSError: pass
    return {'ok':True,'output':(result.stdout or '')[-4000:],'custom_build_preserved':True,'query':detail,'fastdl':fastdl}


def server_reinstall(sid:int):
    """True clean reinstall. Old custom mods/plugins stay only in backup.

    Preserve AMXX administrators (users.ini) because they are panel access data,
    but do not restore plugins.ini, .amxx files, YaPB or Zombie content. The UI
    therefore immediately shows only plugins that really exist in the fresh tree.
    """
    require_root(); c=load_server(sid); path=Path(c['path']); backup=APP_ROOT/'backups'/f'server-{sid}-{int(time.time())}'
    backup.parent.mkdir(parents=True,exist_ok=True); run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False)
    if path.exists():
        backup.mkdir(parents=True,exist_ok=True)
        # Keep a complete copy for manual rollback/troubleshooting.
        run(['rsync','-a',str(path)+'/',str(backup)+'/'],timeout=1200)
        shutil.rmtree(path)
    base=Path(load_runtime().get('base_game_dir','/srv/hyper-cs16/base-hlds')); ensure_base('classic'); run(['rsync','-a',str(base)+'/',str(path)+'/'],timeout=600)
    if c.get('profile')=='rehlds': install_rehlds(path)
    # Preserve only AMXX admin identities, not old mods/plugins.
    old_users=backup/'cstrike/addons/amxmodx/configs/users.ini'
    if old_users.exists():
        dst=path/'cstrike/addons/amxmodx/configs/users.ini'; dst.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(old_users,dst)
    c['game_mode']='classic'; c['bots_enabled']=0; c.pop('custom_build_source',None); c.pop('custom_build_installed_at',None); save_server(c)
    db_update_mode(sid,'classic',0,0,int(c.get('bots_difficulty',3)))
    write_server_cfg(path,c)
    sql_warning=''
    try:
        sql_info=sql_provision(sid)
    except Exception as exc:
        sql_info={'ok':False,'error':str(exc)}; sql_warning='Automatic SQL setup failed: '+str(exc)
    normalize_permissions(path); fastdl=fastdl_sync(sid,True); c=load_server(sid); run(['systemctl','start',f'hyper-cs16@{sid}.service'],check=False)
    ok,detail=wait_server_ready(c,45.0)
    if not ok:
        journal=_recent_failure_log(sid,120)
        raise RuntimeError(f'Clean reinstall completed but HLDS did not become ready: {detail}. {journal[-5000:]}')
    return {'ok':True,'backup':str(backup),'clean':True,'plugins':plugins_list(sid),'query':detail,'sql':sql_info,'sql_warning':sql_warning,'fastdl':fastdl}


def ftp_reset(sid:int):
    require_root(); c=load_server(sid); pw=secrets.token_urlsafe(12)
    user, pw, warning = setup_ftp(c,Path(c['path']),pw)
    c['ftp_password']=pw; c['ftp_user']=user; save_server(c); db_update_ftp(sid,user,pw); time.sleep(.4)
    test=ftp_test(sid) if not warning else {'ok':False,'error':warning}
    return {'ok':bool(test.get('ok')),'ftp_user':user,'ftp_password':pw,'warning':warning,'test':test}


def _staged_open(token:str, expected_suffix:str, max_bytes:int):
    require_root()
    if not SAFE_STAGE.fullmatch(token) or not token.endswith(expected_suffix): raise RuntimeError('Invalid upload token')
    STAGING_DIR.mkdir(parents=True,exist_ok=True)
    src=STAGING_DIR/token
    st=os.lstat(src)
    if not stat.S_ISREG(st.st_mode): raise RuntimeError('Staged upload is not a regular file')
    try: web_uid=pwd.getpwnam('www-data').pw_uid
    except KeyError: raise RuntimeError('www-data user not found')
    if st.st_uid!=web_uid: raise RuntimeError('Staged upload has invalid owner')
    if st.st_size<1 or st.st_size>max_bytes: raise RuntimeError('Uploaded file size is invalid')
    flags=os.O_RDONLY | getattr(os,'O_NOFOLLOW',0) | getattr(os,'O_CLOEXEC',0)
    fd=os.open(src,flags)
    fst=os.fstat(fd)
    if not stat.S_ISREG(fst.st_mode) or fst.st_uid!=web_uid or fst.st_ino!=st.st_ino or fst.st_dev!=st.st_dev:
        os.close(fd); raise RuntimeError('Staged upload changed during validation')
    return src,fd


def _copy_staged(token:str, expected_suffix:str, dst:Path, max_bytes:int):
    src,fd=_staged_open(token,expected_suffix,max_bytes)
    try:
        dst.parent.mkdir(parents=True,exist_ok=True)
        tmp=dst.with_name('.'+dst.name+'.upload-'+secrets.token_hex(6))
        with os.fdopen(fd,'rb',closefd=True) as rf, open(tmp,'xb') as wf:
            shutil.copyfileobj(rf,wf,1024*1024)
            wf.flush(); os.fsync(wf.fileno())
        os.replace(tmp,dst)
    finally:
        try: src.unlink()
        except FileNotFoundError: pass
    return dst


def map_upload(sid:int,token:str,map_name:str):
    require_root(); c=load_server(sid)
    if not SAFE_MAP.fullmatch(map_name): raise RuntimeError('Invalid map name')
    dst=Path(c['path'])/'cstrike/maps'/(map_name+'.bsp')
    _copy_staged(token,'.bsp',dst,256*1024*1024); normalize_permissions(Path(c['path']))
    fastdl=fastdl_sync(sid,True)
    return {'ok':True,'map':map_name,'fastdl':fastdl}


def plugin_upload(sid:int,token:str,plugin_name:str):
    require_root(); c=load_server(sid)
    if not SAFE_PLUGIN.fullmatch(plugin_name) or not plugin_name.endswith('.amxx'): raise RuntimeError('Invalid plugin name')
    dst=Path(c['path'])/'cstrike/addons/amxmodx/plugins'/plugin_name
    _copy_staged(token,'.amxx',dst,32*1024*1024); normalize_permissions(Path(c['path']))
    return {'ok':True,'plugin':plugin_name}




def _build_take_staged(token:str)->Path:
    require_root(); ensure_state_permissions()
    if not SAFE_BUILD_STAGE.fullmatch(token): raise RuntimeError('Invalid build upload token')
    src=STAGING_DIR/token
    st=os.lstat(src)
    if not stat.S_ISREG(st.st_mode): raise RuntimeError('Build upload is not a regular file')
    try: web_uid=pwd.getpwnam('www-data').pw_uid
    except KeyError: raise RuntimeError('www-data user not found')
    if st.st_uid!=web_uid: raise RuntimeError('Build upload has invalid owner')
    if st.st_size<1: raise RuntimeError('Build archive is empty')
    private=STATE_ROOT/f'.build-{secrets.token_hex(16)}{src.suffix.lower()}'
    os.replace(src,private)
    shutil.chown(private,user='root',group='cs16'); os.chmod(private,0o640)
    return private


def _detect_archive_type(path:Path)->str:
    head=path.read_bytes()[:16]
    if head.startswith(b'PK\x03\x04') or head.startswith(b'PK\x05\x06') or zipfile.is_zipfile(path): return 'zip'
    if head.startswith(b'Rar!\x1a\x07'): return 'rar'
    raise RuntimeError('Only ZIP and RAR assemblies are supported')


def _validate_archive_name(name:str):
    n=name.replace('\\','/').strip()
    if not n or n in {'.','./'}: return
    if n.startswith('/') or re.match(r'^[A-Za-z]:',n): raise RuntimeError(f'Unsafe archive path: {name}')
    parts=[x for x in n.split('/') if x not in {'','.','./'}]
    if any(x=='..' for x in parts): raise RuntimeError(f'Unsafe archive path: {name}')


def _extract_rar(path:Path,dst:Path):
    seven=shutil.which('7z') or shutil.which('7zz')
    if not seven: raise RuntimeError('RAR support is not installed (7z/p7zip-full is required)')
    listing=run([seven,'l','-slt',str(path)],check=False,timeout=120)
    if listing.returncode!=0: raise RuntimeError('RAR archive cannot be read: '+(listing.stdout or '')[-2000:])
    in_entries=False
    for line in (listing.stdout or '').splitlines():
        if line.startswith('----------'): in_entries=True; continue
        if in_entries and line.startswith('Path = '): _validate_archive_name(line[7:])
    dst.mkdir(parents=True,exist_ok=True)
    cp=run([seven,'x','-y',f'-o{dst}',str(path)],check=False,timeout=1800)
    if cp.returncode!=0: raise RuntimeError('RAR extraction failed: '+(cp.stdout or '')[-3000:])


def _validate_extracted_tree(root:Path):
    root=root.resolve()
    for item in root.rglob('*'):
        st=os.lstat(item)
        if stat.S_ISLNK(st.st_mode) or not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
            raise RuntimeError(f'Archive contains unsupported link/device: {item.relative_to(root)}')
        r=item.resolve()
        if r!=root and root not in r.parents: raise RuntimeError('Archive escaped extraction directory')


def _extract_build_archive(archive:Path,dst:Path)->str:
    kind=_detect_archive_type(archive)
    if kind=='zip': extract_zip(archive,dst)
    else: _extract_rar(archive,dst)
    _validate_extracted_tree(dst)
    return kind


def _unwrap_single_dir(root:Path)->Path:
    cur=root
    for _ in range(4):
        entries=[x for x in cur.iterdir() if x.name not in {'__MACOSX','.DS_Store'}]
        if len(entries)==1 and entries[0].is_dir(): cur=entries[0]
        else: break
    return cur


def _detect_build_payload(root:Path):
    root=_unwrap_single_dir(root)
    # Prefer a directory that owns cstrike/. This covers full HLDS/ReHLDS packs
    # and packs wrapped in one or two release folders.
    if (root/'cstrike').is_dir(): return root,'server-root'
    candidates=[]
    for cstrike in root.rglob('cstrike'):
        if cstrike.is_dir():
            try: depth=len(cstrike.relative_to(root).parts)
            except Exception: continue
            if depth<=4: candidates.append((depth,cstrike.parent))
    if candidates:
        candidates.sort(key=lambda x:x[0]); return candidates[0][1],'server-root'
    markers={'addons','maps','models','sound','sprites','resource','gfx','events','config','configs'}
    if any((root/m).exists() for m in markers): return root,'cstrike-content'
    dirs=[d for d in root.iterdir() if d.is_dir()]
    for d in dirs:
        if any((d/m).exists() for m in markers): return d,'cstrike-content'
    raise RuntimeError('Assembly layout is not recognized. Expected cstrike/ or CS content folders (addons/maps/models/sound/...)')


def _overlay_cstrike_content(payload:Path, stage_cstrike:Path):
    """Overlay gameplay content while preserving the known-good HLDS/AMXX core.

    Custom AMXX modules and safe third-party Metamod plugins are merged when the
    archive actually contains them. Stock AMXX binaries from old packs never
    overwrite the panel runtime.
    """
    stage_cstrike.mkdir(parents=True,exist_ok=True)
    excludes=[
        'liblist.gam','dlls/***','cl_dlls/***','logs/***','manual/***',
        'addons/metamod/dlls/***','addons/metamod/plugins.ini',
        'addons/amxmodx/dlls/***','addons/amxmodx/modules/***',
        # core.ini from old Windows/public packs often contains CRLF paths.
        # With Linux AMXX that can become e.g. modules.ini\r and then AMXX sees
        # neither modules.ini nor plugins.ini. Always keep the known-good 1.9 core.ini.
        'addons/amxmodx/configs/core.ini',
        'addons/dproto/***','addons/reunion/***','addons/localizebugfix/***',
    ]
    cmd=['rsync','-a']
    for x in excludes: cmd += ['--exclude',x]
    cmd += [str(payload)+'/',str(stage_cstrike)+'/']
    run(cmd,timeout=1800)

    # Keep current stock AMXX modules, but allow a build to bring extra modules
    # such as reapi/custom module .so files that its plugins genuinely require.
    srcmods=payload/'addons/amxmodx/modules'; dstmods=stage_cstrike/'addons/amxmodx/modules'
    stock={
        'cstrike_amxx_i386.so','csx_amxx_i386.so','engine_amxx_i386.so','fakemeta_amxx_i386.so',
        'fun_amxx_i386.so','geoip_amxx_i386.so','hamsandwich_amxx_i386.so','json_amxx_i386.so',
        'mysql_amxx_i386.so','nvault_amxx_i386.so','regex_amxx_i386.so','sockets_amxx_i386.so','sqlite_amxx_i386.so'
    }
    if srcmods.is_dir():
        dstmods.mkdir(parents=True,exist_ok=True)
        for mod in srcmods.glob('*.so'):
            if mod.name.lower() in stock: continue
            if re.fullmatch(r'[A-Za-z0-9_.-]{1,128}\.so',mod.name): shutil.copy2(mod,dstmods/mod.name)

    # Merge only third-party Metamod lines whose referenced Linux .so exists in
    # the imported tree. Old auth wrappers/core loaders stay disabled.
    srcmeta=payload/'addons/metamod/plugins.ini'; dstmeta=stage_cstrike/'addons/metamod/plugins.ini'
    if srcmeta.is_file() and dstmeta.is_file():
        deny=('amxmodx','dproto','reunion','localizebugfix','metamod')
        lines=dstmeta.read_text(encoding='utf-8',errors='ignore').splitlines()
        known={re.sub(r'\s+',' ',x.strip().lower()) for x in lines if x.strip() and not x.lstrip().startswith(';')}
        for raw in srcmeta.read_text(encoding='utf-8',errors='ignore').splitlines():
            st=raw.strip()
            if not st or st.startswith(';'): continue
            low=st.lower()
            if any(x in low for x in deny): continue
            m=re.search(r'(?i)\blinux(?:32)?\s+([^\s]+\.so)\b',st)
            if not m: continue
            rel=m.group(1).replace('\\','/').lstrip('/')
            if '..' in Path(rel).parts or not (stage_cstrike/rel).is_file(): continue
            key=re.sub(r'\s+',' ',low)
            if key not in known:
                lines.append(st); known.add(key)
        dstmeta.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8')


def _normalize_imported_text_configs(server_root:Path):
    """Normalize DOS/legacy CR line endings in imported text configs without recoding them.

    Old CS 1.6 packs are commonly prepared on Windows. AMXX on Linux can preserve the
    trailing carriage return from core/config path values, turning
    `addons/amxmodx/configs/modules.ini` into `modules.ini\\r`. The result is exactly
    what looks like a healthy AMXX load followed by "Modules list not found" and
    `0 plugins, 0 running`.

    Work on raw bytes so CP1251/Russian comments and any non-UTF8 content are kept
    byte-for-byte; only CRLF / lone CR are converted to LF.
    """
    cstrike=server_root/'cstrike'
    candidates=[]
    for rel in ['server.cfg','mapcycle.txt','motd.txt','banned.cfg','listip.cfg']:
        p=cstrike/rel
        if p.is_file(): candidates.append(p)
    cfgdir=cstrike/'addons/amxmodx/configs'
    if cfgdir.is_dir():
        for p in cfgdir.rglob('*'):
            if p.is_file() and p.suffix.lower() in {'.ini','.cfg','.txt'}:
                candidates.append(p)
    meta=cstrike/'addons/metamod/plugins.ini'
    if meta.is_file(): candidates.append(meta)
    changed=[]; failed=[]
    seen=set()
    for p in candidates:
        try:
            rp=str(p.resolve())
            if rp in seen: continue
            seen.add(rp)
            data=p.read_bytes()
            fixed=data.replace(b'\r\n',b'\n').replace(b'\r',b'\n')
            if fixed!=data:
                p.write_bytes(fixed)
                changed.append(str(p.relative_to(cstrike)))
        except Exception as exc:
            failed.append({'file':str(p),'error':str(exc)})
    return {'changed':changed,'failed':failed}


def _preserve_server_identity_files(old_root:Path, new_root:Path):
    """Never import somebody else's admins/bans from a downloaded pack over an existing server."""
    for rel in [
        'cstrike/addons/amxmodx/configs/users.ini',
        'cstrike/banned.cfg','cstrike/listip.cfg',
    ]:
        src=old_root/rel
        if src.is_file():
            dst=new_root/rel; dst.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,dst)


def _repair_zp_pack_assets(server_root:Path, external_fastdl:str=''):
    """Repair common resource problems in imported ZM packs.

    1. If the pack points to an old external FastDL, use it as a temporary source
       to hydrate resources that were omitted from the ZIP/RAR.
    2. If a configured ZP sky still does not exist locally, switch only that sky
       setting to a complete sky already shipped by the pack. This is safer than
       letting clients fail on six missing TGA files.
    3. The external URL is informational only; after installation HYPER-HOST writes
       its own per-server FastDL block into server.cfg.
    """
    cstrike=server_root/'cstrike'; fixes=[]; warnings=[]; hydrated=[]
    if external_fastdl:
        # Map .res manifests are the best machine-readable list of files clients
        # must have. Pull missing ones from the old FastDL before we take ownership.
        missing=[]
        for rel in _res_declared_resources(server_root):
            if not (cstrike/rel).is_file(): missing.append(rel)
        if missing:
            got=_hydrate_resources_from_external_fastdl(server_root,external_fastdl,missing)
            hydrated.extend(got)
            if got: fixes.append(f'Imported {len(got)} missing map resources from previous FastDL')

    ini=cstrike/'addons/amxmodx/configs/zombieplague.ini'
    if ini.is_file():
        raw=ini.read_text(encoding='utf-8',errors='ignore')
        m=re.search(r'(?im)^\s*SKY NAMES\s*=\s*([^\r\n;]+)',raw)
        if m:
            names=[x.strip() for x in m.group(1).split(',') if x.strip()]
            def complete_sky(name:str):
                return all((cstrike/'gfx/env'/f'{name}{suffix}.tga').is_file() for suffix in ['bk','dn','ft','lf','rt','up'])
            missing=[x for x in names if not complete_sky(x)]
            if missing and external_fastdl:
                skyrels=[f'gfx/env/{name}{suffix}.tga' for name in missing for suffix in ['bk','dn','ft','lf','rt','up']]
                got=_hydrate_resources_from_external_fastdl(server_root,external_fastdl,skyrels)
                hydrated.extend(got)
                if got: fixes.append(f'Imported {len(got)} skybox files from previous FastDL')
                missing=[x for x in names if not complete_sky(x)]
            if missing:
                available=[]; env=cstrike/'gfx/env'
                if env.is_dir():
                    # Case-insensitive grouping, but preserve the on-disk basename.
                    for bk in env.glob('*bk.tga'):
                        name=bk.name[:-6]
                        if complete_sky(name): available.append(name)
                available=sorted(set(available),key=str.lower)
                if available:
                    preferred=next((x for x in available if x.lower() in {'drkg','doom1','forest','desert','snow'}),available[0])
                    fixed=re.sub(r'(?im)^\s*SKY NAMES\s*=.*$',f'SKY NAMES = {preferred}',raw,count=1)
                    ini.write_text(fixed,encoding='utf-8')
                    fixes.append('Missing ZP sky '+', '.join(missing)+f' -> {preferred}')
                else:
                    warnings.append('Missing sky assets for: '+', '.join(missing)+'; no complete local skybox was found')
    if external_fastdl:
        fixes.append('Previous external FastDL detected and replaced by HYPER-HOST FastDL: '+external_fastdl[:260])
    cfg=cstrike/'server.cfg'
    if cfg.is_file():
        text=cfg.read_text(encoding='utf-8',errors='ignore')
        if re.search(r'(?im)^\s*sv_allowdownload\s+"?0"?',text):
            fixes.append('sv_allowdownload 0 will be overridden by managed FastDL settings')
    return {'fixes':fixes,'warnings':warnings,'hydrated':list(dict.fromkeys(hydrated)),'previous_fastdl':external_fastdl}

def _detect_mod_profile_at(server_root:Path):
    cstrike=server_root/'cstrike'; plugdir=cstrike/'addons/amxmodx/plugins'; cfgdir=cstrike/'addons/amxmodx/configs'
    actual={p.name.lower():p.name for p in plugdir.glob('*.amxx')} if plugdir.is_dir() else {}
    active=set(); sources={}
    if cfgdir.is_dir():
        files=[]
        main=cfgdir/'plugins.ini'
        if main.is_file(): files.append(main)
        files += sorted([x for x in cfgdir.glob('plugins-*.ini') if x.is_file()],key=lambda x:x.name.lower())
        for f in files:
            for line in f.read_text(encoding='utf-8',errors='ignore').splitlines():
                st=line.strip()
                if not st or st.startswith(';'): continue
                body=st.split(';',1)[0].strip()
                token=body.split()[0] if body else ''
                if token.lower().endswith('.amxx'):
                    active.add(token.lower()); sources.setdefault(token.lower(),[]).append(f.name)
    zp_cores=[]
    for key,name in actual.items():
        if re.fullmatch(r'zombie_plague(?:40|4[._-]?3)?\.amxx',key) or key in {'zp50_core.amxx','zp_core.amxx'}:
            zp_cores.append(name)
    zp_active=any(x.lower() in active for x in zp_cores)
    world_sig=['zombie_plague40.amxx','zp_addon_knifes_oli.amxx','zp_vip_free.amxx','boss_menu_by_7up.amxx']
    worldarena=all(x in actual for x in world_sig)
    mod_name=''
    if worldarena: mod_name='World-Arena ZM 4.3 + Knife + Free VIP'
    elif zp_cores: mod_name='Zombie Plague 4.3'
    return {
        'zp_installed':bool(zp_cores),'zp_active':bool(zp_active),'zp_core_plugins':sorted(zp_cores),
        'worldarena_installed':bool(worldarena),'detected_mod_name':mod_name,
        'actual_plugin_count':len(actual),'active_plugin_count':len([x for x in active if x in actual]),
        'active_sources':sources,
    }


def _cfg_has_directive(path:Path,key:str)->bool:
    try:
        text=path.read_text(encoding='utf-8',errors='ignore')
        return re.search(r'(?im)^\s*'+re.escape(key)+r'\s+',text) is not None
    except Exception:
        return False


def _clean_cfg_value(v:str,limit:int=160)->str:
    return re.sub(r'[\x00-\x1f\x7f]+',' ',str(v)).replace('"','').strip()[:limit]


def _adopt_imported_cfg(path:Path,c:dict):
    """Treat an uploaded build's server.cfg as authoritative.

    Previous versions intentionally re-wrote hostname/password/settings from the old
    panel state after import. That made a successful ZIP/RAR install look as if
    nothing changed. v3.0.3 adopts the uploaded hostname/config and touches only the
    minimum directives needed by the hosting panel: sv_lan=0 and a usable RCON key.
    """
    cfg=path/'cstrike/server.cfg'
    if not cfg.exists():
        write_server_cfg(path,c)
        return {'created_server_cfg':True,'hostname':str(c.get('hostname','')),'rcon_preserved':True,'server_password':''}

    old_rcon=str(c.get('rcon_password') or '')
    imported_hostname=_clean_cfg_value(_read_cfg_value(cfg,'hostname',''),160)
    imported_rcon=_clean_cfg_value(_read_cfg_value(cfg,'rcon_password',''),96)
    imported_password=_clean_cfg_value(_read_cfg_value(cfg,'sv_password',''),96) if _cfg_has_directive(cfg,'sv_password') else ''

    if imported_hostname:
        c['hostname']=imported_hostname
    if imported_rcon:
        c['rcon_password']=imported_rcon
    else:
        # Panel RCON is required for status/map/admin operations. If the build does
        # not provide one, preserve the existing secret without touching other cfgs.
        c['rcon_password']=old_rcon or secrets.token_urlsafe(18)
        _set_cfg_cvar(cfg,'rcon_password','"'+_clean_cfg_value(c['rcon_password'],96)+'"')
    c['server_password']=imported_password

    # Keep every gameplay cvar from the build. Only force Internet/LAN visibility.
    _set_cfg_cvar(cfg,'sv_lan','0')
    (path/'cstrike/banned.cfg').touch(exist_ok=True)
    (path/'cstrike/listip.cfg').touch(exist_ok=True)
    return {
        'created_server_cfg':False,
        'hostname':str(c.get('hostname','')),
        'hostname_adopted':bool(imported_hostname),
        'rcon_adopted':bool(imported_rcon),
        'rcon_preserved':not bool(imported_rcon),
        'server_password_adopted':_cfg_has_directive(cfg,'sv_password'),
    }


def _runtime_mod_report(c:dict, expect_zp:bool=False):
    """Verify that AMXX/Metamod and an imported ZP core actually loaded.

    `zp_on` is not a reliable success probe by itself: many ZP 4.3 builds return no
    text for a valid command. The authoritative check is the AMXX runtime plugin list.
    """
    report={'ok':True,'zp_runtime':False,'plugin_errors':[],'amxx_plugins':'','amxx_modules':'','meta_list':''}
    raw=''
    try:
        raw=query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),'amxx plugins',4.0)
        report['amxx_plugins']=raw[-16000:]
        lowraw=raw.lower()
        for line in raw.splitlines():
            low=line.lower()
            if 'bad load' in low or re.search(r'\berror\b',low) or 'load fails' in low:
                report['plugin_errors'].append(line.strip())
        # AMXX console columns can truncate the filename, so accept either the
        # canonical ZP core filename/prefix or the displayed plugin name.
        zp_markers=('zombie_plague40','zombie plague','zombie_plague','zp50_core','zp core')
        zp_lines=[ln for ln in raw.splitlines() if any(m in ln.lower() for m in zp_markers)]
        report['zp_plugin_lines']=zp_lines[-20:]
        report['zp_plugin_running']=any(('running' in ln.lower() or 'debug' in ln.lower()) and 'bad load' not in ln.lower() for ln in zp_lines)
        if re.search(r'(?im)^\s*0\s+plugins,\s*0\s+running',raw):
            report['plugin_errors'].append('AMXX loaded 0 plugins; check core.ini/config paths')
    except Exception as exc:
        report['ok']=False; report['amxx_error']=str(exc)
    try:
        mods=query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),'amxx modules',3.0)
        report['amxx_modules']=mods[-8000:]
        if 'modules list not found' in mods.lower(): report['plugin_errors'].append('AMXX modules list not found')
    except Exception as exc:
        report['amxx_modules_error']=str(exc)
    try:
        meta=query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),'meta list',3.0)
        report['meta_list']=meta[-8000:]
    except Exception as exc:
        report['meta_error']=str(exc)
    if expect_zp:
        try:
            zp=query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),'zp_on',2.5)
            report['zp_query']=zp[-2000:]
            low=zp.lower()
            report['zp_command_rejected']=('unknown command' in low or 'not found' in low or 'invalid command' in low)
        except Exception as exc:
            report['zp_query_error']=str(exc)
            report['zp_command_rejected']=True
        report['zp_runtime']=bool(report.get('zp_plugin_running'))
    return report


def _restart_strict(sid:int,c:dict,timeout:float=35.0):
    """Restart without the generic recovery engine silently disabling the requested mod."""
    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
    cp=run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False,timeout=90)
    if cp.returncode!=0:
        return False,(cp.stdout or '').strip() or 'systemd restart failed'
    return wait_server_ready(c,timeout)


def _prune_build_backups(backup_root:Path,sid:int,keep:int=3):
    items=sorted([p for p in backup_root.glob(f'{sid}-*') if p.is_dir()],key=lambda p:p.stat().st_mtime,reverse=True)
    for old in items[max(1,keep):]:
        try: shutil.rmtree(old)
        except OSError: pass


def _download_build_url(url:str)->Path:
    u=urllib.parse.urlparse(str(url).strip())
    if u.scheme not in {'http','https'} or not u.netloc: raise RuntimeError('Assembly URL must start with http:// or https://')
    ensure_state_permissions()
    tmp=STATE_ROOT/f'.build-download-{secrets.token_hex(16)}.bin'
    cp=run(['curl','--proto','=http,https','-fL','--retry','3','--retry-delay','2','--connect-timeout','20','--max-redirs','8','-A','HYPER-HOST-CS16/2.8','-o',str(tmp),url],check=False,timeout=3600)
    if cp.returncode!=0:
        try: tmp.unlink()
        except FileNotFoundError: pass
        raise RuntimeError('Assembly download failed: '+(cp.stdout or '')[-3000:])
    if not tmp.is_file() or tmp.stat().st_size<1: raise RuntimeError('Downloaded assembly is empty')
    kind=_detect_archive_type(tmp); final=tmp.with_suffix('.'+kind); os.replace(tmp,final); return final


def install_custom_build(sid:int,archive:Path,source_label:str='upload',preferred_map_override:str=''):
    require_root(); c=load_server(sid); original_state=dict(c); path=safe_server_path(sid)
    if Path(str(c.get('path') or path)).resolve()!=path: raise RuntimeError('Unsafe server path in state')
    archive=archive.resolve()
    if not archive.is_file(): raise RuntimeError('Assembly archive not found')
    rt=load_runtime(); base=Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds'))
    ensure_base('classic')
    token=secrets.token_hex(6); parent=path.parent
    stage=parent/f'.build-stage-{sid}-{token}'
    extract_root=STATE_ROOT/f'.build-extract-{sid}-{token}'
    backup_root=parent/BUILD_BACKUP_DIR_NAME; backup_root.mkdir(parents=True,exist_ok=True)
    backup=backup_root/f'{sid}-before-build-{time.strftime("%Y%m%d-%H%M%S")}-{token}'
    old_existed=path.exists(); swapped=False
    try:
        if stage.exists(): shutil.rmtree(stage)
        run(['rsync','-a','--delete',str(base)+'/',str(stage)+'/'],timeout=1200)
        kind=_extract_build_archive(archive,extract_root)
        payload,layout=_detect_build_payload(extract_root)
        if layout=='server-root':
            # Never replace the panel's known-good Linux HLDS runtime with an old
            # engine from somebody's ready-made archive. Import its cstrike tree
            # exactly like a cstrike-only pack; gameplay files/configs are kept.
            _overlay_cstrike_content(payload/'cstrike',stage/'cstrike')
            layout='server-root/runtime-preserved'
        else:
            _overlay_cstrike_content(payload,stage/'cstrike')
        if old_existed:
            _preserve_server_identity_files(path,stage)
        text_normalization=_normalize_imported_text_configs(stage)
        if text_normalization.get('failed'):
            raise RuntimeError('Failed to normalize imported text configs: '+json.dumps(text_normalization['failed'][:8],ensure_ascii=False))
        if not (stage/'hlds_linux').is_file(): raise RuntimeError('Fresh HLDS engine is missing after assembly preparation')
        if not (stage/'cstrike').is_dir(): raise RuntimeError('cstrike directory is missing after assembly preparation')
        for exe in ['hlds_linux','hlds_run']:
            if (stage/exe).exists(): os.chmod(stage/exe,0o775)
        stage_cfg={**c,'path':str(stage)}
        plugin_repairs=_sanitize_all_plugin_lists(stage_cfg)
        module_repairs=_sanitize_modules_ini(stage_cfg)
        metamod_repairs=_sanitize_metamod_plugins(stage_cfg)
        external_fastdl=_extract_external_fastdl_url(stage)
        zp_repairs=_repair_zp_pack_assets(stage,external_fastdl)
        detected=_detect_mod_profile_at(stage)
        # The uploaded build is authoritative for gameplay/server.cfg. Only the
        # launch port/slots stay panel-managed because systemd passes them on the
        # command line. Adopt hostname/RCON/password from the build where present.
        imported_cfg=_adopt_imported_cfg(stage,c)
        # FastDL is the one transport setting HYPER-HOST intentionally owns. The
        # managed block is appended after every build directive, so a pack's old
        # FastDL can never override the local per-server mirror.
        fastdl_cfg=_fastdl_apply_cfg(c,stage)
        maps=stage/'cstrike/maps'; preferred=str(preferred_map_override or c.get('start_map') or '')
        if not preferred or not (maps/(preferred+'.bsp')).is_file():
            choices=sorted(p.stem for p in maps.glob('*.bsp') if SAFE_MAP.fullmatch(p.stem)) if maps.is_dir() else []
            if detected.get('zp_active'):
                zm=[x for x in choices if x.lower().startswith('zm_')]
                if zm: preferred=zm[0]
                elif 'de_dust2' in choices: preferred='de_dust2'
                elif choices: preferred=choices[0]
                else: raise RuntimeError('Assembly has no playable .bsp maps')
            elif 'de_dust2' in choices: preferred='de_dust2'
            elif choices: preferred=choices[0]
            else: raise RuntimeError('Assembly has no playable .bsp maps')
        c['start_map']=preferred; db_update_start_map(sid,preferred)
        c['game_mode']='zp43' if detected.get('zp_active') else 'classic'
        normalize_permissions(stage)
        run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False,timeout=90)
        if old_existed: os.replace(path,backup)
        os.replace(stage,path); swapped=True
        c['path']=str(path); c['custom_build_source']=source_label; c['custom_build_installed_at']=int(time.time()); save_server(c)
        sql_warning=''
        try:
            sql_info=sql_provision(sid)
        except Exception as sql_exc:
            sql_info={'ok':False,'error':str(sql_exc)}; sql_warning='Automatic SQL setup failed: '+str(sql_exc)
        db_update_identity(sid,str(c.get('hostname') or ''))
        db_update_mode(sid,str(c.get('game_mode','classic')),int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
        # Mirror the final installed files before the first client can connect.
        # This also persists the canonical sv_downloadurl block in the real server.cfg.
        fastdl_info=fastdl_sync(sid,True)
        c=load_server(sid)
        run(['systemctl','daemon-reload'],check=False)
        run(['systemctl','start',f'hyper-cs16@{sid}.service'],check=False,timeout=60)
        ok,detail=wait_server_ready(c,50.0)
        runtime_hydrated=[]
        if not ok:
            # Some commercial/old packs intentionally omitted client assets from
            # the ZIP because their previous host supplied them only over FastDL.
            # If the crash log names such a resource, recover it from that old URL
            # once, mirror it to our FastDL, and retry before deciding to rollback.
            journal=_recent_failure_log(sid,180)
            broken,assets=_parse_plugin_failures(journal)
            if external_fastdl and assets:
                runtime_hydrated=_hydrate_resources_from_external_fastdl(path,external_fastdl,assets)
                if runtime_hydrated:
                    fastdl_info=fastdl_sync(sid,True)
                    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
                    run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False,timeout=60)
                    ok,detail=wait_server_ready(c,45.0)
            if not ok:
                # Do NOT call recover_server() here: that routine is allowed to rename
                # plugins-zplague.ini and leave a ZM upload running as classic. An
                # imported build is either running as uploaded, or we rollback it.
                journal=_recent_failure_log(sid,180)
                broken,assets=_parse_plugin_failures(journal)
                hint=''
                if broken: hint+=' Broken AMXX: '+', '.join(dict.fromkeys(broken))[:1400]+'.'
                if assets: hint+=' Missing resources: '+', '.join(dict.fromkeys(assets))[:1400]+'.'
                if external_fastdl: hint+=' Previous FastDL checked: '+external_fastdl[:500]+'.'
                raise RuntimeError(f'Uploaded assembly did not start as uploaded: {detail}.{hint} {journal[-7000:]}')

        detected=_detect_mod_profile_at(path)
        runtime_report=_runtime_mod_report(c,bool(detected.get('zp_active')))
        if detected.get('zp_active') and not runtime_report.get('zp_runtime'):
            journal=_recent_failure_log(sid,180)
            plugout=str(runtime_report.get('amxx_plugins') or '')[-6000:]
            modsout=str(runtime_report.get('amxx_modules') or runtime_report.get('amxx_modules_error') or '')[-3000:]
            metaout=str(runtime_report.get('meta_list') or runtime_report.get('meta_error') or '')[-3000:]
            zpout=str(runtime_report.get('zp_query') or runtime_report.get('zp_query_error') or '')[-1500:]
            raise RuntimeError('Zombie Plague files were installed but the mode did not load at runtime. '
                               +'ZP plugin lines: '+json.dumps(runtime_report.get('zp_plugin_lines') or [],ensure_ascii=False)
                               +' | zp_on: '+zpout+' | AMXX plugins: '+plugout+' | AMXX modules: '+modsout
                               +' | Metamod: '+metaout+' | LOG: '+journal[-6000:])

        _prune_build_backups(backup_root,sid,3)
        warnings=[]
        for w in (zp_repairs.get('warnings') or []):
            warnings.append(str(w))
        if runtime_report.get('plugin_errors'):
            warnings.append('AMXX reports plugin errors: '+' | '.join(runtime_report['plugin_errors'][:12]))
        if sql_warning: warnings.append(sql_warning)
        result={'ok':True,'id':sid,'archive_type':kind,'layout':layout,'start_map':c['start_map'],'backup':str(backup) if old_existed else '', 'source':source_label,'query':detail,
                'hostname':c.get('hostname',''),'game_mode':c.get('game_mode','classic'),'detected_mod':detected.get('detected_mod_name',''),'worldarena_installed':bool(detected.get('worldarena_installed')),
                'plugin_repairs':plugin_repairs,'module_repairs':module_repairs,'metamod_repairs':metamod_repairs,'zp_repairs':zp_repairs,
                'text_normalization':text_normalization,'imported_config':imported_cfg,'runtime_mod':runtime_report,'sql':sql_info,
                'fastdl':fastdl_info,'fastdl_config':fastdl_cfg,'previous_fastdl':external_fastdl,'runtime_hydrated':runtime_hydrated}
        if warnings: result['warning']=' '.join(warnings)
        return result
    except Exception as exc:
        # Transactional rollback: a bad pack must never destroy a working server or
        # leave its SQL/state pointing at the attempted map/mode.
        try:
            save_server(original_state)
            db_update_identity(sid,str(original_state.get('hostname') or ''))
            db_update_start_map(sid,str(original_state.get('start_map') or 'de_dust2'))
            db_update_mode(sid,str(original_state.get('game_mode') or 'classic'),int(original_state.get('bots_enabled',0)),int(original_state.get('bots_quota',9)),int(original_state.get('bots_difficulty',3)))
        except Exception:
            pass
        try: run(['systemctl','stop',f'hyper-cs16@{sid}.service'],check=False,timeout=60)
        except Exception: pass
        if swapped:
            try:
                if path.exists(): shutil.rmtree(path)
                if backup.exists(): os.replace(backup,path)
                normalize_permissions(path)
                run(['systemctl','start',f'hyper-cs16@{sid}.service'],check=False,timeout=60)
                raise RuntimeError(f'Assembly install failed, previous working server was restored automatically: {exc}')
            except RuntimeError:
                raise
            except Exception as rex:
                raise RuntimeError(f'Assembly install failed: {exc}; rollback also failed: {rex}')
        raise
    finally:
        try:
            if stage.exists(): shutil.rmtree(stage)
        except OSError: pass
        try:
            if extract_root.exists(): shutil.rmtree(extract_root)
        except OSError: pass
        try: archive.unlink()
        except OSError: pass


def build_install_upload(sid:int,token:str):
    archive=_build_take_staged(token)
    return install_custom_build(sid,archive,'upload:'+token.rsplit('.',1)[-1])


def build_install_url(sid:int,url:str):
    archive=_download_build_url(url)
    host=urllib.parse.urlparse(url).netloc
    return install_custom_build(sid,archive,'url:'+host[:120])

def _copy_tree_contents(src:Path,dst:Path):
    dst.mkdir(parents=True,exist_ok=True)
    for item in src.iterdir():
        target=dst/item.name
        if item.is_dir(): shutil.copytree(item,target,dirs_exist_ok=True)
        else: shutil.copy2(item,target)


def _append_unique(path:Path,line:str):
    path.parent.mkdir(parents=True,exist_ok=True)
    lines=path.read_text(encoding='utf-8',errors='ignore').splitlines() if path.exists() else []
    norm=line.strip().lower()
    if not any(x.strip().lower()==norm for x in lines): lines.append(line)
    path.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8')


def _set_cfg_cvar(path:Path,key:str,value:str):
    path.parent.mkdir(parents=True,exist_ok=True)
    text=path.read_text(encoding='utf-8',errors='ignore') if path.exists() else ''
    line=f'{key} {value}'
    pat=re.compile(r'(?im)^\s*'+re.escape(key)+r'\s+.*$')
    if pat.search(text): text=pat.sub(line,text,count=1)
    else: text=text.rstrip()+('\n' if text.strip() else '')+line+'\n'
    path.write_text(text,encoding='utf-8')


def install_yapb(sid:int,quota:int=9,difficulty:int=3):
    require_root(); c=load_server(sid); path=Path(c['path']); cstrike=path/'cstrike'
    quota=max(0,min(31,int(quota))); difficulty=max(0,min(4,int(difficulty)))
    with tempfile.TemporaryDirectory(prefix='hhcs16-yapb-') as td:
        td=Path(td); arc=td/'yapb.tar.xz'; ex=td/'ex'
        try:
            download(YAPB_URL,arc); extract_tar(arc,ex)
        except Exception:
            arc.unlink(missing_ok=True)
            download('https://www.geforce.nl/~mb/files/games/yapb-4.4.957-linux.tar.xz',arc); extract_tar(arc,ex)
        yapb_dirs=list(ex.rglob('addons/yapb'))
        if not yapb_dirs: raise RuntimeError('YaPB package does not contain addons/yapb')
        dst=cstrike/'addons/yapb'
        if dst.exists(): shutil.rmtree(dst)
        shutil.copytree(yapb_dirs[0],dst)
    _append_unique(cstrike/'addons/metamod/plugins.ini','linux addons/yapb/bin/yapb.so')
    ycfg=cstrike/'addons/yapb/conf/yapb.cfg'
    for k,v in [('yb_quota',str(quota)),('yb_quota_mode','fill'),('yb_difficulty',str(difficulty)),('yb_autovacate','1'),('yb_autovacate_keep_slots','1'),('yb_language','ru'),('yb_radio_mode','2'),('yb_preferred_personality','none'),('yb_ignore_enemies_after_spawn_time','8'),('yb_pickup_custom_items','1')]:
        _set_cfg_cvar(ycfg,k,v)
    custom=cstrike/'addons/yapb/conf/custom.cfg'
    _set_cfg_cvar(custom,'ZMDetectCvar','zp_on')
    _set_cfg_cvar(custom,'ZMDelayCvar','zp_delay')
    _set_cfg_cvar(custom,'ZMInfectedTeam','T')
    normalize_permissions(path)
    c['bots_enabled']=1; c['bots_quota']=quota; c['bots_difficulty']=difficulty; save_server(c)
    db_update_mode(sid,str(c.get('game_mode','classic')),1,quota,difficulty)
    restart=service_action(sid,'restart')
    current=load_server(sid)
    return {'ok':True,'id':sid,'bots':'YaPB','quota':quota,'difficulty':difficulty,'bots_enabled':bool(current.get('bots_enabled',0)),'restart':restart,'warning':restart.get('warning','')}


def configure_yapb(sid:int,quota:int,difficulty:int):
    require_root(); c=load_server(sid); path=Path(c['path']); ycfg=path/'cstrike/addons/yapb/conf/yapb.cfg'
    if not ycfg.exists(): return install_yapb(sid,quota,difficulty)
    quota=max(0,min(31,int(quota))); difficulty=max(0,min(4,int(difficulty)))
    _set_cfg_cvar(ycfg,'yb_quota',str(quota)); _set_cfg_cvar(ycfg,'yb_quota_mode','fill'); _set_cfg_cvar(ycfg,'yb_difficulty',str(difficulty)); _set_cfg_cvar(ycfg,'yb_autovacate','1'); _set_cfg_cvar(ycfg,'yb_language','ru')
    normalize_permissions(path); c['bots_enabled']=1; c['bots_quota']=quota; c['bots_difficulty']=difficulty; save_server(c); db_update_mode(sid,str(c.get('game_mode','classic')),1,quota,difficulty)
    if service_status(sid)=='active':
        try: query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),f'yb_quota {quota}',2.0); query_rcon('127.0.0.1',int(c['port']),str(c.get('rcon_password','')),f'yb_difficulty {difficulty}',2.0)
        except Exception: pass
    return {'ok':True,'quota':quota,'difficulty':difficulty}


def disable_yapb(sid:int):
    require_root(); c=load_server(sid); p=Path(c['path'])/'cstrike/addons/metamod/plugins.ini'
    if p.exists():
        lines=[]
        for line in p.read_text(encoding='utf-8',errors='ignore').splitlines():
            if 'addons/yapb/bin/yapb.so' in line.lower() and not line.lstrip().startswith(';'): line=';'+line
            lines.append(line)
        p.write_text('\n'.join(lines).rstrip()+'\n',encoding='utf-8')
    c['bots_enabled']=0; save_server(c); db_update_mode(sid,str(c.get('game_mode','classic')),0,int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
    restart=service_action(sid,'restart')
    return {'ok':True,'bots_enabled':False,'restart':restart,'warning':restart.get('warning','')}


def install_zp43(sid:int):
    require_root(); c=load_server(sid); path=Path(c['path']); cstrike=path/'cstrike'
    backup=STATE_ROOT/'backups'/f'zp43-{sid}-{time.strftime("%Y%m%d-%H%M%S")}'
    backup.mkdir(parents=True,exist_ok=True)
    for rel in ['addons/amxmodx/configs/plugins.ini','addons/amxmodx/configs/plugins-zplague.ini','addons/amxmodx/configs/zombieplague.cfg']:
        src=cstrike/rel
        if src.exists():
            dst=backup/rel; dst.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(src,dst)
    with tempfile.TemporaryDirectory(prefix='hhcs16-zp43-') as td:
        td=Path(td)
        for url,name in [(ZP43_PLUGIN_URL,'plugin.zip'),(ZP43_RESOURCES_URL,'resources.zip')]:
            arc=td/name; ex=td/(name+'.d'); download(url,arc)
            try: extract_zip(arc,ex)
            except Exception:
                direct='https://downloads.sourceforge.net/project/zm-strike/'+('zp_plugin_43.zip' if name=='plugin.zip' else 'zp_resources.zip')
                download(direct,arc); extract_zip(arc,ex)
            roots=[ex/'cstrike']+list(ex.rglob('cstrike'))+[x.parent for x in ex.rglob('addons')]+[ex]
            chosen=next((r for r in roots if r.exists() and ((r/'addons').exists() or (r/'models').exists() or (r/'sound').exists() or (r/'sprites').exists())),None)
            if chosen is None: raise RuntimeError(f'Zombie Plague archive layout is not recognized: {name}')
            _copy_tree_contents(chosen,cstrike)
    zplist=cstrike/'addons/amxmodx/configs/plugins-zplague.ini'
    if not zplist.exists():
        main=cstrike/'addons/amxmodx/plugins/zombie_plague40.amxx'
        if main.exists(): zplist.write_text('zombie_plague40.amxx\nzp_zclasses40.amxx\n',encoding='utf-8')
    c['game_mode']='zp43'; save_server(c); db_update_mode(sid,'zp43',int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
    _sanitize_all_plugin_lists(c); _sanitize_modules_ini(c); _sanitize_metamod_plugins(c)
    normalize_permissions(path)
    fastdl=fastdl_sync(sid,True); c=load_server(sid)
    ok,detail=_restart_strict(sid,c,45.0)
    if not ok:
        journal=_recent_failure_log(sid,180)
        raise RuntimeError(f'Zombie Plague was installed but HLDS did not start: {detail}. {journal[-7000:]}')
    runtime=_runtime_mod_report(c,True)
    if not runtime.get('zp_runtime'):
        journal=_recent_failure_log(sid,180)
        raise RuntimeError('Zombie Plague files are present, but zp_on is not available after restart. AMXX: '
                           +str(runtime.get('amxx_plugins') or '')[-6000:]+' LOG: '+journal[-5000:])
    warning=''
    if runtime.get('plugin_errors'): warning='AMXX plugin errors: '+' | '.join(runtime['plugin_errors'][:12])
    return {'ok':True,'mode':'zp43','backup':str(backup),'restart':{'ok':True,'detail':detail},'runtime_mod':runtime,'warning':warning,'fastdl':fastdl}


def set_game_mode(sid:int,mode:str):
    require_root(); c=load_server(sid); path=Path(c['path']); cstrike=path/'cstrike'
    if mode not in {'classic','zp43'}: raise RuntimeError('Unsupported game mode')
    zplist=cstrike/'addons/amxmodx/configs/plugins-zplague.ini'
    disabled=cstrike/'addons/amxmodx/configs/disabled-zplague.ini'
    old_mode=str(c.get('game_mode') or 'classic')
    had_zplist=zplist.exists(); had_disabled=disabled.exists()

    if mode=='zp43':
        if not zplist.exists() and disabled.exists(): disabled.rename(zplist)
        if not zplist.exists() and not (cstrike/'addons/amxmodx/plugins/zombie_plague40.amxx').exists():
            return install_zp43(sid)
    else:
        if zplist.exists():
            if disabled.exists(): disabled.unlink()
            zplist.rename(disabled)

    c['game_mode']=mode; save_server(c); db_update_mode(sid,mode,int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
    normalize_permissions(path)
    ok,detail=_restart_strict(sid,c,40.0)
    runtime=_runtime_mod_report(c,mode=='zp43') if ok else {'zp_runtime':False,'plugin_errors':[]}
    valid=ok and (mode!='zp43' or runtime.get('zp_runtime'))
    if not valid:
        # Restore the exact on/off state instead of letting generic recovery silently
        # turn the requested ZM mode off and report success.
        try:
            if had_zplist:
                if disabled.exists() and not zplist.exists(): disabled.rename(zplist)
            else:
                if zplist.exists():
                    if disabled.exists(): disabled.unlink()
                    zplist.rename(disabled)
            if had_disabled and not disabled.exists() and not had_zplist and zplist.exists(): zplist.rename(disabled)
        except Exception:
            pass
        c['game_mode']=old_mode; save_server(c); db_update_mode(sid,old_mode,int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
        _restart_strict(sid,c,30.0)
        journal=_recent_failure_log(sid,180)
        amxx=str(runtime.get('amxx_plugins') or '')[-5000:]
        zpq=str(runtime.get('zp_query') or runtime.get('zp_query_error') or '')[-1200:]
        raise RuntimeError(f'Requested mode {mode} did not start and was reverted to {old_mode}. startup={detail}; zp={zpq}; AMXX={amxx}; LOG={journal[-6000:]}')
    warning=''
    if runtime.get('plugin_errors'): warning='AMXX plugin errors: '+' | '.join(runtime['plugin_errors'][:12])
    return {'ok':True,'mode':mode,'restart':{'ok':True,'detail':detail},'runtime_mod':runtime,'warning':warning}


def mods_status(sid:int):
    c=load_server(sid); path=Path(c['path']); cstrike=path/'cstrike'
    bots_file=cstrike/'addons/yapb/bin/yapb.so'; bots_installed=bots_file.is_file()
    detected=_detect_mod_profile_at(path)
    actual_mode='zp43' if detected.get('zp_active') else 'classic'
    # Keep state/SQL in sync with what is physically loaded. This makes imported
    # ready-made ZM packs appear immediately without requiring a second install.
    if str(c.get('game_mode') or 'classic')!=actual_mode:
        c['game_mode']=actual_mode; save_server(c)
        try: db_update_mode(sid,actual_mode,int(c.get('bots_enabled',0)),int(c.get('bots_quota',9)),int(c.get('bots_difficulty',3)))
        except Exception: pass
    runtime={'zp_runtime':False,'plugin_errors':[]}
    try:
        if service_status(sid)=='active' and udp_listening(int(c['port'])):
            runtime=_runtime_mod_report(c,actual_mode=='zp43')
    except Exception as exc:
        runtime={'zp_runtime':False,'plugin_errors':[],'error':str(exc)}
    return {'ok':True,'game_mode':actual_mode,
            'zp43_installed':bool(detected.get('zp_installed')),
            'zp43_active':bool(detected.get('zp_active')),
            'zp_runtime':bool(runtime.get('zp_runtime')) if actual_mode=='zp43' else False,
            'zp_core_plugins':detected.get('zp_core_plugins',[]),
            'worldarena_installed':bool(detected.get('worldarena_installed')),
            'detected_mod_name':detected.get('detected_mod_name',''),
            'actual_plugin_count':int(detected.get('actual_plugin_count',0)),
            'active_plugin_count':int(detected.get('active_plugin_count',0)),
            'runtime_plugin_errors':runtime.get('plugin_errors',[]),
            'runtime_mod':runtime,
            'bots_installed':bots_installed,
            'bots_enabled':bool(bots_installed and c.get('bots_enabled',0)), 'bots_quota':int(c.get('bots_quota',9)), 'bots_difficulty':int(c.get('bots_difficulty',3)),
            'installed_amxx':plugins_list(sid).get('installed',[])}


def nat_upnp(sid:int):
    require_root(); c=load_server(sid); rt=load_runtime(); lan=str(rt.get('lan_ip') or '')
    if not lan: raise RuntimeError('LAN IP is not configured')
    port=int(c['port']); upnpc=shutil.which('upnpc')
    if not upnpc: raise RuntimeError('miniupnpc/upnpc is not installed')
    cp=run([upnpc,'-e',f'HYPER-CS16-{sid}','-a',lan,str(port),str(port),'UDP'],check=False,timeout=30)
    listing=run([upnpc,'-l'],check=False,timeout=30).stdout or ''
    ok=cp.returncode==0 and (f'{port}->' in listing or str(port) in listing)
    return {'ok':ok,'port':port,'lan_ip':lan,'output':(cp.stdout or '')[-2000:],'listing':listing[-4000:],
            'note':'UPnP must be enabled on the router. Manual rule: UDP external port = internal port -> LAN IP.'}



def _upnp_status(port:int):
    upnpc=shutil.which('upnpc')
    if not upnpc:
        return {'available':False,'external_ip':'','mapped':False,'listing':'','error':'upnpc is not installed'}
    cp=run([upnpc,'-s'],check=False,timeout=15)
    text=(cp.stdout or '')
    m=re.search(r'ExternalIPAddress\s*=\s*([0-9.]+)',text,re.I) or re.search(r'ExternalIPAddress[^0-9]*([0-9.]+)',text,re.I)
    external=m.group(1) if m else ''
    lp=run([upnpc,'-l'],check=False,timeout=20)
    listing=lp.stdout or ''
    mapped=bool(re.search(rf'\b{int(port)}\b.*UDP.*->.*:{int(port)}\b',listing,re.I) or re.search(rf'UDP.*\b{int(port)}\b.*\b{int(port)}\b',listing,re.I))
    return {'available':cp.returncode==0 or lp.returncode==0,'external_ip':external,'mapped':mapped,'listing':listing[-5000:],'error':'' if (cp.returncode==0 or lp.returncode==0) else text[-1000:]}


def _ensure_public_server_cfg(c:dict):
    cfg=Path(c['path'])/'cstrike/server.cfg'
    if not cfg.exists():
        return
    text=cfg.read_text(encoding='utf-8',errors='ignore')
    if re.search(r'(?mi)^\s*sv_lan\s+\"?1\"?\s*$',text):
        text=re.sub(r'(?mi)^\s*sv_lan\s+\"?1\"?\s*$', 'sv_lan 0', text)
    elif not re.search(r'(?mi)^\s*sv_lan\b',text):
        text=text.rstrip()+'\nsv_lan 0\n'
    cfg.write_text(text,encoding='utf-8')
    try:
        shutil.chown(cfg,user='cs16',group='cs16'); os.chmod(cfg,0o640)
    except Exception:
        pass


def network_fix(sid:int):
    require_root(); c=load_server(sid); port=int(c['port']); lan=detect_lan_ip(); rt=load_runtime(); public=str(c.get('public_ip') or rt.get('public_ip') or '')
    changes=[]; warnings=[]
    _ensure_public_server_cfg(c)
    # UFW first: explicit per-server rule so the current port is obvious in `ufw status`.
    if shutil.which('ufw'):
        cp=run(['ufw','allow',f'{port}/udp'],check=False,timeout=30)
        changes.append('ufw:'+('ok' if cp.returncode==0 else 'failed'))
        cp2=run(['ufw','allow','out','proto','udp','from','any','port',str(port)],check=False,timeout=30)
        changes.append('ufw-out:'+('ok' if cp2.returncode==0 else 'failed'))
    # Put narrow ACCEPT rules at the top of the classic/iptables-nft INPUT/OUTPUT chains.
    if shutil.which('iptables'):
        check=run(['iptables','-C','INPUT','-p','udp','--dport',str(port),'-j','ACCEPT'],check=False)
        if check.returncode!=0:
            run(['iptables','-I','INPUT','1','-p','udp','--dport',str(port),'-j','ACCEPT'],check=False)
        checkout=run(['iptables','-C','OUTPUT','-p','udp','--sport',str(port),'-j','ACCEPT'],check=False)
        if checkout.returncode!=0:
            run(['iptables','-I','OUTPUT','1','-p','udp','--sport',str(port),'-j','ACCEPT'],check=False)
        changes.append('iptables:accept')
    run(['systemctl','restart',f'hyper-cs16@{sid}.service'],check=False,timeout=40)
    ready,detail=wait_server_ready(c,30.0)
    if not ready:
        raise RuntimeError('HLDS did not become ready after network repair: '+str(detail))
    # Try to make an exact router mapping. Delete only this same UDP port, then recreate it.
    upnp_before=_upnp_status(port)
    upnp_result={'ok':False,'reason':'UPnP unavailable'}
    if upnp_before.get('available') and shutil.which('upnpc'):
        run(['upnpc','-d',str(port),'UDP'],check=False,timeout=20)
        cp=run(['upnpc','-e',f'HYPER-CS16-{sid}','-a',lan,str(port),str(port),'UDP'],check=False,timeout=30)
        upnp_after=_upnp_status(port)
        upnp_result={'ok':bool(upnp_after.get('mapped')),'external_ip':upnp_after.get('external_ip',''),'mapped':upnp_after.get('mapped',False),'output':(cp.stdout or '')[-2500:]}
    else:
        upnp_after=upnp_before
    router_external=str(upnp_after.get('external_ip') or '')
    if router_external and public and router_external!=public:
        warnings.append(f'Router WAN IP {router_external} differs from public IP {public}; double NAT/CGNAT is likely.')
    if not upnp_result.get('ok'):
        warnings.append(f'Automatic router mapping was not confirmed. Keenetic must have UDP {port} -> {lan}:{port}.')
    info=network_info(sid)
    info.update({'host_firewall_repaired':True,'changes':changes,'upnp':upnp_result,'router_external_ip':router_external,'public_ip_matches_router':(not router_external or not public or router_external==public),'warnings':warnings})
    info['ok']=bool(info.get('service')=='active' and info.get('udp_listening'))
    return info

def server_delete(sid:int):
    require_root(); ensure_state_permissions()
    # Deletion must not depend on /etc being writable. Read legacy JSON only as
    # a hint; never require unlinking it.
    row=db_server_row(sid) or {}; c=None
    for source in (cfg_path(sid),legacy_cfg_path(sid)):
        if not source.exists(): continue
        try:
            data=json.loads(source.read_text(encoding='utf-8'))
            if isinstance(data,dict): c=data; break
        except Exception: pass
    if c is None:
        c={'id':sid,'path':str(safe_server_path(sid)),'ftp_user':str(row.get('ftp_user') or f'cs16_{sid}')}
    path=Path(str(c.get('path') or safe_server_path(sid))).resolve(); safe=safe_server_path(sid)
    if path!=safe: raise RuntimeError(f'Unsafe server delete path: {path}')
    user=str(c.get('ftp_user') or row.get('ftp_user') or f'cs16_{sid}')
    run(['systemctl','disable','--now',f'hyper-cs16@{sid}.service'],check=False,timeout=90)
    ctl=shutil.which('hyper-host-ctl') or '/usr/local/sbin/hyper-host-ctl'
    if Path(ctl).exists(): run([ctl,'delete-ftp',user],check=False,timeout=120)
    if path.exists(): shutil.rmtree(path)
    try: cfg_path(sid).unlink()
    except FileNotFoundError: pass
    except OSError as exc: raise RuntimeError(f'Cannot remove writable state {cfg_path(sid)}: {exc}')
    DELETED_DIR.mkdir(parents=True,exist_ok=True)
    marker=deleted_marker(sid); marker.write_text(f'deleted {int(time.time())}\n',encoding='utf-8')
    try: shutil.chown(marker,user='root',group='cs16'); os.chmod(marker,0o640)
    except Exception: pass
    legacy_left=legacy_cfg_path(sid).exists()
    if legacy_left:
        try: legacy_cfg_path(sid).unlink(); legacy_left=False
        except OSError: pass
    fastdl_path=FASTDL_ROOT/str(sid)
    if fastdl_path.exists():
        try: shutil.rmtree(fastdl_path)
        except OSError: pass
    backup_root=safe.parent/BUILD_BACKUP_DIR_NAME
    if backup_root.is_dir():
        for bp in backup_root.glob(f'{sid}-*'):
            try:
                if bp.is_dir(): shutil.rmtree(bp)
                else: bp.unlink()
            except OSError: pass
    # Remove stale resource-property drop-ins from old panel versions. They are
    # irrelevant after deletion and must not affect a future server reusing the ID.
    for root in (Path('/etc/systemd/system'),Path('/run/systemd/system')):
        d=root/f'hyper-cs16@{sid}.service.d'
        if d.is_dir():
            try: shutil.rmtree(d)
            except OSError: pass
    run(['systemctl','daemon-reload'],check=False)
    run(['systemctl','reset-failed',f'hyper-cs16@{sid}.service'],check=False)
    sql_cleanup_warning=''
    try:
        db_name,db_user=_server_sql_names(sid)
        _mysql_root_exec(
            f"DROP DATABASE IF EXISTS `{db_name}`;"
            f"DROP USER IF EXISTS {_sql_literal(db_user)}@'127.0.0.1';"
            f"DROP USER IF EXISTS {_sql_literal(db_user)}@'localhost';FLUSH PRIVILEGES;"
        )
    except Exception as exc:
        # Dedicated SQL is auxiliary; a DB outage must never block game-server deletion.
        sql_cleanup_warning='Dedicated SQL cleanup warning: '+str(exc)
    return {'ok':True,'id':sid,'deleted_path':str(path),'ftp_user':user,'legacy_state_left':legacy_left,'legacy_state':str(legacy_cfg_path(sid)) if legacy_left else '', 'sql_cleanup_warning':sql_cleanup_warning}


def doctor():
    rt=load_runtime(); checks={}
    for name,cmd in {'steamcmd':[rt.get('steamcmd','/opt/steamcmd/steamcmd.sh'),'+quit'], 'nginx':['nginx','-t'], 'mariadb':['systemctl','is-active','mariadb'], 'ftp':['ss','-ltn','sport = :21']}.items():
        cp=run(cmd,check=False,timeout=30); checks[name]={'ok':cp.returncode==0,'output':(cp.stdout or '').strip()[-500:]}
    checks['base_game']={'ok':Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds')).joinpath('hlds_run').exists() and Path(rt.get('base_game_dir','/srv/hyper-cs16/base-hlds')).joinpath('cstrike/maps/de_dust2.bsp').exists()}
    state_ok=STATE_ROOT.is_dir() and SERVER_CFG_DIR.is_dir()
    state_detail=[]
    if state_ok:
        cp=run(['runuser','-u','cs16','--','test','-x',str(STATE_ROOT)],check=False)
        state_ok=state_ok and cp.returncode==0
        if cp.returncode!=0: state_detail.append(f'cs16 cannot traverse {STATE_ROOT}')
        cp=run(['runuser','-u','cs16','--','test','-x',str(SERVER_CFG_DIR)],check=False)
        state_ok=state_ok and cp.returncode==0
        if cp.returncode!=0: state_detail.append(f'cs16 cannot traverse {SERVER_CFG_DIR}')
        for fp in sorted(SERVER_CFG_DIR.glob('*.json')):
            cp=run(['runuser','-u','cs16','--','test','-r',str(fp)],check=False)
            if cp.returncode!=0:
                state_ok=False; state_detail.append(f'cs16 cannot read {fp.name}')
    checks['state_dir']={'ok':state_ok,'path':str(SERVER_CFG_DIR),'detail':'; '.join(state_detail)}
    checks['ftp_restore_service']={'ok':run(['systemctl','is-enabled','hyper-cs16-ftp-restore.service'],check=False).returncode==0}
    try:
        stg=staging_prepare(); checks['upload_staging']={'ok':True,'path':stg['path'],'mode':stg['mode'],'www_data_writable':True,'free_bytes':stg['free_bytes']}
    except Exception as exc:
        checks['upload_staging']={'ok':False,'path':str(STAGING_DIR),'error':str(exc)}
    return {'ok':all(v.get('ok') for v in checks.values()),'checks':checks}


def main():
    p=argparse.ArgumentParser(prog='hyper-cs16-ctl'); sp=p.add_subparsers(dest='cmd',required=True)
    sp.add_parser('base-install')
    sp.add_parser('base-maps')
    c=sp.add_parser('server-create'); c.add_argument('id',type=int); c.add_argument('--name',required=True); c.add_argument('--port',type=int,required=True); c.add_argument('--slots',type=int,default=16); c.add_argument('--map',default='de_dust2'); c.add_argument('--hostname',required=True); c.add_argument('--password',default=''); c.add_argument('--profile',choices=['classic','rehlds'],default='classic')
    for a in ['start','stop','restart','status','players','maps','plugins','update','reinstall','ftp-reset','ftp-repair','ftp-test','network','delete','repair-runtime','mods-status','nat-upnp','network-fix','repair-content','sql-status','fastdl-sync','fastdl-status']:
        q=sp.add_parser(a); q.add_argument('id',type=int)
    q=sp.add_parser('sql-provision'); q.add_argument('id',type=int); q.add_argument('--rotate',action='store_true')
    q=sp.add_parser('sql-table'); q.add_argument('id',type=int); q.add_argument('table'); q.add_argument('--limit',type=int,default=100)
    q=sp.add_parser('recover'); q.add_argument('id',type=int); q.add_argument('--auto',action='store_true')
    q=sp.add_parser('rcon'); q.add_argument('id',type=int); q.add_argument('command')
    q=sp.add_parser('change-map'); q.add_argument('id',type=int); q.add_argument('map')
    q=sp.add_parser('activate-map'); q.add_argument('id',type=int); q.add_argument('map')
    q=sp.add_parser('kick'); q.add_argument('id',type=int); q.add_argument('userid',type=int)
    q=sp.add_parser('ban'); q.add_argument('id',type=int); q.add_argument('userid',type=int); q.add_argument('--minutes',type=int,default=30)
    q=sp.add_parser('plugin-toggle'); q.add_argument('id',type=int); q.add_argument('plugin'); q.add_argument('state',choices=['on','off'])
    q=sp.add_parser('admin-list'); q.add_argument('id',type=int)
    q=sp.add_parser('admin-save'); q.add_argument('id',type=int)
    q=sp.add_parser('admin-delete'); q.add_argument('id',type=int); q.add_argument('index',type=int)
    q=sp.add_parser('config-read'); q.add_argument('id',type=int); q.add_argument('name',choices=sorted(ALLOWED_CONFIGS))
    q=sp.add_parser('config-write'); q.add_argument('id',type=int); q.add_argument('name',choices=sorted(ALLOWED_CONFIGS))
    q=sp.add_parser('config-set'); q.add_argument('id',type=int); q.add_argument('--port',type=int); q.add_argument('--slots',type=int); q.add_argument('--map'); q.add_argument('--hostname'); q.add_argument('--password'); q.add_argument('--rcon')
    q=sp.add_parser('limits-set'); q.add_argument('id',type=int); q.add_argument('--cpu',type=float,default=0); q.add_argument('--memory',type=int,default=0)
    q=sp.add_parser('logs'); q.add_argument('id',type=int); q.add_argument('--lines',type=int,default=160)
    q=sp.add_parser('map-upload'); q.add_argument('id',type=int); q.add_argument('token'); q.add_argument('map_name')
    q=sp.add_parser('plugin-upload'); q.add_argument('id',type=int); q.add_argument('token'); q.add_argument('plugin_name')
    q=sp.add_parser('build-install-upload'); q.add_argument('id',type=int); q.add_argument('token')
    q=sp.add_parser('build-install-url'); q.add_argument('id',type=int)
    q=sp.add_parser('bots-install'); q.add_argument('id',type=int); q.add_argument('--quota',type=int,default=9); q.add_argument('--difficulty',type=int,default=3)
    q=sp.add_parser('bots-config'); q.add_argument('id',type=int); q.add_argument('--quota',type=int,required=True); q.add_argument('--difficulty',type=int,required=True)
    q=sp.add_parser('bots-disable'); q.add_argument('id',type=int)
    q=sp.add_parser('zp43-install'); q.add_argument('id',type=int)
    q=sp.add_parser('mode-set'); q.add_argument('id',type=int); q.add_argument('mode',choices=['classic','zp43'])
    sp.add_parser('ftp-restore')
    sp.add_parser('staging-prepare')
    sp.add_parser('fastdl-sync-all')
    sp.add_parser('doctor')
    args=p.parse_args()
    try:
        if args.cmd=='base-install': result=ensure_base('classic')
        elif args.cmd=='base-maps': result=base_map_list()
        elif args.cmd=='server-create': result=server_create(args)
        elif args.cmd in {'start','stop','restart'}: result=service_action(args.id,args.cmd)
        elif args.cmd=='status': result=status_json(args.id,True)
        elif args.cmd=='recover': result=recover_server(args.id,args.auto)
        elif args.cmd=='players': result={'ok':True,'players':status_json(args.id,True).get('players',[])}
        elif args.cmd=='maps': result=map_list(args.id)
        elif args.cmd=='plugins': result=plugins_list(args.id)
        elif args.cmd=='rcon': result=rcon_cmd(args.id,args.command)
        elif args.cmd in {'change-map','activate-map'}:
            result=activate_map(args.id,args.map)
        elif args.cmd=='kick': result=rcon_cmd(args.id,f'kick #{max(0,args.userid)}')
        elif args.cmd=='ban': result=rcon_cmd(args.id,f'banid {max(0,args.minutes)} #{max(0,args.userid)} kick;writeid')
        elif args.cmd=='plugin-toggle': result=plugin_toggle(args.id,args.plugin,args.state=='on')
        elif args.cmd=='admin-list': result=admin_list(args.id)
        elif args.cmd=='admin-save':
            raw=sys.stdin.buffer.read(128*1024+1)
            if len(raw)>128*1024: raise RuntimeError('Admin payload is too large')
            try: payload=json.loads(raw.decode('utf-8','replace') or '{}')
            except Exception: raise RuntimeError('Invalid admin payload')
            if not isinstance(payload,dict): raise RuntimeError('Invalid admin payload')
            result=admin_save(args.id,payload)
        elif args.cmd=='admin-delete': result=admin_delete(args.id,args.index)
        elif args.cmd=='config-read': result=config_read(args.id,args.name)
        elif args.cmd=='config-write':
            raw=sys.stdin.buffer.read(512*1024+1)
            if len(raw)>512*1024: raise RuntimeError('Config is too large')
            result=config_write(args.id,args.name,raw.decode('utf-8','replace'))
        elif args.cmd=='config-set': result=server_config_set(args)
        elif args.cmd=='limits-set': result=server_limits_set(args.id,args.cpu,args.memory)
        elif args.cmd=='logs': result=logs(args.id,args.lines)
        elif args.cmd=='update': result=server_update(args.id)
        elif args.cmd=='reinstall': result=server_reinstall(args.id)
        elif args.cmd=='ftp-reset': result=ftp_reset(args.id)
        elif args.cmd=='ftp-repair': result=ftp_repair(args.id)
        elif args.cmd=='ftp-test': result=ftp_test(args.id)
        elif args.cmd=='network': result=network_info(args.id)
        elif args.cmd=='mods-status': result=mods_status(args.id)
        elif args.cmd=='sql-status': result=sql_status(args.id)
        elif args.cmd=='sql-provision': result=sql_provision(args.id,args.rotate)
        elif args.cmd=='sql-table': result=sql_table(args.id,args.table,args.limit)
        elif args.cmd=='fastdl-sync': result=fastdl_sync(args.id,True)
        elif args.cmd=='fastdl-status': result=fastdl_status(args.id)
        elif args.cmd=='nat-upnp': result=nat_upnp(args.id)
        elif args.cmd=='network-fix': result=network_fix(args.id)
        elif args.cmd=='repair-content': result=repair_amxx_content(args.id,True)
        elif args.cmd=='bots-install': result=install_yapb(args.id,args.quota,args.difficulty)
        elif args.cmd=='bots-config': result=configure_yapb(args.id,args.quota,args.difficulty)
        elif args.cmd=='bots-disable': result=disable_yapb(args.id)
        elif args.cmd=='zp43-install': result=install_zp43(args.id)
        elif args.cmd=='mode-set': result=set_game_mode(args.id,args.mode)
        elif args.cmd=='map-upload': result=map_upload(args.id,args.token,args.map_name)
        elif args.cmd=='plugin-upload': result=plugin_upload(args.id,args.token,args.plugin_name)
        elif args.cmd=='build-install-upload': result=build_install_upload(args.id,args.token)
        elif args.cmd=='build-install-url':
            raw=sys.stdin.buffer.read(8193)
            if len(raw)>8192: raise RuntimeError('Assembly URL is too long')
            result=build_install_url(args.id,raw.decode('utf-8','replace').strip())
        elif args.cmd=='repair-runtime': result=repair_server_runtime(args.id)
        elif args.cmd=='delete': result=server_delete(args.id)
        elif args.cmd=='ftp-restore': result=ftp_restore()
        elif args.cmd=='staging-prepare': result=staging_prepare()
        elif args.cmd=='fastdl-sync-all':
            synced=[]; errors=[]
            for fp in sorted(SERVER_CFG_DIR.glob('*.json')):
                try:
                    sid=int(fp.stem); synced.append(fastdl_sync(sid,True))
                except Exception as exc: errors.append({'id':fp.stem,'error':str(exc)})
            result={'ok':not errors,'synced':synced,'errors':errors}
        elif args.cmd=='doctor': result=doctor()
        else: raise RuntimeError('Unknown command')
        out(result,0 if result.get('ok',True) else 1)
    except Exception as exc:
        out({'ok':False,'error':str(exc)},1)

if __name__=='__main__': main()
