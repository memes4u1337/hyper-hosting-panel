def out(data, code=0):
    if isinstance(data,str): print(data)
    else: print(json.dumps(data,ensure_ascii=False,separators=(',',':')))
    raise SystemExit(code)


def require_root():
    if os.geteuid()!=0: out({'ok':False,'error':'root privileges required'},2)


def load_runtime():
    try: return json.loads(RUNTIME_FILE.read_text(encoding='utf-8'))
    except Exception as exc: out({'ok':False,'error':f'Runtime config unavailable: {exc}'},2)


def cfg_path(sid:int)->Path: return SERVER_CFG_DIR/f'{sid}.json'

def legacy_cfg_path(sid:int)->Path: return LEGACY_SERVER_CFG_DIR/f'{sid}.json'
def deleted_marker(sid:int)->Path: return DELETED_DIR/f'{sid}.deleted'

def ensure_state_permissions():
    """Keep mutable state private, while allowing PHP to traverse to upload staging.

    STATE_ROOT used to be 0750 root:cs16.  That blocks www-data before it can
    even stat STATE_ROOT/uploads, so PHP reported "Upload staging not configured"
    even when the child directory existed.  Keep only traverse permission for
    other users on the state root (0751), and keep the actual private subdirs
    locked to root:cs16.
    """
    require_root()
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        shutil.chown(STATE_ROOT, user='root', group='cs16')
        os.chmod(STATE_ROOT, 0o751)
    except Exception as exc:
        raise RuntimeError(f'Cannot fix state root permissions for {STATE_ROOT}: {exc}')
    for d in (SERVER_CFG_DIR, DELETED_DIR):
        d.mkdir(parents=True, exist_ok=True)
        try:
            shutil.chown(d, user='root', group='cs16')
            os.chmod(d, 0o750)
        except Exception as exc:
            raise RuntimeError(f'Cannot fix state directory permissions for {d}: {exc}')
    for fp in SERVER_CFG_DIR.glob('*.json'):
        try:
            if fp.is_file():
                shutil.chown(fp, user='root', group='cs16')
                os.chmod(fp, 0o640)
        except Exception as exc:
            raise RuntimeError(f'Cannot fix state file permissions for {fp}: {exc}')


def ensure_staging_permissions():
    """Create staging outside /etc and /var/lib so immutable parent mounts cannot break uploads."""
    require_root()
    STAGING_ROOT.mkdir(parents=True, exist_ok=True)
    STAGING_DIR.mkdir(parents=True, exist_ok=True)
    try:
        shutil.chown(STAGING_ROOT, user='www-data', group='www-data')
        os.chmod(STAGING_ROOT, 0o750)
        shutil.chown(STAGING_DIR, user='www-data', group='www-data')
        os.chmod(STAGING_DIR, 0o770)
    except Exception as exc:
        raise RuntimeError(f'Cannot fix upload staging permissions for {STAGING_DIR}: {exc}')


def staging_prepare():
    """Create/repair the web upload staging area and verify it as www-data."""
    require_root(); ensure_state_permissions(); ensure_staging_permissions()
    # Remove abandoned staging uploads after one day. Never follow symlinks.
    now=time.time(); removed=0
    for fp in STAGING_DIR.iterdir():
        try:
            st=os.lstat(fp)
            if stat.S_ISREG(st.st_mode) and now-st.st_mtime>86400:
                fp.unlink(); removed+=1
        except OSError:
            pass
    test=run(['runuser','-u','www-data','--','test','-w',str(STAGING_DIR)],check=False,timeout=10)
    if test.returncode!=0:
        raise RuntimeError(f'Upload staging exists but www-data cannot write to {STAGING_DIR}. state_root_mode={oct(os.stat(STATE_ROOT).st_mode & 0o777)} staging_mode={oct(os.stat(STAGING_DIR).st_mode & 0o777)}')
    try:
        usage=shutil.disk_usage(STAGING_DIR)
        free=int(usage.free)
    except Exception:
        free=0
    st=os.stat(STAGING_DIR)
    return {'ok':True,'path':str(STAGING_DIR),'mode':oct(st.st_mode & 0o777),'uid':st.st_uid,'gid':st.st_gid,'www_data_writable':True,'free_bytes':free,'stale_removed':removed}


def db_connect():
    rt=load_runtime()
    try:
        import pymysql
        return pymysql.connect(host=rt.get('db_host','127.0.0.1'),port=int(rt.get('db_port',3306)),
            user=rt['db_user'],password=rt['db_password'],database=rt['db_name'],charset='utf8mb4',
            autocommit=True,cursorclass=pymysql.cursors.DictCursor,connect_timeout=5)
    except Exception as exc:
        raise RuntimeError(f'Database connection failed: {exc}')



def _sql_literal(value:str)->str:
    return "'"+str(value).replace('\\','\\\\').replace("'","''")+"'"


def _mysql_root_exec(sql:str):
    """Run local MariaDB/MySQL administration through root's unix-socket auth."""
    binpath=shutil.which('mariadb') or shutil.which('mysql')
    if not binpath:
        raise RuntimeError('MariaDB/MySQL CLI is not installed')
    cp=run([binpath,'--protocol=socket','-uroot','--batch','--skip-column-names','-e',sql],check=False,timeout=60)
    if cp.returncode!=0:
        raise RuntimeError('MySQL root/socket command failed: '+(cp.stdout or '').strip()[-3000:])
    return (cp.stdout or '').strip()


def _server_sql_names(sid:int):
    return f'cs16_srv_{int(sid)}', f'cs16_s{int(sid)}'


def _write_amxx_sql_cfg(c:dict, db_name:str, db_user:str, db_password:str):
    root=Path(c['path'])
    cfg=root/'cstrike/addons/amxmodx/configs/sql.cfg'
    cfg.parent.mkdir(parents=True,exist_ok=True)
    if not cfg.exists(): cfg.write_text('',encoding='utf-8')
    # Standard AMXX SQL cvars. Plugins using AMXX SQLX/sql.cfg inherit these
    # automatically, while custom plugins with their own config remain untouched.
    for key,value in [
        ('amx_sql_host','127.0.0.1'),('amx_sql_user',db_user),('amx_sql_pass',db_password),
        ('amx_sql_db',db_name),('amx_sql_table','admins'),('amx_sql_type','mysql')
    ]:
        _set_cfg_cvar(cfg,key,'"'+_clean_cfg_value(value,180)+'"')
    marker=root/'cstrike/addons/amxmodx/configs/hyper_sql.cfg'
    marker.write_text(
        '; HYPER-HOST automatic SQL connection\n'
        '; Standard AMXX plugins read configs/sql.cfg.\n'
        f'; Database: {db_name}\n; User: {db_user}\n; Host: 127.0.0.1:3306\n',
        encoding='utf-8'
    )
    modules=root/'cstrike/addons/amxmodx/configs/modules.ini'
    modules.parent.mkdir(parents=True,exist_ok=True)
    text=modules.read_text(encoding='utf-8',errors='ignore') if modules.exists() else ''
    active_mysql=any(re.match(r'^\s*mysql(?:_amxx_i386\.so)?\s*$',ln,re.I) for ln in text.splitlines() if not ln.lstrip().startswith(';'))
    if not active_mysql:
        modules.write_text(text.rstrip()+('\n' if text.strip() else '')+'mysql\n',encoding='utf-8')
    return str(cfg)


def _sql_meta_update(sid:int, db_name:str='', db_user:str='', config_path:str='', status:str='pending', error:str=''):
    try:
        con=db_connect()
        try:
            with con.cursor() as cur:
                cur.execute("""INSERT INTO server_sql_connections(server_id,db_host,db_port,db_name,db_user,config_path,status,last_error,last_check_at)
                    VALUES(%s,'127.0.0.1',3306,%s,%s,%s,%s,%s,NOW())
                    ON DUPLICATE KEY UPDATE db_host='127.0.0.1',db_port=3306,db_name=VALUES(db_name),db_user=VALUES(db_user),
                    config_path=VALUES(config_path),status=VALUES(status),last_error=VALUES(last_error),last_check_at=NOW()""",
                    (sid,db_name,db_user,config_path,status,str(error)[:1000]))
        finally: con.close()
    except Exception:
        pass


def sql_provision(sid:int, rotate:bool=False):
    """Create a dedicated SQL database/user for one game server and wire AMXX sql.cfg.

    This does not depend on a particular game mode. Universal HYPER-HOST player
    telemetry is stored separately in the panel DB by the monitor, so even old
    builds without SQL plugins still get online/rating/history statistics.
    """
    require_root(); c=load_server(sid); root=Path(c['path'])
    if not root.is_dir(): raise RuntimeError(f'Server directory missing: {root}')
    db_name,db_user=_server_sql_names(sid)
    password='' if rotate else str(c.get('sql_password') or '')
    if not password: password=secrets.token_urlsafe(18).replace("'",'A')
    try:
        # Names are generated locally from a numeric server id, never user input.
        qdb='`'+db_name+'`'; quser=_sql_literal(db_user); qpass=_sql_literal(password)
        sql=(
            f"CREATE DATABASE IF NOT EXISTS {qdb} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
            f"CREATE USER IF NOT EXISTS {quser}@'127.0.0.1' IDENTIFIED BY {qpass};"
            f"ALTER USER {quser}@'127.0.0.1' IDENTIFIED BY {qpass};"
            f"CREATE USER IF NOT EXISTS {quser}@'localhost' IDENTIFIED BY {qpass};"
            f"ALTER USER {quser}@'localhost' IDENTIFIED BY {qpass};"
            f"GRANT ALL PRIVILEGES ON {qdb}.* TO {quser}@'127.0.0.1';"
            f"GRANT ALL PRIVILEGES ON {qdb}.* TO {quser}@'localhost';FLUSH PRIVILEGES;"
        )
        _mysql_root_exec(sql)
        cfg_path_written=_write_amxx_sql_cfg(c,db_name,db_user,password)
        c['sql_enabled']=True; c['sql_host']='127.0.0.1'; c['sql_port']=3306
        c['sql_db']=db_name; c['sql_user']=db_user; c['sql_password']=password; c['sql_config_path']=cfg_path_written
        save_server(c); normalize_permissions(root)
        # Verify using the exact game credentials, not the panel account.
        try:
            import pymysql
            test=pymysql.connect(host='127.0.0.1',port=3306,user=db_user,password=password,database=db_name,connect_timeout=5,charset='utf8mb4')
            with test.cursor() as cur: cur.execute('SELECT 1'); cur.fetchone()
            test.close()
        except Exception as exc:
            raise RuntimeError('Dedicated game SQL was created but login test failed: '+str(exc))
        _sql_meta_update(sid,db_name,db_user,cfg_path_written,'ready','')
        return {'ok':True,'id':sid,'host':'127.0.0.1','port':3306,'database':db_name,'user':db_user,'password':password,
                'config_path':cfg_path_written,'standard_amxx_sql':True,'telemetry':'panel-db'}
    except Exception as exc:
        _sql_meta_update(sid,db_name,db_user,str(root/'cstrike/addons/amxmodx/configs/sql.cfg'),'error',str(exc))
        raise


def sql_status(sid:int):
    c=load_server(sid); db_name=str(c.get('sql_db') or _server_sql_names(sid)[0]); db_user=str(c.get('sql_user') or _server_sql_names(sid)[1]); pw=str(c.get('sql_password') or '')
    cfg=Path(c['path'])/'cstrike/addons/amxmodx/configs/sql.cfg'; connected=False; error=''; tables=[]
    if pw:
        try:
            import pymysql
            con=pymysql.connect(host='127.0.0.1',port=3306,user=db_user,password=pw,database=db_name,connect_timeout=4,charset='utf8mb4',cursorclass=pymysql.cursors.DictCursor)
            with con.cursor() as cur:
                cur.execute('SHOW TABLES')
                tables=[str(next(iter(r.values()))) for r in cur.fetchall()]
            con.close(); connected=True
        except Exception as exc: error=str(exc)
    else: error='SQL credentials are not provisioned yet'
    _sql_meta_update(sid,db_name,db_user,str(cfg),'ready' if connected else 'error',error)
    return {'ok':True,'id':sid,'connected':connected,'host':'127.0.0.1','port':3306,'database':db_name,'user':db_user,
            'password':pw,'config_path':str(cfg),'config_exists':cfg.is_file(),'tables':tables[:250],'error':error}


def sql_table(sid:int,table:str,limit:int=100):
    if not re.fullmatch(r'[A-Za-z0-9_]{1,64}',str(table or '')): raise RuntimeError('Invalid SQL table name')
    c=load_server(sid); db_name=str(c.get('sql_db') or ''); db_user=str(c.get('sql_user') or ''); pw=str(c.get('sql_password') or '')
    if not (db_name and db_user and pw): raise RuntimeError('Dedicated game SQL is not provisioned')
    limit=max(1,min(int(limit),500))
    try:
        import pymysql
        con=pymysql.connect(host='127.0.0.1',port=3306,user=db_user,password=pw,database=db_name,connect_timeout=5,charset='utf8mb4',cursorclass=pymysql.cursors.DictCursor)
        with con.cursor() as cur:
            cur.execute('SHOW TABLES'); allowed={str(next(iter(r.values()))) for r in cur.fetchall()}
            if table not in allowed: raise RuntimeError('SQL table not found in this server database')
            cur.execute('SELECT * FROM `'+table+'` LIMIT %s',(limit,))
            raw=cur.fetchall(); cols=[d[0] for d in (cur.description or [])]
        con.close()
        rows=[]
        for row in raw:
            clean={}
            for k,v in row.items():
                if v is None or isinstance(v,(str,int,float,bool)): clean[str(k)]=v
                elif isinstance(v,(bytes,bytearray)): clean[str(k)]='0x'+bytes(v).hex()[:4096]
                else: clean[str(k)]=str(v)
            rows.append(clean)
        return {'ok':True,'id':sid,'database':db_name,'table':table,'columns':cols,'rows':rows,'limit':limit}
    except RuntimeError: raise
    except Exception as exc: raise RuntimeError('Cannot read game SQL table: '+str(exc))


def db_server_row(sid:int):
    try:
        con=db_connect()
        try:
            with con.cursor() as cur:
                cur.execute('SELECT * FROM servers WHERE id=%s LIMIT 1',(sid,))
                return cur.fetchone()
        finally:
            con.close()
    except Exception:
        return None


def db_update_ftp(sid:int,user:str,password:str):
    try:
        con=db_connect()
        try:
            with con.cursor() as cur:
                cur.execute('UPDATE servers SET ftp_user=%s, ftp_password=%s WHERE id=%s',(user,password,sid))
        finally:
            con.close()
    except Exception:
        pass


