[Unit]
Description=HYPER-HOST Counter-Strike 1.6 server %i
After=network-online.target mariadb.service
Wants=network-online.target
StartLimitIntervalSec=90
StartLimitBurst=8

[Service]
Type=simple
User=cs16
Group=cs16
SupplementaryGroups=www-data
Environment=HOME=/srv/hyper-cs16
Environment=USER=cs16
Environment=LOGNAME=cs16
Environment=LC_ALL=C
Environment=SteamAppId=10
Environment=SteamGameId=10
WorkingDirectory=/srv/hyper-cs16/servers/%i
ExecStart=/usr/local/sbin/hyper-cs16-run %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
KillMode=mixed
LimitNOFILE=65535
UMask=0002
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/hyper-cs16/servers/%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
