+{
+    $rel = hc_clean_rel($rel);
+    $dir = dirname($rel);
+    if ($dir === '.') $dir = '';
+    $candidate = $dir;
+    while (true) {
+        foreach (['index.html','index.htm'] as $idx) {
+            $test = trim(($candidate !== '' ? $candidate . '/' : '') . $idx, '/');
+            try {
+                [,,$path] = hc_resolve($test, false);
+                if (is_file($path) && !is_link($path)) return $candidate;
+            } catch (Throwable) {}
+        }
+        if ($candidate === '') break;
+        $next = dirname($candidate);
+        $candidate = $next === '.' ? '' : $next;
+    }
+    return $dir;
+}
